---
import Base from '../layouts/Base.astro';

const sections = [
  { id: 'attendees',  label: 'Attending',  emoji: '🎟', caption: 'Show up · RSVP · cancel' },
  { id: 'organizers', label: 'Hosting',    emoji: '🎤', caption: 'Post events · cap spots · reminders' },
  { id: 'groups',     label: 'Groups',     emoji: '👥', caption: 'Public · invite-only · ownership' },
  { id: 'reporting',  label: 'Reporting',  emoji: '🚩', caption: 'How flags work · what happens' },
  { id: 'safety',     label: 'Safety',     emoji: '🛡', caption: 'The rules · in plain English' },
  { id: 'account',    label: 'Account',    emoji: '👤', caption: 'Sign in · tiers · deletion' },
];
---
<Base title="Help" description="How Denver Social works — for attendees, organizers, and group hosts.">
  <div class="canvas">
    <div class="hp">
      <header class="hp-h">
        <p class="kicker">Help Center · Updated 2026</p>
        <h1>Help <span class="amp">&amp;</span> answers.</h1>
        <p class="lede">Short, honest answers for everyone — attendees, organizers, group hosts.</p>
        <a href="/contact" class="hp-cta">Contact us if something's missing →</a>
      </header>

      <nav class="bubble" aria-label="Sections">
        {sections.map(s => (
          <a href={`#${s.id}`}>
            <span class="b-emoji" aria-hidden="true">{s.emoji}</span>
            <span>{s.label}</span>
          </a>
        ))}
      </nav>

      <section class="hp-s" id="attendees">
        <div class="h2-block"><h2>Attending</h2><p class="h2-cap">RSVPs · Cancellations · What to bring</p></div>
        <details class="card">
          <summary><h3>How do I RSVP to an event?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Find one on <a href="/events">/events</a>, open it, hit RSVP. You'll need a free email-code sign-in so the host knows who's coming.</p></div>
        </details>
        <details class="card">
          <summary><h3>What do I bring?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Depends on the event — the page tells you. Potlucks ask you to claim a dish slot. Otherwise, just yourself.</p></div>
        </details>
        <details class="card">
          <summary><h3>How do I cancel an RSVP?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>From <a href="/profile">/profile</a>, find the event, hit Cancel. Cancel early so the spot can go to the waitlist.</p></div>
        </details>
        <details class="card">
          <summary><h3>Where are events?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Across Denver metro — RiNo, Cap Hill, Cheesman, Cherry Creek, Highland, the foothills. The full address is on every event page.</p></div>
        </details>
      </section>

      <section class="hp-s" id="organizers">
        <div class="h2-block"><h2>Hosting</h2><p class="h2-cap">Posting events · Capping spots · Reminders</p></div>
        <details class="card">
          <summary><h3>How do I post an event?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Sign in, then <a href="/events/new">/events/new</a>. Pick a type, name it, set the date, fill in the details, post.</p></div>
        </details>
        <details class="card">
          <summary><h3>Can I run a potluck?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Yes — anyone can. Head to <a href="/potlucks/new">/potlucks/new</a>. We'll generate the sign-up sheet and the public link.</p></div>
        </details>
        <details class="card">
          <summary><h3>How do I cap attendance?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Set a "spots" number when you post. Once it fills, new RSVPs go to a waitlist. If someone cancels, the next person up gets promoted automatically.</p></div>
        </details>
        <details class="card">
          <summary><h3>Are reminders sent automatically?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Day-before email reminders for potlucks go out automatically when an event date is set. Other event types don't have reminders yet.</p></div>
        </details>
        <details class="card">
          <summary><h3>How do I delete an event?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Open the event, hit the red Delete button at the top. Wipes RSVPs, comments, and bring-items. Cannot be undone.</p></div>
        </details>
      </section>

      <section class="hp-s" id="groups">
        <div class="h2-block"><h2>Groups</h2><p class="h2-cap">Smaller circles · Public vs invite-only</p></div>
        <details class="card">
          <summary><h3>What's a group?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>A smaller circle inside Denver Social — your hiking buddies, trivia crew, dinner club. Anyone can start one and post events scoped to it.</p></div>
        </details>
        <details class="card">
          <summary><h3>Public vs invite-only?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Public: anyone signed in can find it at <a href="/groups">/groups</a> and join. Invite-only: people join via a single-use invite link from a member.</p></div>
        </details>
        <details class="card">
          <summary><h3>How do I post in a group?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>From the group page, hit "+ New event". It'll be tagged with the group but still appear on the main events list.</p></div>
        </details>
        <details class="card">
          <summary><h3>How do I leave?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Open the group, hit Leave. Owners need to transfer ownership before leaving — message us if you need help.</p></div>
        </details>
      </section>

      <section class="hp-s" id="reporting">
        <div class="h2-block"><h2>Reporting</h2><p class="h2-cap">Flag anything · Anonymous · Reviewed by an admin</p></div>
        <details class="card">
          <summary><h3>How do I report someone or something?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans">
            <p>Hit the 🚩 Report button on any event, group, or profile page. Pick a reason, add a note, submit. An admin reviews it and either acts (warning, content removed, account suspended) or dismisses it. We don't tell the reported person who flagged them.</p>
            <p>You don't need proof — if it made you uncomfortable, that's reason enough.</p>
            <p><strong>Emergency?</strong> Call 911 first. Message us after you're safe.</p>
          </div>
        </details>
      </section>

      <section class="hp-s" id="safety">
        <div class="h2-block"><h2>Safety</h2><p class="h2-cap">The rules · In plain English</p></div>
        <ul class="rules">
          <li class="tile tile-ok">
            <strong>Everyone's welcome.</strong>
            <p>Quiet, loud, awkward, neurodivergent, brand new to Denver. Leave whenever — no explanation needed.</p>
          </li>
          <li class="tile tile-ok">
            <strong>Your info stays private.</strong>
            <p>Host phone numbers stay hidden until you ask and they approve. Other members see your first name and neighborhood.</p>
          </li>
          <li class="tile tile-ok">
            <strong>Hosts are accountable.</strong>
            <p>Every event has a named host. Admin can take any page offline at any time.</p>
          </li>
          <li class="tile tile-warn">
            <strong>What gets you removed.</strong>
            <p>Harassment, intimidation, following someone after an event, or sharing someone's location or private info.</p>
          </li>
          <li class="tile tile-ok">
            <strong>Report anything that feels off.</strong>
            <p>Tell the host on the spot, jump in our Discord, or email us. We keep it between us.</p>
          </li>
          <li class="tile tile-ok">
            <strong>It's free, and that's the deal.</strong>
            <p>No fees, no premium tier, no upsell. Venue costs are between you and the venue.</p>
          </li>
        </ul>
        <p class="fine">See the full <a href="/terms">Terms</a> and <a href="/privacy">Privacy</a> pages.</p>
      </section>

      <section class="hp-s" id="account">
        <div class="h2-block"><h2>Account</h2><p class="h2-cap">Sign in · Tiers · Deletion</p></div>
        <details class="card">
          <summary><h3>How do I sign in?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>Go to <a href="/profile/new">/profile/new</a>, enter your email, we send a 6-digit code. Enter it. Done. No password.</p></div>
        </details>
        <details class="card">
          <summary><h3>Regular vs Organizer?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p><strong>Regular</strong> is a private member account — you can RSVP, post community flyers, and host unlimited events. <strong>Organizer</strong> adds a public <code>/u/yourname</code> page with a custom template, booking tools, and group creation. Upgrade anytime from <a href="/profile">/profile</a>.</p></div>
        </details>
        <details class="card">
          <summary><h3>How do I delete my account?</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="ans"><p>From <a href="/profile">/profile</a>, scroll to the bottom and hit Delete. Wipes your record, RSVPs, photos, and any pages you own. Want a copy of your data first? Email us.</p></div>
        </details>
      </section>

      <footer class="hp-foot">
        <p>Still stuck? <a href="/contact">Send a message</a> or join our <a href="https://discord.gg/S8SFNkdSgK" target="_blank" rel="noopener">Discord</a>.</p>
      </footer>
    </div>
  </div>

  <style>
    /* Warm canvas paints behind the whole page, edge to edge */
    .canvas { background: var(--bg); min-height: 100vh; }

    .hp {
      max-width: 760px; margin: 0 auto;
      padding: 56px clamp(20px, 5vw, 32px) 96px;
      color: var(--text);
    }

    /* ── Header ───────────────────────────────────────────── */
    .hp-h { margin-bottom: 32px; }
    .kicker {
      font-family: var(--font);
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--text-sec); margin-bottom: 16px;
    }
    .hp-h h1 {
      font-family: var(--font-display);
      font-size: clamp(44px, 7vw, 64px); font-weight: 800;
      letter-spacing: -0.035em; line-height: 1.02;
      margin-bottom: 18px; color: var(--text);
    }
    .hp-h h1 em { font-style: italic; font-weight: 500; color: var(--accent); }
    .hp-h h1 .amp {
      font-family: var(--font);
      font-style: italic; font-weight: 300;
      color: var(--text-faint); padding: 0 0.08em;
    }
    .lede {
      font-size: 18px; line-height: 1.55;
      color: var(--text-sec); max-width: 56ch;
      margin-bottom: 14px;
    }
    .lede a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .lede a:hover { color: var(--accent); }
    .hp-cta {
      display: inline-flex; align-items: center;
      font-family: var(--font);
      font-size: 13px; font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--accent); text-decoration: underline;
      text-underline-offset: 5px; text-decoration-thickness: 1px;
      transition: color 280ms cubic-bezier(0.16,1,0.3,1);
    }
    .hp-cta:hover { color: var(--accent); }

    /* ── Bubble nav grid ──────────────────────────────────── */
    .bubble {
      background: rgba(244,239,230,0.7);
      border: 1px solid rgba(232,224,208,0.6);
      border-radius: 32px;
      padding: 14px;
      margin: 48px 0 80px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }
    .bubble a {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 14px 12px; border-radius: 18px;
      font-size: 14px; font-weight: 600;
      color: var(--text); text-decoration: none;
      background: transparent;
      transition: background 280ms cubic-bezier(0.25,1,0.5,1), color 280ms cubic-bezier(0.25,1,0.5,1), transform 280ms cubic-bezier(0.25,1,0.5,1);
    }
    .bubble a:hover { background: rgba(255,255,255,0.7); color: var(--text); transform: translateY(-1px); }
    .bubble .b-emoji { font-size: 16px; line-height: 1; }
    @media (max-width: 640px) {
      .bubble { grid-template-columns: repeat(2, 1fr); border-radius: 28px; }
    }

    /* ── Sections — asymmetric pacing ─────────────────────── */
    .hp-s { margin-bottom: 96px; scroll-margin-top: 88px; }
    .hp-s:last-of-type { margin-bottom: 56px; }
    .h2-block {
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 18px;
    }
    .hp-s h2 {
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 36px); font-weight: 800;
      letter-spacing: -0.025em; line-height: 1.05;
      color: var(--text); margin: 0;
    }
    .h2-cap {
      font-family: var(--font);
      font-size: 11px; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--text-faint); margin: 6px 0 0;
    }

    /* ── Premium accordion ────────────────────────────────── */
    .card {
      border: 1px solid rgba(232, 224, 208, 0.8);
      background: rgba(255,255,255,0.35);
      border-radius: 22px;
      margin-bottom: 8px;
      overflow: hidden;
      transition: background 360ms cubic-bezier(0.16,1,0.3,1), border-color 360ms cubic-bezier(0.16,1,0.3,1), box-shadow 360ms cubic-bezier(0.16,1,0.3,1);
    }
    .card:hover { border-color: rgba(220, 208, 184, 0.9); }
    .card[open] {
      background: var(--surface);
      border-color: var(--border);
      box-shadow: 0 4px 20px -4px rgba(28,27,31,0.05);
    }
    .card summary:hover h3 { color: var(--accent); }
    .card summary h3 { transition: color 200ms cubic-bezier(0.16,1,0.3,1); }
    .card summary {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; padding: 20px 22px; cursor: pointer;
      list-style: none;
    }
    .card summary::-webkit-details-marker { display: none; }
    .card summary h3 {
      font-family: var(--font);
      font-size: 16px; font-weight: 600;
      letter-spacing: -0.005em;
      color: var(--text); margin: 0;
    }
    .plus {
      flex-shrink: 0; position: relative;
      width: 20px; height: 20px;
      display: inline-flex; align-items: center; justify-content: center;
      transition: transform 360ms cubic-bezier(0.16,1,0.3,1), color 280ms cubic-bezier(0.16,1,0.3,1);
      color: var(--text-faint);
    }
    .plus i {
      position: absolute; background: currentColor; border-radius: 2px;
      transition: transform 360ms cubic-bezier(0.16,1,0.3,1);
    }
    .plus i:nth-child(1) { width: 14px; height: 2px; }
    .plus i:nth-child(2) { width: 2px; height: 14px; }
    .card[open] .plus { color: var(--accent); transform: rotate(90deg); }
    .card[open] .plus i:nth-child(2) { transform: scaleY(0); }
    .ans {
      padding: 4px 22px 22px;
      border-top: 1px solid rgba(28,27,31,0.06);
      margin-top: 0;
    }
    .ans p {
      font-size: 15px; line-height: 1.7;
      color: var(--text-sec); margin: 14px 0 0;
    }
    .ans p:first-child { margin-top: 14px; }
    .ans a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .ans a:hover { color: var(--accent); }
    .ans strong { color: var(--text); font-weight: 600; }
    .ans code { background: var(--surface); padding: 1px 8px; border-radius: 6px; font-family: var(--font); font-size: 13px; }

    /* ── Safety tiles ─────────────────────────────────────── */
    .rules {
      list-style: none; padding: 0; margin: 0;
      display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    }
    @media (max-width: 640px) { .rules { grid-template-columns: 1fr; } }
    .tile {
      border-radius: 22px; padding: 20px 22px;
      border: 1px solid var(--border);
      background: rgba(244,239,230,0.4);
    }
    .tile-warn { background: rgba(220,38,38,0.04); border-color: rgba(220,38,38,0.18); }
    .tile strong {
      display: block;
      font-family: var(--font-display); font-size: 17px;
      font-weight: 700; color: var(--text);
      margin-bottom: 6px; letter-spacing: -0.01em;
    }
    .tile p { font-size: 14px; line-height: 1.6; color: var(--text-sec); margin: 0; }
    .fine { font-size: 13px; color: var(--text-sec); margin-top: 18px; }
    .fine a { color: var(--text-sec); text-decoration: underline; text-underline-offset: 3px; }

    /* ── Footer ───────────────────────────────────────────── */
    .hp-foot {
      margin-top: 64px; padding-top: 28px;
      border-top: 1px solid var(--border);
      font-size: 14px; color: var(--text-sec); text-align: center;
    }
    .hp-foot a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
    .hp-foot a:hover { color: var(--accent); }
  </style>
</Base>
