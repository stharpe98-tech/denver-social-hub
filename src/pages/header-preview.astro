---
// Preview of three editorial header directions. Not linked from the
// site — view at /header-preview to compare.
import { getDB } from '../lib/db';

const db = getDB();
let memberCount = 165;
let nextEvent: any = null;
if (db) {
  try {
    const r: any = await db.prepare(`SELECT COUNT(*) AS c FROM profiles WHERE status='live'`).first();
    memberCount = Number(r?.c || 165);
  } catch {}
  try {
    nextEvent = await db.prepare(
      `SELECT id, title, event_month, event_day FROM events
       WHERE COALESCE(is_past, 0) = 0
       ORDER BY id ASC LIMIT 1`
    ).first();
  } catch {}
}
const nextLabel = nextEvent
  ? `${nextEvent.event_month || ''} ${nextEvent.event_day || ''} — ${nextEvent.title}`.trim()
  : 'May 30 Spring Potluck';
const nextHref = nextEvent ? `/events/${nextEvent.id}` : '#';
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Header preview — Denver Social</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet"/>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #FAF9F6; color: #18181B; font-family: 'Inter', system-ui, sans-serif; }
    .lbl { font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: #71717A; padding: 24px 24px 8px; }
    .stage { padding: 0 0 40px; }
    .demo-body { padding: 32px 24px; max-width: 1100px; }
    .demo-body h2 { font-family: 'Fraunces', serif; font-size: 42px; font-weight: 600; margin: 0 0 12px; letter-spacing: -0.02em; }
    .demo-body p { color: #52525B; max-width: 56ch; line-height: 1.6; }
    .legend { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #52525B; margin: 8px 24px 16px; }

    /* ============ Direction 1: Editorial Zine ============ */
    .h1-wrap { background: #FAF9F6; border-bottom: 1px solid #18181B; }
    .h1-row1 { display: flex; justify-content: space-between; align-items: baseline; padding: 18px 28px; border-bottom: 1px solid #E4E4E7; }
    .h1-brand { font-family: 'Fraunces', serif; font-size: 30px; font-weight: 600; letter-spacing: -0.02em; }
    .h1-brand em { font-style: italic; font-weight: 500; }
    .h1-meta { font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #71717A; }
    .h1-row2 { display: grid; grid-template-columns: 1fr auto; gap: 24px; padding: 10px 28px; font-family: 'JetBrains Mono', monospace; font-size: 12px; }
    .h1-next { color: #18181B; }
    .h1-next .tag { color: #71717A; margin-right: 8px; }
    .h1-next a { color: #18181B; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .h1-nav { display: flex; gap: 22px; }
    .h1-nav a { color: #52525B; text-decoration: none; }
    .h1-nav a:hover { color: #18181B; text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 640px) {
      .h1-meta { display: none; }
      .h1-row2 { grid-template-columns: 1fr; gap: 8px; }
    }

    /* ============ Direction 2: Utility Bulletin ============ */
    .h2-wrap { background: #F4F1EA; color: #1C1917; position: relative; }
    .h2-wrap::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle at 1px 1px, rgba(0,0,0,0.04) 1px, transparent 0); background-size: 4px 4px; pointer-events: none; }
    .h2-grid { display: grid; grid-template-columns: 1.2fr 1fr; position: relative; }
    .h2-left { padding: 22px 28px; border-right: 1px solid #1C1917; }
    .h2-brand { font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
    .h2-tag { font-family: 'JetBrains Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; margin-top: 6px; color: #57534E; }
    .h2-nav { margin-top: 18px; display: flex; gap: 18px; font-family: 'JetBrains Mono', monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
    .h2-nav a { color: #1C1917; text-decoration: none; padding-bottom: 2px; border-bottom: 1px solid transparent; }
    .h2-nav a:hover { border-bottom-color: #1C1917; }
    .h2-right { padding: 22px 28px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; }
    .h2-tick-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.18em; color: #57534E; display: flex; align-items: center; gap: 8px; }
    .h2-dot { width: 8px; height: 8px; border-radius: 50%; background: #16A34A; box-shadow: 0 0 0 4px rgba(22,163,74,0.15); animation: pulse 2s ease-in-out infinite; }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
    .h2-tick-body { font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 500; line-height: 1.3; }
    .h2-tick-body a { color: #1C1917; text-decoration: none; border-bottom: 2px solid #1C1917; }
    .h2-tick-meta { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #57534E; }
    @media (max-width: 720px) {
      .h2-grid { grid-template-columns: 1fr; }
      .h2-left { border-right: none; border-bottom: 1px solid #1C1917; }
    }

    /* ============ Direction 3: Overlapping Containers ============ */
    .h3-wrap { background: linear-gradient(180deg, #FAF9F6 0%, #F0EDE5 100%); padding: 12px 16px 0; }
    .h3-shell { background: #FFFFFF; border: 1px solid #E4E4E7; border-radius: 14px; box-shadow: 0 2px 0 rgba(24,24,27,0.04), 0 12px 32px -16px rgba(24,24,27,0.18); position: relative; }
    .h3-row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 24px; padding: 14px 22px; }
    .h3-brand { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }
    .h3-brand span { color: #7C3AED; }
    .h3-nav { display: flex; gap: 4px; }
    .h3-nav a { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; color: #3F3F46; text-decoration: none; padding: 8px 14px; border-radius: 999px; transition: all 220ms cubic-bezier(0.34, 1.56, 0.64, 1); }
    .h3-nav a:hover { background: #18181B; color: #FAF9F6; transform: translateY(-1px); }
    .h3-cta { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; background: #18181B; color: #FAF9F6; padding: 9px 18px; border-radius: 999px; text-decoration: none; transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1); }
    .h3-cta:hover { transform: translateY(-1px) scale(1.02); }
    .h3-ticker { background: #18181B; color: #FAF9F6; margin: -1px 24px 0; border-radius: 0 0 12px 12px; padding: 8px 18px; display: inline-flex; gap: 10px; font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; align-items: center; }
    .h3-ticker .h2-dot { background: #34D399; box-shadow: 0 0 0 4px rgba(52,211,153,0.2); }
    .h3-ticker a { color: #FAF9F6; text-decoration: none; border-bottom: 1px solid rgba(250,249,246,0.4); }
    @media (max-width: 720px) {
      .h3-row { grid-template-columns: 1fr auto; }
      .h3-nav { display: none; }
    }
  </style>
</head>
<body>

  <div class="lbl">Direction 1 — Editorial Zine</div>
  <div class="legend">serif title · monospace metadata · 1px borders · asymmetric rows</div>
  <header class="h1-wrap">
    <div class="h1-row1">
      <div class="h1-brand">denver <em>social</em></div>
      <div class="h1-meta">Est. 2026  //  {memberCount} active members</div>
    </div>
    <div class="h1-row2">
      <div class="h1-next"><span class="tag">Next up</span><a href={nextHref}>{nextLabel}</a></div>
      <nav class="h1-nav">
        <a href="/events">Events</a>
        <a href="/community">Community</a>
        <a href="/potlucks">Potlucks</a>
        <a href="/about">About</a>
      </nav>
    </div>
  </header>

  <div class="stage">
    <div class="demo-body">
      <h2>Tonight in Denver.</h2>
      <p>Body content sits below the header so you can see how the type and borders carry through. Scroll past to see Direction 2.</p>
    </div>
  </div>

  <div class="lbl">Direction 2 — Utility Bulletin</div>
  <div class="legend">split panes · live ticker · paper grain · charcoal on cream</div>
  <header class="h2-wrap">
    <div class="h2-grid">
      <div class="h2-left">
        <div class="h2-brand">DENVER SOCIAL</div>
        <div class="h2-tag">Small gatherings · since 2026</div>
        <nav class="h2-nav">
          <a href="/events">Events</a>
          <a href="/community">Board</a>
          <a href="/potlucks">Potlucks</a>
          <a href="/about">About</a>
        </nav>
      </div>
      <div class="h2-right">
        <div class="h2-tick-label"><span class="h2-dot"></span>Live · next gathering</div>
        <div class="h2-tick-body"><a href={nextHref}>{nextLabel}</a></div>
        <div class="h2-tick-meta">{memberCount} members · doors open 6pm</div>
      </div>
    </div>
  </header>

  <div class="stage">
    <div class="demo-body">
      <h2>The bulletin board.</h2>
      <p>This one trades polish for raw utility — left side handles identity, right side is a live ticker. Scroll past for Direction 3.</p>
    </div>
  </div>

  <div class="lbl">Direction 3 — Overlapping Containers</div>
  <div class="legend">floating card · pill nav with bounce easing · stacked ticker</div>
  <header class="h3-wrap">
    <div class="h3-shell">
      <div class="h3-row">
        <div class="h3-brand">denver<span>.social</span></div>
        <nav class="h3-nav">
          <a href="/events">Events</a>
          <a href="/community">Community</a>
          <a href="/potlucks">Potlucks</a>
          <a href="/about">About</a>
        </nav>
        <a class="h3-cta" href="/profile/new">Join</a>
      </div>
    </div>
    <div class="h3-ticker">
      <span class="h2-dot"></span>
      <span>Next up</span>
      <a href={nextHref}>{nextLabel}</a>
    </div>
  </header>

  <div class="stage">
    <div class="demo-body">
      <h2>Tactile and layered.</h2>
      <p>Card-style header that floats over the page with a ticker stub poking out underneath. Hover the nav links — they use a custom easing curve so the lift feels weighted.</p>
    </div>
  </div>

</body>
</html>
