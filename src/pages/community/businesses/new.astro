---
import Base from '../../../layouts/Base.astro';
import { BUSINESS_CATEGORIES } from '../../../lib/business-schema';
---
<Base title="List your business — Denver Social" description="Add your business to the Denver Social local directory.">

<style is:inline>
  .bf-hero { margin-top: -88px; padding: 116px var(--space-4) var(--space-5); text-align: center; color: #fff; background-color: #0E8A7D; background-image: linear-gradient(150deg, rgba(14,138,125,0.92), rgba(16,30,28,0.92)); }
  @media (max-width: 900px) { .bf-hero { margin-top: 0; padding-top: 40px; } }
  .bf-hero h1 { font-family: 'Caveat','Bricolage Grotesque',cursive; font-size: clamp(40px,8vw,60px); font-weight: 700; line-height: 0.95; }
  .bf-hero p { font-size: 14.5px; color: rgba(255,255,255,0.88); margin-top: 8px; }

  .bf { max-width: 600px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-9); }
  .bf-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-5); box-shadow: var(--card-shadow); }
  .bf-field { margin-bottom: var(--space-4); }
  .bf-label { display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .bf-label .opt { font-weight: 400; color: var(--text-faint); }
  .bf-input, .bf-select, .bf-textarea {
    width: 100%; padding: 12px 14px; background: var(--bg);
    border: 1.5px solid var(--border); border-radius: 10px;
    font-size: 16px; color: var(--text); font-family: var(--font);
    outline: none; -webkit-appearance: none; transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
  }
  .bf-input::placeholder, .bf-textarea::placeholder { color: var(--text-faint); }
  .bf-input:focus, .bf-select:focus, .bf-textarea:focus { background: #fff; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
  .bf-textarea { resize: vertical; min-height: 92px; line-height: 1.5; }
  .bf-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  @media (max-width: 500px) { .bf-row { grid-template-columns: 1fr; } }
  .bf-hint { font-size: 12px; color: var(--text-faint); margin-top: 5px; }

  /* Logo uploader */
  .bf-logo-row { display: flex; align-items: center; gap: var(--space-3); }
  .bf-logo-prev { width: 72px; height: 72px; border-radius: 16px; flex-shrink: 0; object-fit: cover; background: var(--bg); border: 1.5px dashed var(--border); display: flex; align-items: center; justify-content: center; font-size: 26px; color: var(--text-faint); }
  .bf-logo-btn { padding: 10px 16px; border-radius: var(--radius-pill); border: 1.5px solid var(--border); background: var(--bg); color: var(--text); font-family: var(--font); font-size: 13px; font-weight: 600; cursor: pointer; }
  .bf-logo-btn:hover { border-color: var(--accent); color: var(--accent); }
  .bf-logo-clear { background: none; border: none; color: var(--text-faint); font-size: 12px; cursor: pointer; text-decoration: underline; font-family: inherit; }
  .bf-logo-clear:hover { color: #EF4444; }

  /* Honeypot — visually hidden, off-screen */
  .bf-gotcha { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .bf-submit { width: 100%; padding: 15px; border-radius: var(--radius-pill); border: none; cursor: pointer; background: var(--accent); color: #fff; font-family: var(--font-display); font-size: 16px; font-weight: 800; box-shadow: 0 8px 20px var(--cta-glow); transition: box-shadow 0.2s, transform 0.15s; margin-top: var(--space-2); }
  .bf-submit:hover { box-shadow: 0 12px 28px var(--cta-glow); transform: translateY(-2px); }
  .bf-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .bf-err { font-size: 13.5px; color: #EF4444; margin-top: var(--space-3); display: none; }
  .bf-err.show { display: block; }
</style>

<section class="bf-hero">
  <h1 id="bf-title">List your business</h1>
  <p>Reach your Denver neighbors. Free to list.</p>
</section>

<div class="bf">
  <form class="bf-card" id="bf-form" autocomplete="on">
    <div class="bf-gotcha" aria-hidden="true">
      <label>Leave this empty <input type="text" id="bf-gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="bf-field">
      <label class="bf-label" for="bf-name">Business name *</label>
      <input type="text" class="bf-input" id="bf-name" placeholder="e.g. Mile High Pet Walks" maxlength="80" required />
    </div>

    <div class="bf-field">
      <label class="bf-label" for="bf-category">Category *</label>
      <select class="bf-select" id="bf-category" required>
        <option value="">Choose a category…</option>
        {BUSINESS_CATEGORIES.map((c) => (<option value={c.key}>{c.emoji} {c.label}</option>))}
      </select>
    </div>

    <div class="bf-field">
      <label class="bf-label" for="bf-tagline">Tagline <span class="opt">(one line)</span></label>
      <input type="text" class="bf-input" id="bf-tagline" placeholder="Reliable midday dog walks in Cap Hill" maxlength="120" />
    </div>

    <div class="bf-field">
      <label class="bf-label" for="bf-logo">Logo <span class="opt">(optional)</span></label>
      <div class="bf-logo-row">
        <div class="bf-logo-prev" id="bf-logo-prev">🏪</div>
        <div>
          <button type="button" class="bf-logo-btn" id="bf-logo-btn">Upload image</button>
          <button type="button" class="bf-logo-clear" id="bf-logo-clear" style="display:none">Remove</button>
          <input type="file" id="bf-logo" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />
          <div class="bf-hint">JPG, PNG, WebP or GIF · up to 5 MB</div>
        </div>
      </div>
    </div>

    <div class="bf-field">
      <label class="bf-label">Contact <span class="opt">(phone or email required)</span></label>
      <div class="bf-row">
        <input type="tel" class="bf-input" id="bf-phone" placeholder="(720) 555-1234" maxlength="40" autocomplete="tel" />
        <input type="email" class="bf-input" id="bf-email" placeholder="you@email.com" maxlength="120" autocomplete="email" />
      </div>
    </div>

    <div class="bf-field">
      <div class="bf-row">
        <div>
          <label class="bf-label" for="bf-website">Website <span class="opt">(optional)</span></label>
          <input type="text" class="bf-input" id="bf-website" placeholder="yoursite.com" maxlength="200" />
        </div>
        <div>
          <label class="bf-label" for="bf-instagram">Instagram <span class="opt">(optional)</span></label>
          <input type="text" class="bf-input" id="bf-instagram" placeholder="@yourhandle" maxlength="80" />
        </div>
      </div>
    </div>

    <div class="bf-field">
      <label class="bf-label" for="bf-neighborhood">Neighborhood <span class="opt">(optional)</span></label>
      <input type="text" class="bf-input" id="bf-neighborhood" placeholder="RiNo, Cap Hill, Wash Park…" maxlength="60" />
    </div>

    <div class="bf-field">
      <label class="bf-label" for="bf-description">About your business <span class="opt">(optional)</span></label>
      <textarea class="bf-textarea" id="bf-description" placeholder="What you offer, your rates, availability, what makes you great…" maxlength="1200"></textarea>
    </div>

    <button type="submit" class="bf-submit" id="bf-submit">Post my business 🎉</button>
    <div class="bf-err" id="bf-err"></div>
  </form>
</div>

<script is:inline>
(function () {
  function $(id) { return document.getElementById(id); }
  function val(id) { var el = $(id); return el ? el.value.trim() : ''; }

  var editId = parseInt(new URLSearchParams(location.search).get('edit') || '', 10) || 0;
  var editToken = '';
  var logoUrl = ''; // existing or freshly uploaded URL
  var pendingFile = null;

  // ── Edit mode: must hold the token, then prefill ────
  if (editId) {
    try { editToken = localStorage.getItem('dsn_biz_' + editId) || ''; } catch (_) {}
    if (!editToken) {
      $('bf-err').textContent = "You can only edit a listing from the device you posted it on.";
      $('bf-err').classList.add('show');
    } else {
      $('bf-title').textContent = 'Edit your business';
      $('bf-submit').textContent = 'Save changes';
      fetch('/api/business?id=' + editId)
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) return;
          var b = d.listing;
          $('bf-name').value = b.name || '';
          $('bf-category').value = b.category || '';
          $('bf-tagline').value = b.tagline || '';
          $('bf-phone').value = b.phone || '';
          $('bf-email').value = b.email || '';
          $('bf-website').value = b.website || '';
          $('bf-instagram').value = b.instagram ? '@' + b.instagram : '';
          $('bf-neighborhood').value = b.neighborhood || '';
          $('bf-description').value = b.description || '';
          if (b.logo_url) {
            logoUrl = b.logo_url;
            $('bf-logo-prev').innerHTML = '<img src="' + b.logo_url + '" style="width:100%;height:100%;border-radius:16px;object-fit:cover" alt="logo"/>';
            $('bf-logo-clear').style.display = '';
          }
        })
        .catch(function () {});
    }
  }

  // ── Logo picker (preview only; upload happens on submit) ──
  $('bf-logo-btn').addEventListener('click', function () { $('bf-logo').click(); });
  $('bf-logo').addEventListener('change', function (e) {
    var f = e.target.files && e.target.files[0];
    if (!f) return;
    if (f.size > 5 * 1024 * 1024) { alert('That image is over 5 MB — pick a smaller one.'); return; }
    pendingFile = f;
    var reader = new FileReader();
    reader.onload = function (ev) {
      $('bf-logo-prev').innerHTML = '<img src="' + ev.target.result + '" style="width:100%;height:100%;border-radius:16px;object-fit:cover" alt="logo"/>';
      $('bf-logo-clear').style.display = '';
    };
    reader.readAsDataURL(f);
  });
  $('bf-logo-clear').addEventListener('click', function () {
    pendingFile = null; logoUrl = '';
    $('bf-logo').value = '';
    $('bf-logo-prev').innerHTML = '🏪';
    $('bf-logo-clear').style.display = 'none';
  });

  function showErr(msg) {
    $('bf-err').textContent = msg;
    $('bf-err').classList.add('show');
    $('bf-submit').disabled = false;
    $('bf-submit').textContent = editId ? 'Save changes' : 'Post my business 🎉';
  }

  // ── Submit ───────────────────────────────────────────
  $('bf-form').addEventListener('submit', function (e) {
    e.preventDefault();
    $('bf-err').classList.remove('show');

    var name = val('bf-name');
    var category = val('bf-category');
    var phone = val('bf-phone');
    var email = val('bf-email');
    if (!name) return showErr('Add your business name.');
    if (!category) return showErr('Pick a category.');
    if (!phone && !email) return showErr('Add a phone number or email so people can reach you.');

    $('bf-submit').disabled = true;
    $('bf-submit').textContent = 'Saving…';

    var doSave = function () {
      var payload = {
        action: editId ? 'update' : 'create',
        id: editId || undefined,
        edit_token: editToken || undefined,
        name: name, category: category,
        tagline: val('bf-tagline'),
        description: val('bf-description'),
        phone: phone, email: email,
        website: val('bf-website'),
        instagram: val('bf-instagram'),
        neighborhood: val('bf-neighborhood'),
        logo_url: logoUrl,
        _gotcha: val('bf-gotcha'),
      };
      fetch('/api/business', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) return showErr(d.error || 'Something went wrong — try again.');
        var newId = editId || d.id;
        if (!editId && d.edit_token) {
          try { localStorage.setItem('dsn_biz_' + newId, d.edit_token); } catch (_) {}
        }
        window.location.href = '/community/businesses/' + newId;
      })
      .catch(function () { showErr('Network problem — try again.'); });
    };

    // Upload the logo first if a new file was chosen.
    if (pendingFile) {
      var fd = new FormData();
      fd.append('file', pendingFile);
      fetch('/api/business/logo', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) return showErr(d.error || 'Logo upload failed — try a different image.');
          logoUrl = d.url;
          doSave();
        })
        .catch(function () { showErr('Logo upload failed — check your connection.'); });
    } else {
      doSave();
    }
  });
})();
</script>
</Base>
