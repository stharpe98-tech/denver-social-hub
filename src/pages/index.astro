---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';

const db = getDB();
let upcomingEvents: any[] = [];
let memberCount = 0;
let eventCount = 0;
let upcomingPotluck: any = null;

// Live Discord online count (cached at the worker fetch layer).
let discordOnline: number | null = null;
let discordName: string = '';
if (db) {
  try {
    const src: any = await db.prepare(
      "SELECT config FROM event_sources WHERE kind='discord' AND enabled=1 ORDER BY id LIMIT 1"
    ).first();
    const guildId = src?.config ? (() => { try { return (JSON.parse(src.config).guild_id || '').toString() || null; } catch { return null; } })() : null;
    if (guildId) {
      const r = await fetch(`https://discord.com/api/guilds/${encodeURIComponent(guildId)}/widget.json`, {
        headers: { 'User-Agent': 'DenverSocialHub/1.0' },
        cf: { cacheTtl: 60, cacheEverything: true } as any,
        signal: AbortSignal.timeout(3000),
      });
      if (r.ok) {
        const w: any = await r.json();
        if (typeof w?.presence_count === 'number') discordOnline = w.presence_count;
        discordName = w?.name || '';
      }
    }
  } catch {}
}

try {
  if (db) {
    const monthOrder: Record<string, number> = { JAN:0,FEB:1,MAR:2,APR:3,MAY:4,JUN:5,JUL:6,AUG:7,SEP:8,OCT:9,NOV:10,DEC:11 };
    const allEvts = (await db.prepare(
      "SELECT * FROM events WHERE is_past IS NULL OR is_past = 0 ORDER BY id DESC LIMIT 12"
    ).all())?.results || [];
    upcomingEvents = allEvts.sort((a: any, b: any) => {
      const ma = monthOrder[(a.event_month || '').toUpperCase()] ?? 99;
      const mb = monthOrder[(b.event_month || '').toUpperCase()] ?? 99;
      if (ma !== mb) return ma - mb;
      return (parseInt(a.event_day) || 99) - (parseInt(b.event_day) || 99);
    }).slice(0, 5);
    const mc = await db.prepare("SELECT COUNT(*) as cnt FROM members").first();
    memberCount = mc?.cnt || 0;
    const ec = await db.prepare("SELECT COUNT(*) as cnt FROM events WHERE is_past IS NULL OR is_past=0").first();
    eventCount = ec?.cnt || 0;
    upcomingPotluck = await db.prepare("SELECT id, slug, title, date_label, location FROM potlucks WHERE status='upcoming' ORDER BY id DESC LIMIT 1").first();
  }
} catch {}

const typeLabel: Record<string, string> = {
  dinner: '🍽 Dinner', game_night: '🎲 Game night', outdoor: '🌲 Outdoors', brewery: '🍺 Brewery',
  coffee: '☕ Coffee', arts: '🎨 Arts', music: '🎵 Music', social: '🥂 Social',
  group_tickets: '🎟 Tickets', camping: '🏕 Camping', sports_outing: '⚾ Sports',
  bowling: '🎳 Bowling', active: '🏃 Active', casino: '🎰 Casino', food_trucks: '🌮 Food', other: '✨ Event',
};
// category pill colors [bg, text]
const catColor: Record<string, [string, string]> = {
  dinner: ['#FCEFD8', '#B5710F'], game_night: ['#DCF1EC', '#0B6B61'], outdoor: ['#E9F1ED', '#3F6B5E'],
  coffee: ['#FCEFD8', '#B5710F'], arts: ['#FCE7D8', '#B5530F'], social: ['#DCF1EC', '#0B6B61'],
  brewery: ['#FCEFD8', '#B5710F'], music: ['#E9F1ED', '#3F6B5E'], active: ['#E9F1ED', '#3F6B5E'],
};
const pill = (t: string) => catColor[t] || ['#FCEFD8', '#B5710F'];

// What we do — evergreen tiles
const tracks = [
  { cls: 'big', em: '🍽️', t: 'Dinners', d: 'Tables of 8 — strangers in, friends out.', img: '/tiles/dinners.jpg' },
  { cls: '', em: '🎲', t: 'Game nights', d: '', img: '/tiles/games.jpg' },
  { cls: '', em: '🌇', t: 'Sky terrace hangs', d: '', img: '/tiles/terrace.jpg' },
  { cls: '', em: '🍻', t: 'Bar meetups', d: '', img: '/tiles/bar.jpg' },
  { cls: 'big', em: '🥗', t: 'Big potlucks', d: 'Everyone brings one thing. Cheesman regulars.', img: '/tiles/potlucks.jpg' },
];
---
<Base title="Real events, real people" description="Lively small-group events across Denver — game nights, dinners, terrace hangs, bar meetups, potlucks. Find one or host your own.">
<div class="home">

  <!-- HERO — photo slideshow -->
  <section class="hero">
    <div class="hero-photos">
      <img src="/hero/red-rocks.jpg" alt="Red Rocks at night" class="hero-photo hp-1" loading="eager" />
      <img src="/hero/skyline.jpg" alt="Denver skyline" class="hero-photo hp-2" loading="eager" />
      <img src="/hero/foothills.jpg" alt="Colorado foothills" class="hero-photo hp-3" loading="eager" />
    </div>
    <div class="hero-ov"></div>
    <div class="hero-in">
      <span class="hero-pill">
        <span class="live"></span>
        {memberCount > 0 ? `${memberCount} neighbors` : 'Denver'}{eventCount > 0 ? ` · ${eventCount} events this week` : ''}
      </span>
      <h1>Real people, real plans — happening around Denver this week.</h1>
      <p>Game nights, dinners, rooftop hangs, bar meetups, big potlucks. Find one and RSVP — or start your own in two minutes.</p>
      <div class="hero-cta">
        <a class="btn btn-1" href="/events">Find an event</a>
        <a class="btn btn-2" href="/events/new">+ Create your own event</a>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <div class="k">What we do</div>
        <h2>A little bit of everything</h2>
        <p>Small enough to actually meet people, often enough that there's always something on.</p>
      </div>
      <div class="tiles">
        {tracks.map((t) => (
          <a class={`tile ${t.cls}`} href="/events" style={`background-image:url(${t.img})`}>
            <div class="lab"><div class="em">{t.em}</div><h3>{t.t}</h3>{t.d && <p>{t.d}</p>}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- THIS WEEK (real events) -->
  <section class="section week">
    <div class="wrap">
      <div class="sec-head">
        <div class="k">What's on</div>
        <h2>This week in Denver</h2>
        <p>Spots are capped so it stays easy to meet everyone.</p>
      </div>
      <div class="cards">
        {upcomingPotluck && (
          <a class="card" href={upcomingPotluck.slug ? `/${upcomingPotluck.slug}` : `/potlucks/${upcomingPotluck.id}`}>
            <div class="card-top"><div class="date"><span class="m">Soon</span><span class="d">🥗</span></div><span class="cat" style="background:#E6F8EC;color:#15803D">Potluck</span></div>
            <h3>{upcomingPotluck.title}</h3>
            <div class="meta">{upcomingPotluck.date_label}{upcomingPotluck.location ? ` · ${upcomingPotluck.location}` : ''}</div>
            <div class="foot"><span>bring a dish</span><span class="rsvp">Join</span></div>
          </a>
        )}
        {upcomingEvents.map((ev: any) => (
          <a class="card" href={`/events/${ev.id}`}>
            <div class="card-top">
              <div class="date"><span class="m">{ev.event_month}</span><span class="d">{ev.event_day}</span></div>
              <span class="cat" style={`background:${pill(ev.event_type)[0]};color:${pill(ev.event_type)[1]}`}>{typeLabel[ev.event_type] || '✨ Event'}</span>
            </div>
            <h3>{ev.title}</h3>
            <div class="meta">{ev.zone || ev.location || 'Denver'}</div>
            <div class="foot"><span>{ev.rsvp_count || 0} going</span><span class="rsvp">RSVP</span></div>
          </a>
        ))}
        <a class="card card-host" href="/events/new">
          <h3>+ Host your own</h3>
          <div class="meta">A dinner, a game night, a terrace hang — live in 2 min.</div>
          <div class="foot"><span></span><span class="rsvp rsvp-c">Start →</span></div>
        </a>
      </div>
      {discordOnline !== null && (
        <div class="discord-row">
          <a class="discord-chip" href="/discord"><span class="live"></span><strong>{discordOnline}</strong> online in the Discord{discordName ? ` · ${discordName}` : ''} →</a>
        </div>
      )}
    </div>
  </section>

  <!-- HOST BAND -->
  <section class="host"><div class="wrap">
    <div class="host-card">
      <h2>Got an idea? You're the host.</h2>
      <p>Anyone can throw an event here — pick a date, set the size, hit publish. We handle RSVPs, reminders, and headcounts so you just show up.</p>
      <a class="btn btn-1" href="/events/new">Create your event</a>
    </div>
  </div></section>

</div>

<style>
  .home{background:var(--bg);color:var(--text)}
  .home .wrap{max-width:1120px;margin:0 auto;padding:0 24px}
  .home a{text-decoration:none}

  /* HERO */
  .hero{position:relative;min-height:88vh;display:flex;align-items:flex-end;overflow:hidden;color:#fff}
  .hero-photos{position:absolute;inset:0;z-index:0}
  .hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;animation:heroFade 21s infinite}
  .hp-1{animation-delay:0s}.hp-2{animation-delay:7s}.hp-3{animation-delay:14s}
  @keyframes heroFade{0%{opacity:0}5%{opacity:1}28%{opacity:1}34%{opacity:0}100%{opacity:0}}
  .hero-ov{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(16,30,28,.26) 0%,rgba(16,30,28,.04) 42%,rgba(16,30,28,.64) 100%)}
  .hero-in{position:relative;z-index:2;width:100%;max-width:1120px;margin:0 auto;padding:0 24px 64px}
  .hero-pill{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.16);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.28);padding:8px 16px;border-radius:999px;font-size:13px;font-weight:600;margin-bottom:18px}
  .live{width:8px;height:8px;border-radius:50%;background:#34D399;box-shadow:0 0 0 0 rgba(52,211,153,.6);animation:pulse 2s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(52,211,153,.6)}70%{box-shadow:0 0 0 10px rgba(52,211,153,0)}100%{box-shadow:0 0 0 0 rgba(52,211,153,0)}}
  .hero h1{font-family:var(--font-display);font-size:clamp(38px,6.2vw,72px);font-weight:800;letter-spacing:-.02em;line-height:1.04;max-width:780px;margin-bottom:16px;color:#fff;text-shadow:0 1px 18px rgba(0,0,0,.5)}
  .hero p{font-size:19px;max-width:520px;color:rgba(255,255,255,.92);margin-bottom:26px}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap}
  .btn{padding:15px 28px;border-radius:999px;font-weight:700;font-size:15.5px;transition:transform .15s;display:inline-block}
  .btn-1{background:var(--accent);color:#fff;box-shadow:0 10px 28px rgba(14,138,125,.4)}
  .btn-1:hover{transform:translateY(-2px)}
  .btn-2{background:rgba(255,255,255,.16);color:#fff;border:1.5px solid rgba(255,255,255,.5);backdrop-filter:blur(8px)}
  .btn-2:hover{background:rgba(255,255,255,.26)}

  /* SECTIONS */
  .section{padding:84px 0}
  .sec-head{text-align:center;max-width:560px;margin:0 auto 44px}
  .sec-head .k{font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:10px}
  .sec-head h2{font-family:var(--font-display);font-size:clamp(30px,4vw,46px);font-weight:800;letter-spacing:-.02em;margin-bottom:12px}
  .sec-head p{color:var(--text-sec);font-size:17px}

  /* TILES */
  .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .tile{position:relative;border-radius:26px;overflow:hidden;min-height:230px;display:flex;align-items:flex-end;color:#fff;transition:transform .2s;background:#1E5142;background-size:cover;background-position:center}
  .tile:hover{transform:translateY(-4px)}
  .tile::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,30,28,.12) 18%,rgba(16,30,28,.66))}
  .tile .lab{position:relative;z-index:2;padding:22px}
  .tile .lab .em{font-size:30px}
  .tile .lab h3{font-family:var(--font-display);font-size:22px;font-weight:700;margin-top:4px;color:#fff}
  .tile .lab p{font-size:13.5px;opacity:.92;margin-top:2px}
  .tile.big{grid-column:span 2}
  @media(max-width:780px){.tiles{grid-template-columns:1fr 1fr}.tile.big{grid-column:span 2}}
  @media(max-width:520px){.tiles{grid-template-columns:1fr}.tile.big{grid-column:span 1}}

  /* WEEK CARDS */
  .week{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .card{background:#fff;border:1px solid var(--border);border-radius:18px;padding:18px;transition:transform .15s,box-shadow .15s;display:block}
  .card:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(0,0,0,.07)}
  .card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
  .date{display:flex;flex-direction:column;align-items:center;background:var(--accent-soft);border-radius:12px;padding:8px 12px;line-height:1;min-width:52px}
  .date .m{font-size:11px;font-weight:700;color:var(--accent);text-transform:uppercase}
  .date .d{font-family:var(--font-display);font-size:20px;font-weight:800;color:var(--text)}
  .cat{font-size:12px;font-weight:700;padding:5px 11px;border-radius:999px;white-space:nowrap}
  .card h3{font-family:var(--font-display);font-size:18px;font-weight:700;margin-bottom:6px;color:var(--text)}
  .card .meta{font-size:14px;color:var(--text-sec);margin-bottom:14px}
  .card .foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border);padding-top:12px;font-size:13px;color:var(--text-sec)}
  .rsvp{background:var(--text);color:#fff;font-weight:600;padding:8px 16px;border-radius:999px}
  .card-host{background:var(--accent-soft);border-color:transparent;display:flex;flex-direction:column;justify-content:center}
  .card-host h3{color:var(--accent)}
  .card-host .foot{border:none;padding-top:8px}
  .rsvp-c{background:var(--accent)}
  @media(max-width:820px){.cards{grid-template-columns:1fr 1fr}}@media(max-width:540px){.cards{grid-template-columns:1fr}}
  .discord-row{text-align:center;margin-top:28px}
  .discord-chip{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--border);border-radius:999px;padding:10px 18px;font-size:14px;color:var(--text-sec);font-weight:500}
  .discord-chip strong{color:var(--text)}

  /* HOST BAND */
  .host{padding:84px 0}
  .host-card{background:linear-gradient(135deg,#16302B,#1E5142);color:#fff;border-radius:26px;padding:56px 40px;text-align:center;position:relative;overflow:hidden}
  .host-card::after{content:"";position:absolute;top:-60px;right:-40px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(232,144,42,.5),transparent 70%)}
  .host-card h2{font-family:var(--font-display);font-size:clamp(28px,4vw,44px);font-weight:800;margin-bottom:14px;position:relative;color:#fff}
  .host-card p{color:rgba(255,255,255,.82);font-size:17px;max-width:520px;margin:0 auto 26px;position:relative}
  .host-card .btn-1{position:relative}
  @media(max-width:680px){.section,.host{padding:60px 0}.host-card{padding:44px 24px}}
</style>
</Base>
