  .pc-6{grid-column:span 12;min-height:180px;background:linear-gradient(135deg,#FBBF24,#D97706);display:grid;grid-template-columns:1fr auto;align-items:center;padding:32px 40px}
  .pc-6 h3{font-size:34px;margin-bottom:4px;color:#111}.pc-6 .meta{color:#111}.pc-6 p{color:#111;opacity:.8}
  .pc-6 .btn-yellow{background:#111;color:#FFD93D;justify-self:end}
  @media (max-width:880px){.prog-grid{grid-template-columns:1fr}.prog-card{grid-column:span 1!important}.pc-6{grid-template-columns:1fr}.pc-6 .btn-yellow{justify-self:start;margin-top:var(--space-4)}}

  /* VOTING */
  .voting{padding:var(--space-9) var(--space-5);background:var(--surface)}.voting-in{max-width:900px;margin:0 auto}
  .section-h2{font-family:'Outfit';text-align:center;font-size:clamp(34px,4.5vw,52px);font-weight:800;margin-bottom:var(--space-4);max-width:760px;margin-left:auto;margin-right:auto;letter-spacing:-.02em}
  .section-sub{text-align:center;color:var(--text-sec);font-size:18px;max-width:600px;margin:0 auto var(--space-8)}
