---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';

const db = getDB();
let lineupEvents: any[] = [];
let upcomingEvents: any[] = [];
let memberCount = 0;
let eventCount = 0;
let zoneCount = 0;
let upcomingPotluck: any = null;
let suggestions: any[] = [];

// Pull Discord guild_id from event-sync config and fetch the live online count.
// Cached at the worker fetch layer so we don't hammer Discord on every render.
let discordOnline: number | null = null;
let discordInvite: string | null = null;
let discordName: string = '';
if (db) {
  try {
    const src: any = await db.prepare(
      "SELECT config FROM event_sources WHERE kind='discord' AND enabled=1 ORDER BY id LIMIT 1"
    ).first();
    const guildId = src?.config ? (() => { try { return (JSON.parse(src.config).guild_id || '').toString() || null; } catch { return null; } })() : null;
    if (guildId) {
      const r = await fetch(`https://discord.com/api/guilds/${encodeURIComponent(guildId)}/widget.json`, {
        headers: { 'User-Agent': 'DenverSocialHub/1.0' },
        cf: { cacheTtl: 60, cacheEverything: true } as any,
        signal: AbortSignal.timeout(3000),
      });
      if (r.ok) {
        const w: any = await r.json();
        if (typeof w?.presence_count === 'number') discordOnline = w.presence_count;
        discordInvite = w?.instant_invite || null;
        discordName = w?.name || '';
      }
    }
  } catch {}
}

try {
  if (db) {
    const monthOrder: Record<string, number> = { JAN:0,FEB:1,MAR:2,APR:3,MAY:4,JUN:5,JUL:6,AUG:7,SEP:8,OCT:9,NOV:10,DEC:11 };
    const allEvts = (await db.prepare(
      "SELECT * FROM events WHERE is_past IS NULL OR is_past = 0 ORDER BY id DESC LIMIT 14"
    ).all())?.results || [];

    // Trust is_past for visibility; sort by month/day for chronological order.
    lineupEvents = allEvts.sort((a: any, b: any) => {
      const ma = monthOrder[(a.event_month || '').toUpperCase()] ?? 99;
      const mb = monthOrder[(b.event_month || '').toUpperCase()] ?? 99;
      if (ma !== mb) return ma - mb;
      return (parseInt(a.event_day) || 99) - (parseInt(b.event_day) || 99);
    });
    upcomingEvents = lineupEvents.slice(0, 4);

    const mc = await db.prepare("SELECT COUNT(*) as cnt FROM members").first();
    memberCount = mc?.cnt || 0;
    const ec = await db.prepare("SELECT COUNT(*) as cnt FROM events WHERE is_past IS NULL OR is_past=0").first();
    eventCount = ec?.cnt || 0;
    const zc = await db.prepare("SELECT COUNT(DISTINCT zone) as cnt FROM events WHERE zone IS NOT NULL AND zone != ''").first();
    zoneCount = zc?.cnt || 0;
    suggestions = (await db.prepare("SELECT * FROM event_suggestions ORDER BY votes DESC LIMIT 4").all())?.results || [];
    upcomingPotluck = await db.prepare("SELECT id, slug, title, date_label, location FROM potlucks WHERE status='upcoming' ORDER BY id DESC LIMIT 1").first();
  }
} catch {}

const typeLabel: Record<string, string> = {
  dinner: '🍽 Dinner', game_night: '🎲 Games', outdoor: '🌲 Outdoors', brewery: '🍺 Brewery',
  coffee: '☕ Coffee', arts: '🎨 Arts', music: '🎵 Music', social: '🥂 Social',
  group_tickets: '🎟 Tickets', camping: '🏕 Camping', sports_outing: '⚾ Sports',
  bowling: '🎳 Bowling', active: '🏃 Active', casino: '🎰 Casino', food_trucks: '🌮 Food', other: '✨ Event',
};

const eventHref = (ev: any) => `/events/${ev.id}`;
const potluckHref = upcomingPotluck
  ? (upcomingPotluck.slug ? `/${upcomingPotluck.slug}` : `/potlucks/${upcomingPotluck.id}`)
  : '/potlucks';

// Festival "lineup" tiers, built from real events.
const headliner = lineupEvents[0] || null;
const tierThisWeek = lineupEvents.slice(1, 7);
const tierAlso = lineupEvents.slice(7);

// Evergreen "tracks" — what people host (aspirational, not fake events).
const tracks = [
  { cls: 'pc-1', emoji: '🥾', meta: 'OUTDOORS', title: 'Hikes & Plunges', desc: 'Trails, sunrise climbs, cold-lake mornings.' },
  { cls: 'pc-2', emoji: '🍽', meta: 'EVERY FEW WEEKS', title: 'The Big Potluck', desc: 'Cheesman Park. Bring a dish, find your people.' },
  { cls: 'pc-3', emoji: '🏺', meta: 'MAKING', title: 'Arts & Pottery', desc: 'Studio drop-ins, all levels.' },
  { cls: 'pc-4', emoji: '🎲', meta: 'WEEKNIGHTS', title: 'Game Nights', desc: 'Rotating hosts, rotating bars.' },
  { cls: 'pc-5', emoji: '☕', meta: 'MORNINGS', title: 'Coffee & Walks', desc: 'Low-key, show-up-solo friendly.' },
];
---
<Base title="Real events, real people" description="Small-group hangouts across Denver. Pick one, RSVP, show up.">
<div class="festival">

  <!-- HERO (your photo slideshow + festival type) -->
  <section class="hero">
    <div class="hero-photos">
      <img src="/hero/red-rocks.jpg" alt="Red Rocks Amphitheatre at night" class="hero-photo hp-1" loading="eager" />
      <img src="/hero/skyline.jpg" alt="Denver skyline with the Rockies behind" class="hero-photo hp-2" loading="eager" />
      <img src="/hero/foothills.jpg" alt="Snowy Colorado foothills trail" class="hero-photo hp-3" loading="eager" />
    </div>
    <div class="hero-overlay"></div>
    <svg class="peaks" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,200 L0,140 L160,60 L320,120 L480,40 L640,100 L800,30 L960,90 L1120,50 L1280,110 L1440,70 L1440,200 Z" fill="rgba(255,255,255,0.08)"/>
      <path d="M0,200 L0,170 L120,100 L280,140 L440,80 L600,130 L760,70 L920,120 L1080,90 L1240,140 L1440,110 L1440,200 Z" fill="rgba(0,0,0,0.25)"/>
    </svg>
    <div class="hero-in">
      <span class="hero-eyebrow"><span class="pulse"></span>DENVER · COMMUNITY · SINCE 2026</span>
      <h1>Show up.<span class="accent">— that's the whole pitch.</span></h1>
      <p class="tag">Real small-group events across the city. Hikes, dinners, plunges, potlucks at Cheesman — something every week. RSVP with an email and go.</p>
      <div class="hero-actions">
        <a href="/events" class="btn-hero">Browse events →</a>
        <a href="/events#potlucks" class="btn-hero-out">Jump to potlucks</a>
      </div>
    </div>
  </section>

  {/* DISCORD LIVE CHIP */}
  {discordOnline !== null && (
    <div class="discord-chip-wrap">
      <a href="/discord" class="discord-chip">
        <span class="discord-pulse"></span>
        <span class="discord-text"><strong>{discordOnline}</strong> online in the Discord{discordName ? ` · ${discordName}` : ''}</span>
        <span class="discord-arrow">→</span>
      </a>
    </div>
  )}

  <!-- STATS -->
  <section class="stats"><div class="stats-in">
    <h2>This is Denver, <em>actually getting together</em>.</h2>
    <div class="stats-grid">
      <div class="stat"><div class="corner"></div><div class="stat-label">Neighbors</div><div class="stat-num">{memberCount}+</div><div class="stat-desc">locals on the platform — what started as a table for 8 in RiNo.</div></div>
      <div class="stat"><div class="corner"></div><div class="stat-label">Coming up</div><div class="stat-num">{eventCount}</div><div class="stat-desc">events on the calendar right now — potlucks, dinners, hikes, plunges.</div></div>
      <div class="stat"><div class="corner"></div><div class="stat-label">Across</div><div class="stat-num">{zoneCount || '18'}</div><div class="stat-desc">Denver neighborhoods covered, from LoHi to Hampden, RiNo to Wash Park.</div></div>
    </div>
  </div></section>

  <!-- THE LINEUP (real events) -->
  {headliner && (
    <section class="lineup">
      <div class="section-eyebrow">DENVER SOCIAL PRESENTS</div>
      <h2>The Lineup</h2>

      <div class="tier"><div class="tier-label">— HEADLINERS</div>
        <div class="tier-1">
          {upcomingPotluck && (<><a href={potluckHref}>{upcomingPotluck.title}</a><span class="dot"> · </span></>)}
          <a href={eventHref(headliner)}>{headliner.title}</a>
        </div>
      </div>

      {tierThisWeek.length > 0 && (
        <>
          <div class="divider"></div>
          <div class="tier"><div class="tier-label">— THIS WEEK</div>
            <div class="tier-2">
              {tierThisWeek.map((ev: any, i: number) => (
                <>{i > 0 && <span class="dot"> · </span>}<a href={eventHref(ev)}>{ev.title}</a></>
              ))}
            </div>
          </div>
        </>
      )}

      {tierAlso.length > 0 && (
        <>
          <div class="divider"></div>
          <div class="tier"><div class="tier-label">— ALSO ON THE CALENDAR</div>
            <div class="tier-3">
              {tierAlso.map((ev: any, i: number) => (
                <>{i > 0 && <span class="dot"> · </span>}<a href={eventHref(ev)}>{ev.title}</a></>
              ))}
            </div>
          </div>
        </>
      )}

      <div class="lineup-cta"><a href="/events" class="btn-yellow">See the full calendar →</a></div>
    </section>
  )}

  <!-- NEXT POTLUCK SPOTLIGHT (real) -->
  {upcomingPotluck && (
    <section class="spotlight-wrap">
      <a href={potluckHref} class="spotlight">
        <div>
          <span class="spotlight-tag">🍽 Next potluck</span>
          <h3>{upcomingPotluck.title}</h3>
          <p>{upcomingPotluck.date_label}{upcomingPotluck.location ? ` · ${upcomingPotluck.location}` : ''}</p>
        </div>
        <span class="spotlight-arrow">→</span>
      </a>
    </section>
  )}

  <!-- WHAT WE GET UP TO -->
  <section class="programme"><div class="programme-in">
    <h2>What we get up to</h2><p class="sub">A handful of tracks running all season. Pick one, pick all five.</p>
    <div class="prog-grid">
      {tracks.map((t) => (
        <a href="/events" class={`prog-card ${t.cls}`}><span class="emoji-bg">{t.emoji}</span><div class="meta">{t.meta}</div><h3>{t.title}</h3><p>{t.desc}</p></a>
      ))}
      <a href="/events/new" class="prog-card pc-6">
        <div><div class="meta">YOUR EVENT, OUR CALENDAR</div><h3>Got something to host?</h3><p>Free to list. Live in two minutes.</p></div>
        <span class="btn-yellow inline">Add it →</span>
      </a>
    </div>
  </div></section>

  {/* COMMUNITY VOTING (real suggestions) */}
  {suggestions.length > 0 && (
    <section class="voting"><div class="voting-in">
      <span class="section-eyebrow center">— THE COMMUNITY DECIDES</span>
      <h2 class="section-h2">What Denver wants next.</h2>
      <p class="section-sub">Ideas members voted up. The most-wanted ones become real events.</p>
      <div class="vote-grid">
        {suggestions.map((s: any) => (
          <a href="/events" class="vote-card">
            <span class="vote-count">▲ {s.votes ?? 0}</span>
            <span class="vote-title">{s.title || s.text || 'Community idea'}</span>
          </a>
        ))}
      </div>
    </div></section>
  )}

  <!-- WHY THIS WORKS -->
  <section class="pillars"><div class="pillars-in">
    <span class="section-eyebrow center">— WHY THIS WORKS</span>
    <h2 class="section-h2">Three things we don't do.</h2>
    <p class="section-sub">The whole platform is shaped around what we left out.</p>
    <div class="pillar-grid">
      <div class="pillar"><span class="pillar-num">01</span><div class="pillar-illus">🚫</div><h3>No algorithm</h3><p>Events show up in the order they happen. Nothing is "boosted." The thing on top is the thing happening soonest.</p></div>
      <div class="pillar"><span class="pillar-num">02</span><div class="pillar-illus">💸</div><h3>No paid tier</h3><p>Hosting is free. Listing is free. RSVPing is free. No premium tier locked behind something that should be public.</p></div>
      <div class="pillar"><span class="pillar-num">03</span><div class="pillar-illus">📭</div><h3>No spam DMs</h3><p>You can't message another member without a mutual RSVP. The platform stays out of the way of the actual meeting.</p></div>
    </div>
  </div></section>

  <!-- HOST / PERSONAL PAGE STRIP -->
  <section class="host-strip"><div class="host-in">
    <h2>Have something you offer Denver?</h2>
    <p>Free landing page for realtors, instructors, makers, dog-walkers — anyone with skills, services, or a side hustle. Your own URL, your contact info, your face on the neighborhood map.</p>
    <ul class="checks"><li>✓ Pick your own URL — denversocialhub.com/u/yourname</li><li>✓ Free forever — no credit card, no account</li><li>✓ Live in 2 minutes — email yourself a code, edit, publish</li></ul>
    <a href="/u/new" class="btn-cta">Make my page →</a>
  </div></section>

  <!-- FINAL CTA -->
  <section class="cta-final">
    <h2>See you out there.</h2>
    <p>RSVP to one thing this week. That's the whole onboarding.</p>
    <div class="cta-final-actions"><a href="/events" class="btn-yellow">Browse events →</a><a href="/about" class="btn-clear">How it works</a></div>
  </section>

</div>

<style>
  /* Festival design tokens — scoped to this page so the rest of the site
     keeps the Base theme. */
  .festival{
    --accent:#7C3AED;--accent2:#3B82F6;--mint:#10B981;
    --surface:#F8F9FB;--border:#E5E7EB;--text:#111827;--text-sec:#6B7280;
    --card-shadow:0 1px 3px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.04);
    font-family:'Inter','Work Sans',system-ui,sans-serif;color:var(--text);background:#fff;
  }
  .festival a{color:inherit;text-decoration:none}
  .festival h1,.festival h2,.festival h3,.festival h4{line-height:1.2}
  .festival .btn-hero,.festival .btn-hero-out,.festival .btn-yellow,.festival .btn-cta,.festival .btn-clear{cursor:pointer}

  /* HERO — photo slideshow background + festival typography */
  .hero{position:relative;min-height:72vh;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#0c1a2a;color:#fff;padding:var(--space-9) 24px var(--space-8)}
  .hero-photos{position:absolute;inset:0;z-index:0;overflow:hidden}
  .hero-photo{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:0;animation:heroFade 21s infinite;filter:saturate(.85) brightness(.9);transform:scale(1.05)}
  .hp-1{animation-delay:0s}.hp-2{animation-delay:7s}.hp-3{animation-delay:14s}
  @keyframes heroFade{0%{opacity:0;transform:scale(1.05)}5%{opacity:1;transform:scale(1.02)}30%{opacity:1;transform:scale(1)}38%{opacity:0;transform:scale(1)}100%{opacity:0;transform:scale(1.05)}}
  .hero-overlay{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(15,15,35,.55) 0%,rgba(45,27,78,.62) 55%,rgba(124,58,237,.78) 100%),radial-gradient(ellipse 80% 60% at 50% 30%,rgba(59,130,246,.18),transparent 70%)}
  .hero .peaks{position:absolute;bottom:0;left:0;width:100%;height:auto;opacity:.45;z-index:1}
  .hero-in{position:relative;z-index:2;max-width:880px;margin:0 auto;width:100%;text-align:center}
  .hero-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11px;letter-spacing:2px;font-weight:700;background:rgba(255,255,255,.14);backdrop-filter:blur(6px);padding:8px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.25);margin-bottom:24px}
  .pulse{width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 0 rgba(16,185,129,.6);animation:pulse 2s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.6)}70%{box-shadow:0 0 0 10px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
  .hero h1{font-family:'Outfit',sans-serif;font-size:clamp(44px,8vw,100px);font-weight:900;letter-spacing:-.04em;margin-bottom:16px;line-height:1;color:#fff;text-shadow:0 2px 30px rgba(0,0,0,.35)}
  .hero h1 .accent{font-family:'Caveat',cursive;font-weight:600;font-size:.4em;color:#FFD93D;display:block;letter-spacing:0;transform:rotate(-2deg);margin-top:-8px}
  .hero p.tag{font-size:20px;font-weight:500;max-width:560px;margin:0 auto 32px;color:rgba(255,255,255,.9)}
  .hero-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}
  .btn-hero{background:#FFD93D;color:#111;padding:16px 32px;border-radius:50px;font-weight:800;font-size:15px;letter-spacing:.5px;transition:transform .15s}
  .btn-hero:hover{transform:translateY(-2px)}.btn-hero:active{transform:translateY(0)}
  .btn-hero-out{background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:16px 32px;border-radius:50px;font-weight:700;font-size:15px;backdrop-filter:blur(6px)}
  .btn-hero-out:hover{background:rgba(255,255,255,.18)}

  /* DISCORD CHIP */
  .discord-chip-wrap{max-width:1240px;margin:0 auto;padding:24px 24px 0;display:flex;justify-content:center}
  .discord-chip{display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--border);box-shadow:var(--card-shadow);border-radius:50px;padding:10px 20px;font-size:14px;font-weight:600;transition:transform .15s}
  .discord-chip:hover{transform:translateY(-2px)}
  .discord-pulse{width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 0 rgba(16,185,129,.6);animation:pulse 2s infinite}
  .discord-arrow{color:var(--accent)}

  /* STATS */
  .stats{padding:var(--space-9) var(--space-5);background:linear-gradient(135deg,var(--surface) 0%,#EEF2FF 50%,#F0FDF4 100%);position:relative;overflow:hidden}
  .stats::before{content:"";position:absolute;top:-100px;right:-100px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,.15),transparent 70%);filter:blur(40px)}
  .stats-in{max-width:1240px;margin:0 auto;position:relative;text-align:center}
  .stats h2{font-family:'Outfit';font-size:clamp(30px,4.5vw,52px);font-weight:800;margin-bottom:var(--space-8);max-width:780px;margin-left:auto;margin-right:auto;letter-spacing:-.02em}
  .stats h2 em{font-style:normal;color:var(--accent);position:relative;display:inline-block}
  .stats h2 em::after{content:"";position:absolute;bottom:-4px;left:0;right:0;height:8px;background:#FFD93D;z-index:-1;opacity:.6;border-radius:4px}
  .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-5)}
  .stat{background:#fff;border-radius:24px;padding:var(--space-6);text-align:left;box-shadow:var(--card-shadow);border:1px solid var(--border);position:relative;overflow:hidden;transition:transform .2s}
  .stat:hover{transform:translateY(-4px)}
  .stat-label{font-size:12px;letter-spacing:2px;font-weight:700;color:var(--text-sec);text-transform:uppercase;margin-bottom:var(--space-2)}
  .stat-num{font-family:'Outfit';font-size:72px;font-weight:900;line-height:1;color:var(--text);margin-bottom:6px;letter-spacing:-.03em}
  .stat-desc{font-size:15px;color:var(--text-sec);line-height:1.5}
  .stat .corner{position:absolute;top:0;right:0;width:80px;height:80px;background:var(--accent);clip-path:polygon(100% 0,0 0,100% 100%);opacity:.08}
  .stat:nth-child(2) .corner{background:var(--accent2)}.stat:nth-child(3) .corner{background:var(--mint)}
  @media (max-width:880px){.stats-grid{grid-template-columns:1fr}.stat-num{font-size:64px}}

  /* LINEUP */
  .lineup{padding:var(--space-9) var(--space-5);background:#0F0F23;color:#fff;text-align:center}
  .section-eyebrow{display:block;font-size:11px;letter-spacing:3px;font-weight:800;color:var(--accent);margin-bottom:var(--space-3)}
  .section-eyebrow.center{text-align:center}
  .lineup .section-eyebrow{color:#FFD93D;margin-bottom:var(--space-3)}
  .lineup h2{font-family:'Outfit';font-size:clamp(36px,5vw,64px);font-weight:900;margin-bottom:var(--space-7);letter-spacing:-.02em;color:#fff}
  .tier{margin-bottom:var(--space-6)}
  .tier-label{font-size:11px;letter-spacing:3px;color:rgba(255,255,255,.5);margin-bottom:var(--space-3);font-weight:700}
  .tier-1{font-family:'Outfit';font-size:clamp(34px,6vw,68px);font-weight:900;line-height:1.05;letter-spacing:-.02em}
  .tier-1 a{color:#fff;display:inline-block;margin:0 12px;transition:color .15s}
  .tier-1 a:hover{color:#FFD93D}
  .tier-2{font-family:'Outfit';font-size:clamp(22px,3.5vw,36px);font-weight:800;line-height:1.2;color:rgba(255,255,255,.9)}
  .tier-2 a{color:inherit;display:inline-block;margin:0 10px}.tier-2 a:hover{color:#FFD93D}
  .tier-3{font-size:17px;font-weight:600;line-height:1.7;color:rgba(255,255,255,.75);max-width:880px;margin:0 auto}
  .tier-3 a{color:inherit;display:inline-block;margin:0 8px}.tier-3 a:hover{color:#FFD93D}
  .dot{opacity:.4}.divider{width:60px;height:2px;background:#FFD93D;margin:var(--space-5) auto}
  .lineup-cta{margin-top:var(--space-7)}
  .btn-yellow{background:#FFD93D;color:#111;padding:16px 32px;border-radius:50px;font-weight:800;font-size:15px;display:inline-block;transition:transform .15s}
  .btn-yellow:hover{transform:translateY(-2px)}

  /* SPOTLIGHT */
  .spotlight-wrap{max-width:1100px;margin:0 auto;padding:var(--space-7) var(--space-5) 0}
  .spotlight{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);background:linear-gradient(135deg,#F0FDF4,#DCFCE7);border:1px solid #BBF7D0;border-radius:24px;padding:var(--space-6);transition:transform .15s}
  .spotlight:hover{transform:translateY(-3px)}
  .spotlight-tag{display:inline-block;font-size:12px;font-weight:700;color:#047857;background:#fff;border-radius:50px;padding:4px 12px;margin-bottom:var(--space-3)}
  .spotlight h3{font-family:'Outfit';font-size:26px;font-weight:800;margin-bottom:4px}
  .spotlight p{color:var(--text-sec);font-size:15px}
  .spotlight-arrow{font-size:28px;color:#047857}

  /* PROGRAMME */
  .programme{padding:var(--space-9) var(--space-5);background:#fff}.programme-in{max-width:1240px;margin:0 auto}
  .programme h2{font-family:'Outfit';font-size:clamp(32px,4.5vw,52px);font-weight:800;text-align:center;margin-bottom:var(--space-3);letter-spacing:-.02em}
  .programme .sub{text-align:center;color:var(--text-sec);font-size:18px;margin-bottom:var(--space-7);max-width:600px;margin-left:auto;margin-right:auto}
