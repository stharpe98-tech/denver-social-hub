  .cta-final-actions{position:relative;display:inline-flex;gap:var(--space-3);flex-wrap:wrap;justify-content:center}
  .btn-clear{background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:16px 32px;border-radius:50px;font-weight:700;font-size:15px;backdrop-filter:blur(6px);display:inline-block}
