---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';

const db = getDB();
let totalMembers = 0;
try {
  if (db) {
    const mc = await db.prepare("SELECT COUNT(*) as cnt FROM members").first();
    totalMembers = mc?.cnt || 0;
  }
} catch {}

const faqs = [
  { q: "Is this actually free?", a: "Yep. No fees, no premium tier, no upsell." },
  { q: "I don't know anyone — is that weird?", a: "Most people show up solo. Events stay small enough that you actually meet everyone." },
  { q: "Is it safe? What about creeps?", a: "Every event has a host, locations are public so you know exactly where you're going, and we remove anyone who makes others uncomfortable." },
  { q: "How much does an event cost?", a: "Some are free (hikes, park hangs, coffee). Dinners run $20–35 a head. Price is always shown upfront." },
  { q: "Can I post my own event?", a: "Yes — hit \"Plan an event\" from /events. You don't need permission to have a good idea." },
  { q: "What if I RSVP and can't make it?", a: "Just cancel so someone else can grab the spot. Life happens — don't ghost repeatedly." },
];
---
<Base title="About" description="Why Denver Social exists, and the story behind the table for 8 that started it.">
  <div class="canvas">
    <div class="hp">
      <header class="hp-h">
        <p class="kicker">About · Denver Social · Since 2026</p>
        <h1>Making friends in Denver is <em>hard.</em></h1>
        <p class="lede">A small community site, run by one person, built around the idea that you shouldn't need an app full of strangers to grab dinner on a Tuesday.</p>
        <a href="/events" class="hp-cta">Find something to show up to →</a>
      </header>

      <section class="hp-s">
        <div class="h2-block"><h2>The story.</h2><p class="h2-cap">Seth · Host · Fellow Denverite</p></div>
        <div class="prose">
          <p>I moved to Denver from Louisiana about two and a half years ago. As a fellow autistic guy, making friends in a new city was rough — bars were too loud, meetup groups had 400 people standing around awkwardly, and Bumble BFF felt like a job interview. All I wanted was a few people to grab dinner with on a Tuesday.</p>
          <p>So I booked a table for 8 in RiNo and posted it. Strangers showed up. People kept asking <em>"when's the next one?"</em> — so we kept going. Bowling, hikes, pottery, game nights. There's <strong>{totalMembers || '80'}+</strong> of us now — dinners stay small, but a hike or game night might be twenty.</p>
          <p>I love organizing and helping the community. If you've ever found it hard to meet people here, that's the whole reason this site exists — I want to spread the love and make Denver feel a little smaller, one table at a time.</p>
        </div>
      </section>

      <section class="hp-s">
        <div class="h2-block"><h2>The rules.</h2><p class="h2-cap">Short list · Easy to remember</p></div>
        <div class="prose">
          <p>Don't be a creep. Show up if you say you will. Be kind. That's it.</p>
        </div>
      </section>

      <section class="hp-s">
        <div class="h2-block"><h2>How it works.</h2><p class="h2-cap">Three lines · No quiz</p></div>
        <div class="prose">
          <p><strong>Make a profile</strong> (sixty seconds, no quiz). <strong>Find something that sounds fun.</strong> <strong>Actually show up.</strong> You walk in, there's eight people at a table, and twenty minutes later you're laughing about something dumb.</p>
        </div>
      </section>

      <section class="hp-s">
        <div class="h2-block"><h2>Fair questions.</h2><p class="h2-cap">Quick answers · No fluff</p></div>
        {faqs.map((f) => (
          <details class="card">
            <summary><h3>{f.q}</h3><span class="plus" aria-hidden="true"><i></i><i></i></span></summary>
            <div class="ans"><p>{f.a}</p></div>
          </details>
        ))}
      </section>

      <footer class="hp-foot">
        <p>Ready? <a href="/profile/new">Make a profile</a> or join our <a href="https://discord.gg/S8SFNkdSgK" target="_blank" rel="noopener">Discord</a>.</p>
      </footer>
    </div>
  </div>

  <style>
    .canvas { background: #FDFBF7; min-height: 100vh; }

    .hp {
      max-width: 760px; margin: 0 auto;
      padding: 56px clamp(20px, 5vw, 32px) 96px;
      color: #1C1B1F;
    }

    .hp-h { margin-bottom: 32px; }
    .kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: #6B6A70; margin-bottom: 16px;
    }
    .hp-h h1 {
      font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
      font-size: clamp(44px, 7vw, 64px); font-weight: 800;
      letter-spacing: -0.035em; line-height: 1.02;
      margin-bottom: 18px; color: #1C1B1F;
    }
    .hp-h h1 em { font-style: italic; font-weight: 500; color: #7C3AED; }
    .hp-h h1 .amp {
      font-family: 'Inter', system-ui, sans-serif;
      font-style: italic; font-weight: 300;
      color: #B5AFA3; padding: 0 0.08em;
    }
    .lede {
      font-size: 18px; line-height: 1.55;
      color: #6B6A70; max-width: 56ch;
      margin-bottom: 14px;
    }
    .lede a { color: #1C1B1F; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .lede a:hover { color: #7C3AED; }
    .hp-cta {
      display: inline-flex; align-items: center;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 13px; font-weight: 600;
      letter-spacing: -0.01em;
      color: #7C3AED; text-decoration: underline;
      text-underline-offset: 5px; text-decoration-thickness: 1px;
      transition: color 280ms cubic-bezier(0.16,1,0.3,1);
    }
    .hp-cta:hover { color: #5B21B6; }

    .hp-s { margin-bottom: 96px; scroll-margin-top: 88px; }
    .hp-s:last-of-type { margin-bottom: 56px; }
    .h2-block {
      padding-bottom: 14px;
      border-bottom: 1px solid #E8E0D0;
      margin-bottom: 18px;
    }
    .hp-s h2 {
      font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
      font-size: clamp(28px, 4vw, 36px); font-weight: 800;
      letter-spacing: -0.025em; line-height: 1.05;
      color: #1C1B1F; margin: 0;
    }
    .h2-cap {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: #9A938A; margin: 6px 0 0;
    }

    .prose p {
      font-size: 16px; line-height: 1.7; color: #4A4850;
      margin: 0 0 14px;
    }
    .prose p:last-child { margin-bottom: 0; }
    .prose em { font-style: italic; color: #6B6A70; }
    .prose strong { color: #1C1B1F; font-weight: 600; }
    .prose a { color: #1C1B1F; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .prose a:hover { color: #7C3AED; }

    .card {
      border: 1px solid rgba(232, 224, 208, 0.8);
      background: rgba(255,255,255,0.35);
      border-radius: 22px;
      margin-bottom: 8px;
      overflow: hidden;
      transition: background 360ms cubic-bezier(0.16,1,0.3,1), border-color 360ms cubic-bezier(0.16,1,0.3,1), box-shadow 360ms cubic-bezier(0.16,1,0.3,1);
    }
    .card:hover { border-color: rgba(220, 208, 184, 0.9); }
    .card[open] {
      background: #FFFFFF;
      border-color: #D9CFB8;
      box-shadow: 0 4px 20px -4px rgba(28,27,31,0.05);
    }
    .card summary:hover h3 { color: #7C3AED; }
    .card summary h3 { transition: color 200ms cubic-bezier(0.16,1,0.3,1); }
    .card summary {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; padding: 20px 22px; cursor: pointer;
      list-style: none;
    }
    .card summary::-webkit-details-marker { display: none; }
    .card summary h3 {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 16px; font-weight: 600;
      letter-spacing: -0.005em;
      color: #1C1B1F; margin: 0;
    }
    .plus {
      flex-shrink: 0; position: relative;
      width: 20px; height: 20px;
      display: inline-flex; align-items: center; justify-content: center;
      transition: transform 360ms cubic-bezier(0.16,1,0.3,1), color 280ms cubic-bezier(0.16,1,0.3,1);
      color: #9A938A;
    }
    .plus i {
      position: absolute; background: currentColor; border-radius: 2px;
      transition: transform 360ms cubic-bezier(0.16,1,0.3,1);
    }
    .plus i:nth-child(1) { width: 14px; height: 2px; }
    .plus i:nth-child(2) { width: 2px; height: 14px; }
    .card[open] .plus { color: #7C3AED; transform: rotate(90deg); }
    .card[open] .plus i:nth-child(2) { transform: scaleY(0); }
    .ans {
      padding: 4px 22px 22px;
      border-top: 1px solid rgba(28,27,31,0.06);
      margin-top: 0;
    }
    .ans p {
      font-size: 15px; line-height: 1.7;
      color: #4A4850; margin: 14px 0 0;
    }
    .ans p:first-child { margin-top: 14px; }
    .ans a { color: #1C1B1F; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .ans a:hover { color: #7C3AED; }
    .ans strong { color: #1C1B1F; font-weight: 600; }

    .hp-foot {
      margin-top: 64px; padding-top: 28px;
      border-top: 1px solid #EDE6D7;
      font-size: 14px; color: #6B6A70; text-align: center;
    }
    .hp-foot a { color: #1C1B1F; text-decoration: underline; text-underline-offset: 3px; }
    .hp-foot a:hover { color: #7C3AED; }
  </style>
</Base>
