---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';

const db = getDB();
let totalMembers = 0;
try {
  if (db) {
    const mc: any = await db.prepare("SELECT COUNT(*) as cnt FROM members").first();
    totalMembers = mc?.cnt || 0;
  }
} catch {}
const memberLabel = totalMembers ? `${totalMembers}+` : '80+';
---
<Base title="About" description="Why Denver Social exists, and the story behind the table for 8 that started it.">
<div class="about">

  <header class="hero"><div class="wrap-n">
    <div class="k">Since 2026 · Denver, Colorado</div>
    <h1>Making friends in Denver is <em>hard.</em></h1>
    <p>A small community, run by one person, built around the idea that you shouldn't need an app full of strangers to grab dinner on a Tuesday.</p>
  </div></header>

  <div class="wrap"><div class="photos">
    <div class="p1"></div><div class="p2"></div><div class="p3"></div>
  </div></div>

  <section class="wrap-n story">
    <div class="k">The story</div>
    <h2>How a table for 8 in RiNo turned into this.</h2>
    <div class="by">Seth · Host · Fellow Denverite</div>
    <p>I moved to Denver from Louisiana a couple years ago. Making friends in a new city was rough — bars too loud, meetups had 400 people standing around awkwardly, and Bumble BFF felt like a job interview. All I wanted was a few people to grab dinner with on a Tuesday.</p>
    <p>So I booked a table for 8 in RiNo and posted it. Strangers showed up. People kept asking <em>"when's the next one?"</em> — so we kept going. Bowling, hikes, pottery, terrace hangs, big potlucks. There's <strong>{memberLabel}</strong> of us now — dinners stay small, but a hike or game night might be twenty.</p>
    <p>If you've ever found it hard to meet people here, that's the whole reason this exists — to make Denver feel a little smaller, one table at a time.</p>
    <div class="rules">Don't be a creep. Show up if you say you will. Be kind. <span>That's it.</span></div>
  </section>

  <section class="pillars"><div class="wrap">
    <div class="pgrid">
      <div class="pill"><div class="e">🚫</div><h3>No algorithm</h3><p>Events show up in the order they happen. The thing on top is the thing happening soonest — not what an engagement model picks.</p></div>
      <div class="pill"><div class="e">💸</div><h3>No paid tier</h3><p>Hosting is free. RSVPing is free. Always. Nothing locked behind a paywall.</p></div>
      <div class="pill"><div class="e">📭</div><h3>No spam</h3><p>You can't message someone without a mutual RSVP. The whole point is the in-person meet.</p></div>
    </div>
  </div></section>

  <section class="cta"><div class="wrap-n">
    <h2>So — see you Saturday?</h2>
    <a class="btn" href="/events">Find something this week</a>
  </div></section>

</div>

<style>
  .about{background:var(--bg);color:var(--text)}
  .about .wrap{max-width:1000px;margin:0 auto;padding:0 24px}
  .about .wrap-n{max-width:820px;margin:0 auto;padding:0 24px}
  .about a{text-decoration:none}
  .about .k{font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:12px}
  .hero{text-align:center;padding:64px 0 28px}
  .hero h1{font-family:var(--font-display);font-size:clamp(34px,5.5vw,60px);font-weight:800;letter-spacing:-.02em;margin-bottom:16px}
  .hero h1 em{font-style:normal;color:var(--accent)}
  .hero p{color:var(--text-sec);font-size:19px;max-width:560px;margin:0 auto}
  .photos{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:1fr 1fr;gap:12px;height:340px;margin:40px 0}
  .photos div{border-radius:18px;background-size:cover;background-position:center}
  .photos .p1{grid-row:1/3;background-image:url('/hero/red-rocks.jpg')}
  .photos .p2{background-image:url('/hero/foothills.jpg')}
  .photos .p3{background-image:url('/hero/skyline.jpg')}
  @media(max-width:620px){.photos{height:240px}}
  .story{padding:24px 0}
  .story h2{font-family:var(--font-display);font-size:clamp(26px,3.6vw,38px);font-weight:800;letter-spacing:-.02em;margin-bottom:8px}
  .story .by{color:var(--text-sec);font-size:14px;font-weight:600;margin-bottom:20px}
  .story p{font-size:17px;color:#3a342c;line-height:1.7;margin-bottom:18px}
  .story em{color:var(--accent);font-style:italic}
  .rules{background:var(--accent-soft);border-radius:18px;padding:24px;margin:8px 0;font-size:18px;font-weight:700}
  .rules span{color:var(--accent)}
  .pillars{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:64px 0;margin-top:40px}
  .pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .pill .e{font-size:30px;margin-bottom:10px}
  .pill h3{font-family:var(--font-display);font-size:20px;font-weight:800;margin-bottom:8px}
  .pill p{font-size:14.5px;color:var(--text-sec);line-height:1.6}
  @media(max-width:720px){.pgrid{grid-template-columns:1fr}}
  .cta{text-align:center;padding:64px 0}
  .cta h2{font-family:var(--font-display);font-size:clamp(28px,4vw,42px);font-weight:800;margin-bottom:16px}
  .btn{display:inline-block;background:var(--accent);color:#fff;font-weight:700;padding:15px 30px;border-radius:999px;box-shadow:0 8px 22px rgba(240,87,61,.3)}
  .btn:hover{transform:translateY(-2px)}
</style>
</Base>
