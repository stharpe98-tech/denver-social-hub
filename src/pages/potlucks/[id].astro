---
import Base from '../../layouts/Base.astro';
import { getDB } from '../../lib/db';
import { ensurePotluckSignupSchema } from '../../lib/potluck-signup-schema';

const db = getDB();
if (db) { try { await ensurePotluckSignupSchema(db); } catch {} }
const { id } = Astro.params;
let potluck: any = null;
let slots: any[] = [];
let signups: any[] = [];

try {
  if (db && id) {
    potluck = await db.prepare(`SELECT * FROM potlucks WHERE id=?`).bind(id).first();
    if (potluck?.locked) return Astro.redirect('/events');

    // Slots with claim counts (match on category, not dish text)
    const s = await db.prepare(`
      SELECT ps.id, ps.suggestion, ps.category, ps.sort_order, ps.max_claims,
        COUNT(pr.id) as claim_count
      FROM potluck_slots ps
      LEFT JOIN potluck_rsvp pr ON pr.dish_category=ps.category
        AND pr.potluck_id=ps.potluck_id AND pr.rsvp='yes'
      WHERE ps.potluck_id=?
      GROUP BY ps.id
      ORDER BY ps.sort_order ASC
    `).bind(id).all();
    slots = s?.results ?? [];

    // All sign-ups
    const r = await db.prepare(
      `SELECT name, dish, dish_category, guest_count, signup_token, is_primary FROM potluck_rsvp WHERE potluck_id=? AND rsvp='yes' ORDER BY created_at ASC`
    ).bind(id).all();
    signups = r?.results ?? [];
  }
} catch (e) { console.error(e); }
if (!potluck) return Astro.redirect('/events');

// One physical attendee may have multiple rows (one per item they're bringing).
// Collapse them by signup_token so the "Who's coming" list shows each person once.
type UniqueGuest = { name: string; dishes: string[]; guest_count: number };
const guestByToken = new Map<string, UniqueGuest>();
for (const s of signups as any[]) {
  const key = s.signup_token || `__row_${signups.indexOf(s)}`;
  const existing = guestByToken.get(key);
  if (existing) {
    if (s.dish) existing.dishes.push(s.dish);
    // Primary row owns the guest_count; only adopt from primary if we haven't seen it.
    if (s.is_primary && (parseInt(s.guest_count) || 0) > existing.guest_count) {
      existing.guest_count = parseInt(s.guest_count) || 1;
    }
  } else {
    guestByToken.set(key, {
      name: s.name || '',
      dishes: s.dish ? [s.dish] : [],
      guest_count: parseInt(s.guest_count) || 1,
    });
  }
}
const uniqueGuests = Array.from(guestByToken.values());
const guestTotal = uniqueGuests.reduce((sum, g) => sum + g.guest_count, 0);
const totalSlots = slots.reduce((sum: number, s: any) => sum + (s.max_claims < 900 ? s.max_claims : 1), 0);
const totalClaimed = slots.reduce((sum: number, s: any) => sum + s.claim_count, 0);

// Group slots by category
const slotGroupKeys: string[] = [];
const slotGroups: Record<string, any[]> = {};
for (const s of slots) {
  const cat = s.category || 'Other';
  if (!slotGroups[cat]) { slotGroups[cat] = []; slotGroupKeys.push(cat); }
  slotGroups[cat].push(s);
}

// Group RSVPs by dish_category for SignUpGenius-style sheet
const rsvpsByCategory: Record<string, {name: string, dish: string}[]> = {};
for (const s of signups) {
  const cat = (s as any).dish_category || '';
  if (!cat) continue;
  if (!rsvpsByCategory[cat]) rsvpsByCategory[cat] = [];
  rsvpsByCategory[cat].push({ name: (s as any).name, dish: (s as any).dish });
}
const totalWithDishes = signups.filter((s: any) => s.dish).length;
---
<Base title={potluck.title} description={potluck.description ?? `Sign up for ${potluck.title}`}>

<style>
  /* ── Layout ─────────────────────────────────────────── */
  .pk { max-width: 620px; margin: 0 auto; padding: 0 var(--space-4) var(--space-8); }

  /* ── Hero ────────────────────────────────────────────── */
  .pk-hero {
    text-align: center;
    margin-top: -88px;
    padding: 108px var(--space-4) var(--space-7);
    background-color: #0E8A7D;
    background-image: linear-gradient(140deg, rgba(14,138,125,0.78), rgba(16,30,28,0.88)), url('/tiles/potlucks.jpg');
    background-size: cover; background-position: center;
    color: #fff;
  }
  @media (max-width: 900px) { .pk-hero { margin-top: 0; padding-top: 32px; } }
  .pk-emoji {
    font-size: 40px; line-height: 1;
    width: 84px; height: 84px; margin: 0 auto var(--space-3);
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28);
    border-radius: 50%;
  }
  .pk-title {
    font-family: 'Caveat', 'Bricolage Grotesque', cursive;
    font-size: clamp(42px, 9vw, 72px);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0;
    margin-bottom: var(--space-3);
    line-height: 0.98;
  }
  .pk-meta {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: var(--space-2);
    font-size: 14px; color: rgba(255,255,255,0.9);
    margin-bottom: var(--space-3);
  }
  .pk-meta span {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28);
    border-radius: 999px; padding: 6px 14px; font-weight: 500; color: #fff;
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
  }
  .pk-desc {
    font-size: 15px; color: rgba(255,255,255,0.88); line-height: 1.6;
    max-width: 480px; margin: 0 auto;
  }
  .pk-desc-detail { margin-top: 6px; font-size: 13px; }

  /* ── Stats strip ────────────────────────────────────── */
  .pk-stats {
    display: flex; justify-content: center; gap: var(--space-5);
    padding: var(--space-4) var(--space-4) 0;
    max-width: 620px; margin: 0 auto;
  }
  .pk-stat { text-align: center; }
  .pk-stat-num {
    font-family: var(--font-display); font-size: 32px; font-weight: 900;
    background: var(--cta-bg); -webkit-background-clip: text;
    background-clip: text; -webkit-text-fill-color: transparent;
    color: var(--accent);
  }
  .pk-stat-label { font-size: 12px; color: var(--text-sec); margin-top: 2px; }

  /* ── RSVP card ──────────────────────────────────────── */
  .pk-rsvp {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-5);
    box-shadow: var(--card-shadow);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .pk-rsvp.success {
    border-color: var(--green);
    box-shadow: 0 0 0 4px var(--green-dim);
  }
  .pk-step-label {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 1.5px; color: var(--accent); margin-bottom: var(--space-2);
  }
  .pk-step-title {
    font-family: var(--font-display); font-size: 20px; font-weight: 700;
    color: var(--text); margin-bottom: var(--space-3);
  }

  /* Fields */
  .pk-fields { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-3); }
  @media (max-width: 500px) { .pk-fields { grid-template-columns: 1fr; } }
  .pk-field label {
    display: block; font-size: 12px; font-weight: 600;
    color: var(--text-sec); margin-bottom: 4px;
  }
  .pk-field label .opt { font-weight: 400; color: var(--text-faint); }
  .pk-input, .pk-select {
    width: 100%; padding: 12px 14px;
    background: rgba(0,0,0,0.04); border: 1.5px solid transparent;
    border-radius: 10px; font-size: 16px; color: var(--text);
    font-family: var(--font); outline: none; -webkit-appearance: none;
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .pk-input::placeholder { color: var(--text-faint); }
  .pk-input:focus, .pk-select:focus { background: rgba(255,255,255,0.7); border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
  .pk-input.invalid { border-color: #EF4444; }

  .pk-guests {
    display: flex; align-items: center; gap: 8px;
    margin-bottom: var(--space-3);
  }
  .pk-guests-label { font-size: 13px; color: var(--text-sec); font-weight: 600; }
  .pk-guests button {
    width: 44px; height: 44px; border-radius: 50%;
    border: 1.5px solid var(--border); background: var(--bg);
    color: var(--text); font-size: 20px; font-weight: 600;
    cursor: pointer; font-family: inherit; line-height: 1;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .pk-guests button:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-dim); }
  .pk-guests .count { font-weight: 700; font-size: 16px; min-width: 24px; text-align: center; color: var(--text); }
  .pk-guests .note { font-size: 13px; color: var(--text-faint); }

  /* CTA */
  .pk-cta {
    width: 100%; padding: 15px;
    border-radius: var(--radius-pill);
    border: none; cursor: pointer;
    background: var(--cta-bg); color: var(--cta-text);
    font-family: var(--font-display); font-size: 17px; font-weight: 800;
    box-shadow: 0 4px 16px var(--cta-glow);
    transition: box-shadow 0.2s, transform 0.15s, filter 0.2s;
  }
  .pk-cta:hover { box-shadow: 0 8px 24px var(--cta-glow); transform: translateY(-2px) scale(1.01); filter: saturate(1.08); }
  .pk-cta:active { transform: translateY(0) scale(0.99); }
  .pk-cta:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  /* Step 2 — Category Picker */
  #step2 { display: none; }
  .pk-pick-intro { font-size: 14px; color: var(--text-sec); margin-bottom: var(--space-3); line-height: 1.5; }

  .pk-cat-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;
    margin-bottom: var(--space-3);
  }
  @media (max-width: 500px) { .pk-cat-grid { grid-template-columns: repeat(2, 1fr); } }
  .pk-cat-card {
    display: flex; flex-direction: column; align-items: center;
    gap: 4px; padding: 14px 8px;
    background: var(--bg); border: 1.5px solid var(--border);
    border-radius: 12px; cursor: pointer;
    font-family: var(--font); transition: border-color 0.15s, background 0.15s, transform 0.1s, box-shadow 0.15s;
  }
  .pk-cat-card:hover { border-color: var(--accent); background: var(--bg); transform: translateY(-2px); box-shadow: var(--card-shadow); }
  .pk-cat-card.selected { border-color: var(--accent); background: var(--accent-dim); box-shadow: inset 0 0 0 1px var(--accent); }
  .pk-cat-card.full { opacity: 0.4; cursor: default; }
  .pk-cat-card.full:hover { border-color: var(--border); background: var(--surface); transform: none; }
  .pk-cat-custom { border-style: dashed; color: var(--text-sec); }
  .pk-cat-custom:hover { border-style: solid; }
  .pk-cat-custom.selected { border-style: solid; }
  .pk-cat-emoji { font-size: 28px; }
  .pk-cat-name { font-size: 13px; font-weight: 600; color: var(--text); text-align: center; line-height: 1.2; }
  .pk-cat-status { font-size: 11px; font-weight: 600; }
  .pk-cat-status.open { color: var(--green); }
  .pk-cat-status.full { color: var(--text-faint); }

  .pk-dish-wrap { margin-bottom: var(--space-3); }
  .pk-dish-label {
    display: block; font-size: 13px; font-weight: 600;
    color: var(--text-sec); margin-bottom: 6px;
  }
  .pk-dish-label .opt { font-weight: 400; color: var(--text-faint); }
  /* (old slot-item radio styles removed — now using category cards) */

  .pk-step2-btns { display: flex; gap: var(--space-2); margin-top: var(--space-4); }
  .pk-skip {
    flex: 1; padding: 12px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border);
    background: var(--bg); color: var(--text-sec);
    font-family: var(--font); font-size: 14px; font-weight: 600;
    cursor: pointer; transition: border-color 0.15s;
  }
  .pk-skip:hover { border-color: var(--text-sec); color: var(--text); }
  .pk-save {
    flex: 2; padding: 13px;
    border-radius: var(--radius-pill);
    border: none; cursor: pointer;
    background: var(--cta-bg); color: var(--cta-text);
    font-family: var(--font-display); font-size: 15px; font-weight: 800;
    box-shadow: 0 4px 14px var(--cta-glow);
    transition: box-shadow 0.2s, transform 0.15s, filter 0.2s;
  }
  .pk-save:hover { box-shadow: 0 8px 22px var(--cta-glow); transform: translateY(-2px); filter: saturate(1.08); }
  .pk-save:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .pk-error { font-size: 13px; color: #EF4444; margin-top: var(--space-2); display: none; }
  .pk-error.show { display: block; }

  /* ── Section headings ──────────────────────────────── */
  .pk-section-title {
    font-family: var(--font-display); font-size: 20px; font-weight: 800;
    color: var(--text); margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--border);
    letter-spacing: -0.01em;
  }

  /* ── Sign-up sheet (SignUpGenius style) ────────────── */
  .pk-sug-group {
    margin-bottom: var(--space-3);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .pk-sug-header {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 16px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .pk-sug-emoji { font-size: 20px; }
  .pk-sug-cat {
    font-family: var(--font-display); font-size: 15px; font-weight: 700;
    color: var(--text); flex: 1;
  }
  .pk-sug-spots {
    font-size: 12px; font-weight: 600; color: var(--green);
    background: rgba(16, 185, 129, 0.08); border-radius: 999px;
    padding: 3px 10px;
  }
  .pk-sug-spots.full { color: var(--text-faint); background: var(--surface-hover); }
  .pk-sug-people { padding: 4px 0; }
  .pk-sug-person {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--surface-hover);
  }
  .pk-sug-person:last-child { border-bottom: none; }
  .pk-sug-check {
    width: 22px; height: 22px; border-radius: 50%;
    background: rgba(16, 185, 129, 0.1); color: var(--green);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; flex-shrink: 0;
  }
  .pk-sug-pname { font-size: 14px; font-weight: 600; color: var(--text); }
  .pk-sug-dish {
    margin-left: auto; font-size: 13px; color: var(--text-sec);
    font-style: italic;
  }
  .pk-sug-empty {
    padding: 14px 16px;
    font-size: 13px; color: var(--text-faint); font-style: italic;
  }

  /* ── Who's coming ───────────────────────────────────── */
  .pk-guests-row {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-top: var(--space-2);
  }
  .pk-guest {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 12px 8px 8px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    min-width: 0;
  }
  .pk-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--cta-bg);
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 12px; flex-shrink: 0;
  }
  .pk-guest-info { display: flex; flex-direction: column; min-width: 0; }
  .pk-guest-name { font-size: 13px; font-weight: 600; color: var(--text); white-space: nowrap; }
  .pk-guest-dish { font-size: 11px; color: var(--text-sec); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 160px; }
  .pk-guest-plus { margin-left: auto; font-size: 12px; color: var(--accent); font-weight: 600; }
  .pk-join-nudge { text-align: center; padding: var(--space-4); color: var(--text-sec); font-size: 14px; border: 1px dashed var(--border); border-radius: var(--radius); margin-top: var(--space-3); }
  .pk-empty { padding: var(--space-5); text-align: center; color: var(--text-faint); font-style: italic; }

  /* ── Your signup (multi-slot) card ─────────────────── */
  .pk-mine { display: none; }
  .pk-mine.show { display: block; }
  .pk-mine-summary {
    font-size: 14px; color: var(--text); margin-bottom: var(--space-3);
    line-height: 1.5;
  }
  .pk-mine-summary strong { color: var(--accent); }
  .pk-mine-list {
    display: flex; flex-direction: column; gap: 8px;
    margin-bottom: var(--space-3);
  }
  .pk-mine-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px;
    background: var(--surface); border: 1.5px solid var(--border);
    border-radius: 12px;
  }
  .pk-mine-item-text { flex: 1; min-width: 0; font-size: 14px; color: var(--text); }
  .pk-mine-item-cat { font-size: 12px; color: var(--text-sec); margin-top: 2px; }
  .pk-mine-item-btns { display: flex; gap: 6px; flex-shrink: 0; }
  .pk-mine-mini {
    background: none; border: none; cursor: pointer;
    font-size: 12px; font-weight: 600; color: var(--text-sec);
    padding: 4px 8px; border-radius: 6px;
    font-family: inherit;
    transition: background 0.15s, color 0.15s;
  }
  .pk-mine-mini:hover { background: var(--surface-hover); color: var(--text); }
  .pk-mine-mini.danger:hover { color: #EF4444; }
  .pk-mine-edit {
    display: flex; flex-direction: column; gap: 8px;
    padding: 12px;
    background: var(--bg); border: 1.5px solid var(--accent);
    border-radius: 12px;
  }
  @media (min-width: 500px) {
    .pk-mine-edit { flex-direction: row; align-items: center; }
    .pk-mine-edit .pk-input, .pk-mine-edit .pk-select { flex: 1; }
  }
  .pk-mine-edit-btns { display: flex; gap: 6px; }
  .pk-mine-add {
    display: flex; flex-direction: column; gap: 8px;
    padding: 12px;
    background: var(--surface); border: 1.5px dashed var(--border);
    border-radius: 12px;
    margin-bottom: var(--space-3);
  }
  .pk-mine-add.open { border-color: var(--accent); background: var(--bg); }
  @media (min-width: 500px) {
    .pk-mine-add-fields { display: flex; gap: 8px; }
    .pk-mine-add-fields > * { flex: 1; }
  }
  .pk-mine-add-toggle {
    width: 100%; padding: 12px;
    border-radius: var(--radius-pill);
    border: 1.5px dashed var(--border);
    background: var(--bg); color: var(--accent);
    font-family: var(--font); font-size: 14px; font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .pk-mine-add-toggle:hover { border-color: var(--accent); background: var(--surface); }
  .pk-mine-cancel-link {
    display: block; text-align: center;
    margin-top: var(--space-3);
    font-size: 12px; color: var(--text-faint);
    background: none; border: none; cursor: pointer;
    font-family: inherit; padding: 4px;
    text-decoration: underline;
  }
  .pk-mine-cancel-link:hover { color: #EF4444; }
  .pk-mine-err {
    font-size: 12px; color: #EF4444; margin-top: 6px; display: none;
  }
  .pk-mine-err.show { display: block; }

  /* ── Manage RSVP section ───────────────────────────── */
  .pk-manage {
    background: var(--surface); border: 1.5px solid var(--border);
    border-radius: var(--radius-lg); padding: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .pk-manage-title {
    font-family: var(--font-display); font-size: 16px; font-weight: 700;
    color: var(--text); margin-bottom: var(--space-2);
  }
  .pk-manage-sub { font-size: 13px; color: var(--text-sec); margin-bottom: var(--space-3); line-height: 1.5; }
  .pk-manage-fields { display: flex; gap: var(--space-2); margin-bottom: var(--space-2); }
  @media (max-width: 500px) { .pk-manage-fields { flex-direction: column; } }
  .pk-manage-fields .pk-input { flex: 1; padding: 10px 12px; font-size: 14px; }
  .pk-manage-btn {
    padding: 10px 20px; border-radius: var(--radius-pill);
    border: 1.5px solid var(--accent); background: var(--bg);
    color: var(--accent); font-family: var(--font); font-size: 13px;
    font-weight: 600; cursor: pointer; white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .pk-manage-btn:hover { background: var(--accent); color: #fff; }
  .pk-manage-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .pk-manage-err { font-size: 12px; color: #EF4444; margin-top: var(--space-1); display: none; }
  .pk-manage-err.show { display: block; }

  /* ── Actions row ────────────────────────────────────── */
  .pk-actions {
    display: flex; gap: var(--space-3); justify-content: center;
    margin-bottom: var(--space-5); flex-wrap: wrap;
  }
  .pk-action-btn {
    background: none; border: none; color: var(--text-sec);
    font-size: 13px; cursor: pointer; padding: 0;
    font-family: inherit; display: inline-flex;
    align-items: center; gap: 4px;
    text-decoration: none;
  }
  .pk-action-btn:hover { color: var(--text); }

  /* ── Toast ──────────────────────────────────────────── */
  .pk-toast {
    position: fixed; bottom: 24px; left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: var(--green); color: #fff;
    padding: 12px 24px; border-radius: 999px;
    font-size: 14px; font-weight: 600;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    z-index: 1000; opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .pk-toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

  /* ── Confirmation overlay ───────────────────────────── */
  .pk-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(15,23,42,0.55); z-index: 1000;
    align-items: center; justify-content: center; padding: 20px;
  }
  .pk-overlay.show { display: flex; }
  .pk-overlay-card {
    background: var(--bg); border-radius: var(--radius-lg);
    max-width: 440px; width: 100%; padding: var(--space-5);
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    text-align: center;
  }
  .pk-overlay-emoji { font-size: 48px; margin-bottom: var(--space-2); }
  .pk-overlay h2 {
    font-family: var(--font-display); font-size: 24px;
    font-weight: 800; margin-bottom: 4px;
  }
  .pk-overlay-sub { color: var(--text-sec); font-size: 14px; margin-bottom: var(--space-4); }
  .pk-overlay-block {
    background: var(--surface); border-radius: 12px;
    padding: 14px 16px; margin-bottom: 10px; text-align: left;
  }
  .pk-overlay-block-label {
    font-size: 11px; font-weight: 700; color: var(--text-sec);
