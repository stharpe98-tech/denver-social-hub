</style>

<!-- ── HERO ────────────────────────────────────────────── -->
<section class="pk-hero">
  <div class="pk-emoji">🍽️</div>
  <h1 class="pk-title">{potluck.title}</h1>
  <div class="pk-meta">
    {potluck.date_label && <span>📅 {potluck.date_label}{potluck.time_label ? ` · ${potluck.time_label}` : ''}</span>}
    {potluck.location && <span>📍 {potluck.location}</span>}
  </div>
  {potluck.description && <p class="pk-desc">{potluck.description}</p>}
  {potluck.location_detail && <p class="pk-desc pk-desc-detail">{potluck.location_detail}</p>}
  {(potluck.latitude && potluck.longitude) || potluck.plus_code ? (
    <div class="pk-directions">
      {potluck.plus_code && (
        <span class="pk-pluscode" title="Google Plus Code — paste in Maps to find this spot">📍 {potluck.plus_code}</span>
      )}
      <a
        class="pk-dir-btn"
        href={potluck.latitude && potluck.longitude
          ? `https://www.google.com/maps/dir/?api=1&destination=${potluck.latitude},${potluck.longitude}`
          : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(potluck.plus_code || potluck.location || '')}`}
        target="_blank"
        rel="noopener"
      >Get directions →</a>
    </div>
  ) : null}
</section>
<style>
  .pk-directions { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: center; }
  .pk-pluscode { background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); border-radius: 999px; padding: 6px 14px; font-family: monospace; font-size: 13px; color: #fff; }
  .pk-dir-btn { background: var(--accent2); color: #16302B; padding: 8px 18px; border-radius: 999px; font-size: 14px; font-weight: 700; text-decoration: none; box-shadow: 0 2px 8px rgba(232,144,42,0.3); transition: transform 0.15s, box-shadow 0.15s; }
  .pk-dir-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(232,144,42,0.4); }
</style>

<!-- ── STATS ──────────────────────────────────────────── -->
<div class="pk-stats">
  <div class="pk-stat">
    <div class="pk-stat-num">{guestTotal}</div>
    <div class="pk-stat-label">{guestTotal === 1 ? 'person' : 'people'} coming</div>
  </div>
  <div class="pk-stat">
    <div class="pk-stat-num">{totalWithDishes}</div>
    <div class="pk-stat-label">dishes signed up</div>
  </div>
</div>

<div class="pk">
  <!-- ── ACTIONS ────────────────────────────────────────── -->
  <div class="pk-actions" style="margin-top:var(--space-4)">
    <button class="pk-action-btn" id="copy-link">🔗 Copy link</button>
  </div>

  <!-- ── RSVP CARD ──────────────────────────────────────── -->
  <div class="pk-rsvp" id="rsvp-card">

    <!-- STEP 1: Quick sign-up -->
    <div id="step1">
      <div class="pk-step-label">Step 1</div>
      <div class="pk-step-title">Count me in! 🎉</div>

      <div class="pk-fields">
        <div class="pk-field">
          <label>First name *</label>
          <input type="text" class="pk-input" id="f-first" placeholder="First name" autocomplete="given-name"/>
        </div>
        <div class="pk-field">
          <label>Last name <span class="opt">(optional)</span></label>
          <input type="text" class="pk-input" id="f-last" placeholder="Last initial" autocomplete="family-name"/>
        </div>
        <div class="pk-field">
          <label>Email <span class="opt">(for reminders)</span></label>
          <input type="email" class="pk-input" id="f-email" placeholder="you@example.com" autocomplete="email"/>
        </div>
      </div>

      <div class="pk-guests">
        <span class="pk-guests-label">How many?</span>
        <button type="button" id="g-minus">−</button>
        <span class="count" id="g-count">1</span>
        <button type="button" id="g-plus">+</button>
        <span class="note" id="g-note">just me</span>
      </div>

      <button class="pk-cta" id="step1-btn">I'm in! 🎉</button>
      <div class="pk-error" id="step1-err"></div>
    </div>

    <!-- STEP 2: Pick a category + say what you're bringing -->
    <div id="step2">
      <div class="pk-step-label">Step 2</div>
      <div class="pk-step-title">On the menu — what are you bringing? 🍽️</div>
      <p class="pk-pick-intro">Pick a category, then tell us what you're bringing — or skip if you're just coming to hang out!</p>

      <div id="cat-picker" class="pk-cat-grid">
        {slots.map((slot: any) => {
          const isFull = slot.max_claims < 900 && slot.claim_count >= slot.max_claims;
          const spotsLeft = slot.max_claims < 900 ? slot.max_claims - slot.claim_count : null;
          const catEmoji = (slot.category || '').match(/^(\p{Emoji_Presentation}|\p{Emoji}️)/u)?.[0] || '🍽️';
          const catLabel = (slot.category || '').replace(/^(\p{Emoji_Presentation}|\p{Emoji}️)\s*/u, '');
          return (
            <button
              type="button"
              class={`pk-cat-card ${isFull ? 'full' : ''}`}
              data-category={slot.category}
              disabled={isFull}
            >
              <span class="pk-cat-emoji">{catEmoji}</span>
              <span class="pk-cat-name">{catLabel}</span>
              {isFull ? (
                <span class="pk-cat-status full">Full</span>
              ) : spotsLeft !== null ? (
                <span class="pk-cat-status open">{spotsLeft} spot{spotsLeft !== 1 ? 's' : ''}</span>
              ) : (
                <span class="pk-cat-status open">Open</span>
              )}
            </button>
          );
        })}
        <button type="button" class="pk-cat-card pk-cat-custom" id="cat-custom-btn">
          <span class="pk-cat-emoji">＋</span>
          <span class="pk-cat-name">Something else</span>
          <span class="pk-cat-status open">Add your own</span>
        </button>
      </div>

      <div id="custom-cat-wrap" class="pk-dish-wrap" style="display:none">
        <label class="pk-dish-label">Pick a category <span class="opt">(or type your own)</span></label>
        <input type="text" class="pk-input" id="f-custom-cat" list="cat-suggestions" placeholder="e.g. Bread, Side, Salad…" autocomplete="off"/>
        <datalist id="cat-suggestions">
          <option value="🥗 Salad"></option>
          <option value="🍞 Bread"></option>
          <option value="🥦 Side"></option>
          <option value="🍰 Dessert"></option>
          <option value="🥤 Drinks"></option>
          <option value="🍿 Snack"></option>
          <option value="🧀 Cheese board"></option>
          <option value="🍎 Fruit"></option>
          <option value="🧊 Ice"></option>
          <option value="🍴 Plates & utensils"></option>
        </datalist>
      </div>

      <div id="dish-input-wrap" class="pk-dish-wrap" style="display:none">
        <label class="pk-dish-label">What are you bringing? <span class="opt">(e.g. "Spinach dip", "Brownies")</span></label>
        <input type="text" class="pk-input" id="f-dish" placeholder="Type what you're bringing…" autocomplete="off"/>
      </div>

      <div class="pk-step2-btns">
        <button class="pk-skip" id="skip-btn">Just showing up</button>
        <button class="pk-save" id="save-btn" disabled>Sign me up 🎉</button>
      </div>
      <div class="pk-error" id="step2-err"></div>
    </div>
  </div>

  <!-- ── YOUR SIGNUP (multi-slot, token-anchored) ──────── -->
  <div class="pk-rsvp pk-mine" id="mine-card">
    <div class="pk-step-label">Your signup</div>
    <div class="pk-step-title" id="mine-title">You're in! 🎉</div>
    <div class="pk-mine-summary" id="mine-summary"></div>

    <div class="pk-guests" style="margin-bottom:var(--space-3)">
      <span class="pk-guests-label">Guests</span>
      <button type="button" id="mine-g-minus">−</button>
      <span class="count" id="mine-g-count">1</span>
      <button type="button" id="mine-g-plus">+</button>
      <span class="note" id="mine-g-note">just me</span>
    </div>

    <div class="pk-mine-list" id="mine-list"></div>

    <div class="pk-mine-add" id="mine-add">
      <button type="button" class="pk-mine-add-toggle" id="mine-add-toggle">+ Bring something else</button>
      <div id="mine-add-form" style="display:none">
        <div class="pk-mine-add-fields">
          <select class="pk-select" id="mine-add-cat">
            <option value="">Category…</option>
            {slots.map((slot: any) => (
              <option value={slot.category}>{slot.category}</option>
            ))}
          </select>
          <input type="text" class="pk-input" id="mine-add-dish" placeholder="What are you bringing?" autocomplete="off"/>
        </div>
        <div class="pk-mine-edit-btns" style="margin-top:8px">
          <button type="button" class="pk-skip" id="mine-add-cancel">Cancel</button>
          <button type="button" class="pk-save" id="mine-add-save">Add it</button>
        </div>
        <div class="pk-mine-err" id="mine-add-err"></div>
      </div>
    </div>

    <button type="button" class="pk-mine-cancel-link" id="mine-cancel">Cancel my signup entirely</button>
    <div class="pk-mine-err" id="mine-err"></div>
  </div>

  <!-- ── MANAGE YOUR RSVP ──────────────────────────────── -->
  <div class="pk-manage" id="manage-section">
    <div class="pk-manage-title">Already signed up?</div>
    <div class="pk-manage-sub">Enter your name or email to edit or cancel your sign-up.</div>
    <div class="pk-manage-fields">
      <input type="text" class="pk-input" id="m-lookup" placeholder="Your name or email" autocomplete="off"/>
      <button class="pk-manage-btn" id="m-lookup-btn">Find my RSVP</button>
    </div>
    <div class="pk-manage-err" id="m-lookup-err"></div>
  </div>

  <!-- ── SIGN-UP SHEET (SignUpGenius style) ────────────── -->
  <div class="pk-section-title">What everyone's bringing</div>
  {slots.map((slot: any) => {
    const catEmoji = (slot.category || '').match(/^(\p{Emoji_Presentation}|\p{Emoji}️)/u)?.[0] || '🍽️';
    const catLabel = (slot.category || '').replace(/^(\p{Emoji_Presentation}|\p{Emoji}️)\s*/u, '');
    const people = rsvpsByCategory[slot.category] || [];
    const spotsLeft = slot.max_claims < 900 ? slot.max_claims - slot.claim_count : null;
    return (
      <div class="pk-sug-group">
        <div class="pk-sug-header">
          <span class="pk-sug-emoji">{catEmoji}</span>
          <span class="pk-sug-cat">{catLabel}</span>
          {spotsLeft !== null && spotsLeft > 0 && (
            <span class="pk-sug-spots">{spotsLeft} spot{spotsLeft !== 1 ? 's' : ''} open</span>
          )}
          {spotsLeft !== null && spotsLeft <= 0 && (
            <span class="pk-sug-spots full">Full</span>
          )}
        </div>
        <div class="pk-sug-people">
          {people.length > 0 ? people.map((p) => (
            <div class="pk-sug-person">
              <span class="pk-sug-check">✓</span>
              <span class="pk-sug-pname">{p.name}</span>
              <span class="pk-sug-dish">{p.dish}</span>
            </div>
          )) : (
            <div class="pk-sug-empty">Be the first to sign up!</div>
          )}
        </div>
      </div>
    );
  })}

  <!-- ── WHO'S COMING ─────────────────────────────────── -->
  <div class="pk-section-title" style="margin-top:var(--space-6)">Who's coming ({guestTotal})</div>
  {uniqueGuests.length === 0 ? (
    <div class="pk-empty">Nobody's signed up yet — be the first!</div>
  ) : (
    <Fragment>
      <div class="pk-guests-row">
        {uniqueGuests.map((g) => (
          <div class="pk-guest">
            <div class="pk-avatar">{(g.name || '?').split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase()}</div>
            <div class="pk-guest-info">
              <div class="pk-guest-name">{(g.name || '').split(' ')[0]}{g.guest_count > 1 ? ` +${g.guest_count - 1}` : ''}</div>
              {g.dishes.length > 0 && <div class="pk-guest-dish">{g.dishes.join(' · ')}</div>}
            </div>
          </div>
        ))}
      </div>
      {uniqueGuests.length < 3 && (
        <div class="pk-join-nudge">It's early — be one of the first to join!</div>
      )}
    </Fragment>
  )}
</div>

<!-- Toast -->
<div class="pk-toast" id="toast"></div>

<!-- Confirmation overlay -->
<div class="pk-overlay" id="confirm-overlay">
  <div class="pk-overlay-card">
    <div class="pk-overlay-emoji">🎉</div>
    <h2 id="confirm-title">You're in!</h2>
    <div class="pk-overlay-sub">Confirmation email is on the way.</div>
    <div class="pk-overlay-block" id="confirm-contact" style="display:none">
      <div class="pk-overlay-block-label">Stay in touch</div>
      <div class="pk-overlay-rows" id="confirm-contact-rows"></div>
    </div>
    <div class="pk-overlay-block pay" id="confirm-pay" style="display:none">
      <div class="pk-overlay-block-label">Want to chip in?</div>
      <div class="pk-overlay-rows" id="confirm-pay-rows"></div>
    </div>
    <button class="pk-overlay-ok" id="confirm-ok">Got it ✨</button>
  </div>
</div>

<script is:inline define:vars={{ potluckId: id }}>
(function () {
  var guestCount = 1;

  function $(id) { return document.getElementById(id); }
  function val(id) { var el = $(id); return el ? el.value.trim() : ''; }
  function guestNote(n) { return n === 1 ? 'just me' : '+ ' + (n - 1) + (n === 2 ? ' guest' : ' guests'); }
  function escHtml(s) {
    return String(s || '').replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  // ── Guest counter ────────────────────────────────────
  $('g-minus').addEventListener('click', function () {
    guestCount = Math.max(1, guestCount - 1);
    $('g-count').textContent = guestCount;
    $('g-note').textContent = guestNote(guestCount);
  });
  $('g-plus').addEventListener('click', function () {
    guestCount = Math.min(20, guestCount + 1);
    $('g-count').textContent = guestCount;
    $('g-note').textContent = guestNote(guestCount);
  });

  // ── Step 1 → Step 2 ─────────────────────────────────
  $('step1-btn').addEventListener('click', function () {
    var first = val('f-first');
    if (!first) {
      $('f-first').classList.add('invalid');
      $('f-first').focus();
      return;
    }
    $('f-first').classList.remove('invalid');
    $('step1').style.display = 'none';
    $('step2').style.display = 'block';
    $('rsvp-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ── Category card picker ─────────────────────────────
  var selectedCategory = '';
  var isCustomCat = false;
  var catCards = document.querySelectorAll('.pk-cat-card');
  catCards.forEach(function (card) {
    card.addEventListener('click', function () {
      if (card.disabled) return;
      catCards.forEach(function (c) { c.classList.remove('selected'); });
      card.classList.add('selected');
      isCustomCat = card.id === 'cat-custom-btn';
      if (isCustomCat) {
        selectedCategory = '';
        $('custom-cat-wrap').style.display = 'block';
        $('f-custom-cat').focus();
      } else {
        selectedCategory = card.getAttribute('data-category') || '';
        $('custom-cat-wrap').style.display = 'none';
      }
      $('dish-input-wrap').style.display = 'block';
      $('save-btn').disabled = false;
      $('step2-err').classList.remove('show');
    });
  });

  // ── Skip → submit with no dish ──────────────────────
  $('skip-btn').addEventListener('click', function () {
    submitRsvp('', '');
  });

  // ── Save pick → submit with category + dish text ────
  $('save-btn').addEventListener('click', function () {
    var category = selectedCategory;
    if (isCustomCat) {
      category = val('f-custom-cat');
      if (!category) {
        $('step2-err').textContent = 'Type a category name (e.g. "Salad", "Bread").';
        $('step2-err').classList.add('show');
        $('f-custom-cat').focus();
        return;
      }
    }
    if (!category) {
      $('step2-err').textContent = 'Pick a category first, or tap "Just showing up".';
      $('step2-err').classList.add('show');
      return;
    }
    var dish = val('f-dish');
    if (!dish) {
      $('step2-err').textContent = 'Tell us what you\'re bringing! (e.g. "Brownies", "Chips & salsa")';
      $('step2-err').classList.add('show');
      $('f-dish').focus();
      return;
    }
    $('step2-err').classList.remove('show');
    submitRsvp(dish, category);
  });

  // ── Submit to API ────────────────────────────────────
  function submitRsvp(dish, dishCategory) {
    var btn = $('save-btn');
    var errId = 'step2-err';
    var origText = btn.textContent;
    btn.disabled = true;
    $('skip-btn').disabled = true;
    btn.textContent = 'Saving…';

    var first = val('f-first');
    var last = val('f-last');
    var name = last ? first + ' ' + last : first;

    fetch('/api/potluck', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        potluckId: String(potluckId),
        name: name,
        email: val('f-email'),
        phone: '',
        handle: '', platforms: '',
        rsvp: 'yes',
        guestCount: String(guestCount),
        dish: dish,
        dishCategory: dishCategory,
        dietary: '', notes: '',
        utensils: false, earlyArrive: false, seating: false,
        _gotcha: '', _turnstile: '',
      }),
    })
    .then(function (res) { return res.json(); })
    .then(function (data) {
      if (!data.ok) {
        $(errId).textContent = data.error === 'slot_full'
          ? 'Someone just claimed that — try another!'
          : 'Something went wrong — try again.';
        $(errId).classList.add('show');
        btn.disabled = false;
        $('skip-btn').disabled = false;
        btn.textContent = origText;
        return;
      }
      if (data.signup_token) {
        try { localStorage.setItem('dsn_potluck_' + potluckId, data.signup_token); } catch (_) {}
      }
      showConfirm(first, data.contact || {});
    })
    .catch(function () {
      $(errId).textContent = 'Network problem — try again.';
      $(errId).classList.add('show');
      btn.disabled = false;
      $('skip-btn').disabled = false;
      btn.textContent = origText;
    });
  }

  // ── Confirmation overlay ─────────────────────────────
  function showConfirm(firstName, contact) {
    $('confirm-title').textContent = "You're in, " + firstName + '!';

    var ccRows = [];
    if (contact.phone) ccRows.push('<div>📞 ' + escHtml(contact.phone) + '</div>');
    if (contact.discord_url) {
      ccRows.push('<div>💬 <a href="' + escHtml(contact.discord_url) + '" target="_blank" rel="noopener">Join Discord</a>' + (contact.discord ? ' · ' + escHtml(contact.discord) : '') + '</div>');
    } else if (contact.discord) {
      ccRows.push('<div>💬 ' + escHtml(contact.discord) + '</div>');
    }
    if (ccRows.length) {
      $('confirm-contact-rows').innerHTML = ccRows.join('');
      $('confirm-contact').style.display = 'block';
    }

    var payRows = [];
    if (contact.venmo) payRows.push('<div>💸 Venmo: <a href="https://venmo.com/' + escHtml(String(contact.venmo).replace(/^@/, '')) + '" target="_blank" rel="noopener">' + escHtml(contact.venmo) + '</a></div>');
    if (contact.cashapp_handle) payRows.push('<div>💵 Cash App: <a href="https://cash.app/' + escHtml(String(contact.cashapp_handle).replace(/^\$/, '$')) + '" target="_blank" rel="noopener">' + escHtml(contact.cashapp_handle) + '</a></div>');
    if (contact.stripe_link) payRows.push('<div>💳 <a href="' + escHtml(contact.stripe_link) + '" target="_blank" rel="noopener">Pay with card</a></div>');
    if (payRows.length) {
      $('confirm-pay-rows').innerHTML = payRows.join('');
      $('confirm-pay').style.display = 'block';
    }

    $('rsvp-card').classList.add('success');
    $('confirm-overlay').classList.add('show');
  }

  $('confirm-ok').addEventListener('click', function () {
    $('confirm-overlay').classList.remove('show');
    location.reload();
  });

  // ── Copy link ────────────────────────────────────────
  $('copy-link').addEventListener('click', function () {
    navigator.clipboard.writeText(location.href).then(function () {
      var t = $('toast');
      t.textContent = 'Link copied ✓';
      t.classList.add('show');
      setTimeout(function () { t.classList.remove('show'); }, 2000);
    }).catch(function () {});
  });

  // ── Your-signup (token-anchored multi-slot) ─────────
  var STORAGE_KEY = 'dsn_potluck_' + potluckId;
  var mineToken = '';
  var mineSignups = [];
  var minePrimary = null;
  var guestUpdateTimer = null;

  function getToken() {
    try { return localStorage.getItem(STORAGE_KEY) || ''; } catch (_) { return ''; }
  }
  function clearToken() {
    try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
  }

  function renderMine() {
    if (!minePrimary) return;
    var nonPrimary = mineSignups.filter(function (s) { return !s.is_primary; });
    var dishItems = mineSignups.filter(function (s) { return s.dish; });
    var gc = parseInt(minePrimary.guest_count) || 1;
    var summary;
    if (dishItems.length === 0) {
      summary = "You're in for <strong>" + gc + (gc === 1 ? ' guest' : ' guests') + "</strong> — just hanging out, no dish.";
    } else {
      var names = dishItems.map(function (s) { return '<strong>' + escHtml(s.dish) + '</strong>'; }).join(', ');
      summary = "You're in — bringing " + names + " for <strong>" + gc + (gc === 1 ? ' guest' : ' guests') + "</strong>.";
    }
    $('mine-title').textContent = "You're in, " + (minePrimary.name || 'friend').split(' ')[0] + "! 🎉";
    $('mine-summary').innerHTML = '✓ ' + summary;
    $('mine-g-count').textContent = gc;
    $('mine-g-note').textContent = guestNote(gc);

    var listEl = $('mine-list');
    listEl.innerHTML = '';
    mineSignups.forEach(function (s) {
      if (!s.dish) return;
      var row = document.createElement('div');
      row.className = 'pk-mine-item';
      row.setAttribute('data-id', s.id);
      var canRemove = !s.is_primary;
      row.innerHTML =
        '<div class="pk-mine-item-text">' +
          escHtml(s.dish) +
          '<div class="pk-mine-item-cat">' + escHtml(s.dish_category || '') + '</div>' +
        '</div>' +
        '<div class="pk-mine-item-btns">' +
          '<button type="button" class="pk-mine-mini" data-act="edit">Edit</button>' +
          (canRemove ? '<button type="button" class="pk-mine-mini danger" data-act="remove">Remove</button>' : '') +
        '</div>';
      listEl.appendChild(row);
    });
  }

  function showMineCard() {
    $('rsvp-card').style.display = 'none';
    $('mine-card').classList.add('show');
  }

  function loadMine(cb) {
    var token = getToken();
    if (!token) { if (cb) cb(false); return; }
    fetch('/api/potlucks/mine', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ potluck_id: parseInt(String(potluckId)), signup_token: token }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (!data.ok || !data.signups || !data.signups.length) {
        clearToken();
        if (cb) cb(false);
        return;
      }
      mineToken = token;
      mineSignups = data.signups;
      minePrimary = mineSignups.filter(function (s) { return s.is_primary; })[0] || mineSignups[0];
      renderMine();
      showMineCard();
      if (cb) cb(true);
    })
    .catch(function () { if (cb) cb(false); });
  }

  // Guest counter on mine card (debounced PATCH)
  $('mine-g-minus').addEventListener('click', function () {
    if (!minePrimary) return;
    var n = Math.max(1, (parseInt(minePrimary.guest_count) || 1) - 1);
    minePrimary.guest_count = n;
    $('mine-g-count').textContent = n;
    $('mine-g-note').textContent = guestNote(n);
    renderMine();
    scheduleGuestUpdate(n);
  });
  $('mine-g-plus').addEventListener('click', function () {
    if (!minePrimary) return;
    var n = Math.min(20, (parseInt(minePrimary.guest_count) || 1) + 1);
    minePrimary.guest_count = n;
    $('mine-g-count').textContent = n;
    $('mine-g-note').textContent = guestNote(n);
    renderMine();
    scheduleGuestUpdate(n);
  });
  function scheduleGuestUpdate(n) {
    if (guestUpdateTimer) clearTimeout(guestUpdateTimer);
    guestUpdateTimer = setTimeout(function () {
      fetch('/api/potlucks/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: minePrimary.id, signup_token: mineToken, guest_count: n }),
      }).catch(function () {});
    }, 600);
  }

  // Edit / remove buttons on dish items (event delegation)
  $('mine-list').addEventListener('click', function (e) {
    var btn = e.target.closest('button[data-act]');
    if (!btn) return;
    var row = btn.closest('.pk-mine-item');
    var id = parseInt(row.getAttribute('data-id'));
    var act = btn.getAttribute('data-act');
    var s = mineSignups.filter(function (x) { return x.id === id; })[0];
    if (!s) return;
    if (act === 'remove') {
      if (!confirm('Remove "' + s.dish + '" from your signup?')) return;
      fetch('/api/potlucks/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, signup_token: mineToken, action: 'delete' }),
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.ok) location.reload();
      });
    } else if (act === 'edit') {
      openInlineEdit(row, s);
    }
  });

  function openInlineEdit(row, s) {
    var catOpts = '<option value="">Category…</option>';
    document.querySelectorAll('#mine-add-cat option').forEach(function (o) {
      if (!o.value) return;
      var sel = (o.value === s.dish_category) ? ' selected' : '';
      catOpts += '<option value="' + escHtml(o.value) + '"' + sel + '>' + escHtml(o.value) + '</option>';
    });
    row.classList.remove('pk-mine-item');
    row.className = 'pk-mine-edit';
    row.innerHTML =
      '<select class="pk-select" data-role="cat">' + catOpts + '</select>' +
      '<input type="text" class="pk-input" data-role="dish" value="' + escHtml(s.dish) + '"/>' +
      '<div class="pk-mine-edit-btns">' +
        '<button type="button" class="pk-skip" data-role="cancel">Cancel</button>' +
        '<button type="button" class="pk-save" data-role="save">Save</button>' +
      '</div>';
    var errBox = document.createElement('div');
    errBox.className = 'pk-mine-err';
    errBox.setAttribute('data-role', 'err');
    row.appendChild(errBox);
    row.querySelector('[data-role=cancel]').addEventListener('click', function () { renderMine(); });
    row.querySelector('[data-role=save]').addEventListener('click', function () {
      var newDish = row.querySelector('[data-role=dish]').value.trim();
      var newCat = row.querySelector('[data-role=cat]').value.trim();
      if (!newDish) {
        errBox.textContent = "Tell us what you're bringing.";
        errBox.classList.add('show');
        return;
      }
      var saveBtn = row.querySelector('[data-role=save]');
      saveBtn.disabled = true; saveBtn.textContent = 'Saving…';
      fetch('/api/potlucks/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: s.id, signup_token: mineToken, dish: newDish, dish_category: newCat || s.dish_category }),
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.ok) { location.reload(); return; }
        saveBtn.disabled = false; saveBtn.textContent = 'Save';
        errBox.textContent = data.error === 'slot_full' ? 'That category is full — try another.' : 'Could not save — try again.';
        errBox.classList.add('show');
      })
      .catch(function () {
        saveBtn.disabled = false; saveBtn.textContent = 'Save';
        errBox.textContent = 'Network error — try again.';
        errBox.classList.add('show');
      });
    });
  }

  // Add-item flow
  $('mine-add-toggle').addEventListener('click', function () {
    $('mine-add-form').style.display = 'block';
    $('mine-add').classList.add('open');
    $('mine-add-toggle').style.display = 'none';
  });
  $('mine-add-cancel').addEventListener('click', function () {
    $('mine-add-form').style.display = 'none';
    $('mine-add').classList.remove('open');
    $('mine-add-toggle').style.display = '';
    $('mine-add-err').classList.remove('show');
    $('mine-add-cat').value = '';
    $('mine-add-dish').value = '';
  });
  $('mine-add-save').addEventListener('click', function () {
    var cat = $('mine-add-cat').value.trim();
    var dish = $('mine-add-dish').value.trim();
    if (!cat) {
      $('mine-add-err').textContent = 'Pick a category.';
      $('mine-add-err').classList.add('show');
      return;
    }
    if (!dish) {
      $('mine-add-err').textContent = "Tell us what you're bringing.";
      $('mine-add-err').classList.add('show');
      return;
    }
    var btn = $('mine-add-save');
    btn.disabled = true; btn.textContent = 'Adding…';
    fetch('/api/potlucks/add-item', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        potluck_id: parseInt(String(potluckId)),
        signup_token: mineToken,
        dish: dish, dish_category: cat,
      }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      btn.disabled = false; btn.textContent = 'Add it';
      if (data.ok) { location.reload(); return; }
      $('mine-add-err').textContent = data.error === 'slot_full' ? 'That category just filled up — try another.' : 'Could not add — try again.';
      $('mine-add-err').classList.add('show');
    })
    .catch(function () {
      btn.disabled = false; btn.textContent = 'Add it';
      $('mine-add-err').textContent = 'Network error — try again.';
      $('mine-add-err').classList.add('show');
    });
  });

  // Cancel entire signup
  $('mine-cancel').addEventListener('click', function () {
    if (!minePrimary) return;
    if (!confirm('Cancel your entire signup? This removes all your items.')) return;
    fetch('/api/potlucks/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: minePrimary.id, signup_token: mineToken, action: 'delete' }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.ok) {
        clearToken();
        location.reload();
      }
    });
  });

  // On mount: if we have a stored token, try to show the mine card.
  loadMine();

  // ── RSVP lookup ──────────────────────────────────────
  $('m-lookup-btn').addEventListener('click', function () {
    var input = val('m-lookup');
    if (!input) {
      $('m-lookup-err').textContent = 'Enter your name or email.';
      $('m-lookup-err').classList.add('show');
      return;
    }
    $('m-lookup-err').classList.remove('show');
    var btn = $('m-lookup-btn');
    btn.disabled = true;
    btn.textContent = 'Looking up…';

    var isEmail = input.indexOf('@') > -1;
    var body = { potluckId: String(potluckId) };
    if (isEmail) body.email = input;
    else body.name = input;

    fetch('/api/potluck-lookup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
    .then(function (res) { return res.json(); })
    .then(function (data) {
      btn.disabled = false;
      btn.textContent = 'Find my RSVP';
      if (data.ok && data.token) {
        window.location.href = '/potlucks/edit?token=' + data.token;
      } else {
        $('m-lookup-err').textContent = data.error || 'Not found. Check your name or email.';
        $('m-lookup-err').classList.add('show');
      }
    })
    .catch(function () {
      btn.disabled = false;
      btn.textContent = 'Find my RSVP';
      $('m-lookup-err').textContent = 'Network problem — try again.';
      $('m-lookup-err').classList.add('show');
    });
  });
})();
</script>
</Base>
