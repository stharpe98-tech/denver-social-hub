---
import Base from '../../layouts/Base.astro';
---
<Base title="Host a potluck" description="Spin up a potluck sign-up sheet in 60 seconds. Anyone can host.">
<div class="pn">
  <header class="pn-hero">
    <div class="pn-emoji">🥗</div>
    <h1>Host a potluck</h1>
    <p>Free, takes a minute. Pick a date and a spot — we'll build the sign-up page so neighbors can claim a dish.</p>
  </header>

  <form class="pn-card" id="potluck-form">
    <div class="pn-field">
      <label>Title <span class="req">*</span></label>
      <input id="p-title" type="text" maxlength="100" placeholder="Cheesman Summer Potluck" required/>
    </div>
    <div class="pn-field two">
      <div>
        <label>Date</label>
        <input id="p-event-date" type="date" min={new Date().toISOString().slice(0,10)}/>
      </div>
      <div>
        <label>Time <span class="opt">(optional)</span></label>
        <input id="p-time" type="text" maxlength="40" placeholder="5–9pm"/>
      </div>
    </div>
    <div class="pn-field">
      <label>Location <span class="req">*</span></label>
      <input id="p-location" type="text" maxlength="80" placeholder="Cheesman Park · south pavilion" required/>
    </div>
    <div class="pn-field">
      <label>Description <span class="opt">(optional)</span></label>
      <textarea id="p-description" rows="3" maxlength="800" placeholder="Bring a dish to share — drinks, dessert, a side, or a main."></textarea>
    </div>
    <button type="submit" class="pn-cta" id="submit-btn">Create the sign-up page →</button>
    <div class="pn-err" id="err"></div>
  </form>

  <p class="pn-foot">Next you'll get a manage page to add suggested dishes (apps, mains, drinks) and share the public sign-up link.</p>
</div>

<script is:inline>
  (function() {
    var form = document.getElementById('potluck-form');
    var errEl = document.getElementById('err');
    function showErr(msg) { errEl.textContent = msg; errEl.classList.add('show'); }
    function clearErr() { errEl.textContent = ''; errEl.classList.remove('show'); }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      clearErr();
      var title = document.getElementById('p-title').value.trim();
      var loc = document.getElementById('p-location').value.trim();
      if (!title) { showErr('Title is required.'); return; }
      if (!loc) { showErr('Location is required.'); return; }
      var dateRaw = document.getElementById('p-event-date').value;
      if (dateRaw) {
        var today = new Date(); today.setHours(0,0,0,0);
        var picked = new Date(dateRaw + 'T12:00:00');
        if (picked < today) { showErr('Date is in the past. Pick today or later.'); return; }
      }
      var btn = document.getElementById('submit-btn');
      var orig = btn.textContent; btn.disabled = true; btn.textContent = 'Creating…';

      // Build a friendly date_label from the date input
      var dateInput = document.getElementById('p-event-date').value;
      var dateLabel = '';
      if (dateInput) {
        try {
          var d = new Date(dateInput + 'T12:00:00');
          var mn = ['January','February','March','April','May','June','July','August','September','October','November','December'];
          dateLabel = mn[d.getMonth()] + ' ' + d.getDate();
        } catch {}
      }

      try {
        // Use the existing 'create' action (status='upcoming') so the new potluck is immediately public.
        var r = await fetch('/api/potlucks', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'create',
            title: title,
            description: document.getElementById('p-description').value.trim(),
            date_label: dateLabel,
            time_label: document.getElementById('p-time').value.trim(),
            location: loc,
            status: 'upcoming',
            event_date: dateInput || null,
          })
        });
        var d = await r.json();
        if (d && d.ok && d.id) {
          window.location.href = '/potlucks/manage/' + d.id;
          return;
        }
        showErr((d && d.error) || 'Could not create the potluck. Try again.');
      } catch (e) {
        showErr('Network hiccup — try again.');
      }
      btn.disabled = false; btn.textContent = orig;
    });
  })();
</script>

<style>
  .pn { background: var(--bg); color: var(--text); }
  .pn-hero {
    text-align: center; color: #fff;
    margin-top: -88px; padding: 104px 24px 56px;
    background-color: #0E8A7D;
    background-image: linear-gradient(140deg, rgba(14,138,125,0.80), rgba(16,30,28,0.88)), url('/tiles/potlucks.jpg');
    background-size: cover; background-position: center;
  }
  @media (max-width: 900px) { .pn-hero { margin-top: 0; padding-top: 30px; } }
  .pn-emoji { font-size: 34px; width: 72px; height: 72px; margin: 0 auto 14px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); border-radius: 50%; }
  .pn-hero h1 { font-family: var(--font-display); font-size: clamp(28px,5vw,44px); font-weight: 800; letter-spacing: -0.02em; color: #fff; margin-bottom: 10px; }
  .pn-hero p { font-size: 16px; color: rgba(255,255,255,0.88); max-width: 480px; margin: 0 auto; line-height: 1.5; }

  .pn-card { max-width: 560px; margin: -28px auto 0; position: relative; z-index: 2; background: #fff; border: 1px solid var(--border); border-radius: 22px; padding: 28px; box-shadow: 0 18px 44px rgba(16,30,28,0.1); }
  .pn-field { margin-bottom: 16px; }
  .pn-field.two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pn-field label { display: block; font-size: 13px; font-weight: 600; color: var(--text-sec); margin-bottom: 6px; }
  .req { color: #DC2626; }
  .opt { color: var(--text-faint); font-weight: 400; }
  .pn-field input, .pn-field textarea { width: 100%; padding: 13px 14px; border-radius: 12px; border: 1.5px solid var(--border); font-size: 15px; background: var(--bg); font-family: inherit; }
  .pn-field input:focus, .pn-field textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
  .pn-cta { width: 100%; padding: 15px; border-radius: 12px; border: none; background: var(--accent); color: #fff; font-family: var(--font-display); font-size: 16px; font-weight: 700; cursor: pointer; margin-top: 8px; box-shadow: 0 8px 20px rgba(14,138,125,0.28); transition: transform 0.15s; }
  .pn-cta:hover { transform: translateY(-1px); }
  .pn-cta:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .pn-err { color: #DC2626; font-size: 13.5px; margin-top: 10px; display: none; }
  .pn-err.show { display: block; }
  .pn-foot { text-align: center; max-width: 480px; margin: 20px auto 80px; font-size: 13.5px; color: var(--text-sec); line-height: 1.5; padding: 0 24px; }
  @media (max-width: 560px) { .pn-card { margin-left: 16px; margin-right: 16px; } .pn-field.two { grid-template-columns: 1fr; } }
</style>
</Base>
