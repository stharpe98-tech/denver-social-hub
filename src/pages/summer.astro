      <a href="#">LoHi Pizza Crawl</a><span class="dot"> · </span>
      <a href="#">Game Night at Joel's</a><span class="dot"> · </span>
      <a href="#">Park Hill Picnic</a><span class="dot"> · </span>
      <a href="#">Sloan's Lake Volleyball</a><span class="dot"> · </span>
      <a href="#">Sunnyside Bike Loop</a><span class="dot"> · </span>
      <a href="#">RiNo Mural Walk</a><span class="dot"> · </span>
