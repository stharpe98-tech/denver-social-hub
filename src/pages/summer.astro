---
// Standalone Astro page — full HTML below mirrors the approved preview.
// Nav is inline; can be extracted to Base.astro in a follow-up refactor.
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Summer in Denver · The Lineup</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@500;600;700;800;900&family=Caveat:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#FFFFFF;--text:#111827;--text-sec:#6B7280;--accent:#7C3AED;--accent2:#3B82F6;--mint:#10B981;--space-3:12px;--space-4:16px;--space-5:24px;--space-6:32px;--space-7:48px;--space-8:64px;--space-9:96px}
*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;background:var(--bg);color:var(--text)}a{color:inherit;text-decoration:none}h1,h2,h3,h4{line-height:1.2}
.site-nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgba(229,231,235,.6)}
.nav-in{max-width:1240px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{font-family:'Outfit',sans-serif;font-weight:800;font-size:18px;letter-spacing:-.02em;color:#7C3AED}
.brand span{color:#9CA3AF;font-weight:400}
.nav-links{display:flex;gap:28px}
.nav-links a{font-size:14px;font-weight:500;color:#374151;transition:color .15s}
.nav-links a:hover{color:#7C3AED}
.nav-right{display:flex;align-items:center;gap:14px}
.nav-right .nstatus{display:none;font-size:12px;color:#6B7280;font-weight:500;align-items:center;gap:6px}
@media(min-width:920px){.nav-right .nstatus{display:inline-flex}}
.nav-right .nstatus .ndot{width:6px;height:6px;border-radius:50%;background:#10B981;box-shadow:0 0 0 0 rgba(16,185,129,.6);animation:dotPulse 2s infinite}
@keyframes dotPulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.6)}70%{box-shadow:0 0 0 8px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
.signin{font-size:14px;font-weight:600;color:#374151}
.signin:hover{color:#7C3AED}
.join{background:#7C3AED;color:#fff;padding:8px 18px;border-radius:999px;font-size:13px;font-weight:600;transition:background .15s}
.join:hover{background:#6D28D9}
@media(max-width:760px){.nav-links{display:none}.signin{display:none}}
.hero{position:relative;min-height:80vh;display:flex;align-items:flex-end;overflow:hidden;background:linear-gradient(180deg,#1a1b2e 0%,#2d1b4e 50%,#7C3AED 100%);color:#fff;padding:48px 24px}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 20% 30%,rgba(59,130,246,.35),transparent 50%),radial-gradient(circle at 80% 60%,rgba(16,185,129,.3),transparent 55%);pointer-events:none}
.hero svg.peaks{position:absolute;bottom:0;left:0;width:100%;height:auto;opacity:.4}
.hero-in{position:relative;max-width:1240px;margin:0 auto;width:100%}
.hero-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11px;letter-spacing:2px;font-weight:700;background:rgba(255,255,255,.12);backdrop-filter:blur(6px);padding:8px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.2);margin-bottom:24px}
.pulse{width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 0 rgba(16,185,129,.6);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.6)}70%{box-shadow:0 0 0 10px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
.hero h1{font-family:'Outfit';font-size:clamp(48px,9vw,120px);font-weight:900;letter-spacing:-.04em;margin-bottom:16px;line-height:1}
.hero h1 .accent{font-family:'Caveat';font-weight:600;font-size:.35em;color:#FFD93D;display:block;letter-spacing:0;transform:rotate(-2deg);margin-top:-8px;margin-left:24px}
.hero p.tag{font-size:20px;font-weight:500;max-width:560px;margin-bottom:32px;color:rgba(255,255,255,.85)}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.btn-hero{background:#FFD93D;color:#111;padding:16px 32px;border-radius:50px;font-weight:800;font-size:15px;transition:transform .15s}
.btn-hero:hover{transform:translateY(-2px)}
.btn-hero-out{background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:16px 32px;border-radius:50px;font-weight:700;font-size:15px;backdrop-filter:blur(6px)}
.lineup{padding:var(--space-9) var(--space-5);background:#0F0F23;color:#fff;text-align:center}
.lineup .section-eyebrow{font-size:11px;letter-spacing:3px;font-weight:800;color:#FFD93D;margin-bottom:var(--space-3)}
.lineup h2{font-family:'Outfit';font-size:clamp(36px,5vw,64px);font-weight:900;margin-bottom:var(--space-7)}
.tier{margin-bottom:var(--space-6)}
.tier-label{font-size:11px;letter-spacing:3px;color:rgba(255,255,255,.5);margin-bottom:var(--space-3);font-weight:700}
.tier-1{font-family:'Outfit';font-size:clamp(40px,6vw,72px);font-weight:900;line-height:1.05}
.tier-1 a{color:#fff;display:inline-block;margin:0 12px}.tier-1 a:hover{color:#FFD93D}
.tier-2{font-family:'Outfit';font-size:clamp(24px,3.5vw,38px);font-weight:800;line-height:1.2;color:rgba(255,255,255,.9)}
.tier-2 a{color:inherit;margin:0 10px}.tier-2 a:hover{color:#FFD93D}
.tier-3{font-size:17px;font-weight:600;line-height:1.7;color:rgba(255,255,255,.75);max-width:880px;margin:0 auto}
.tier-3 a{color:inherit;margin:0 8px}.tier-3 a:hover{color:#FFD93D}
.dot{opacity:.4}.divider{width:60px;height:2px;background:#FFD93D;margin:var(--space-5) auto}
.lineup-cta{margin-top:var(--space-7)}
.btn-yellow{background:#FFD93D;color:#111;padding:16px 32px;border-radius:50px;font-weight:800;font-size:15px;display:inline-block}
.btn-yellow:hover{transform:translateY(-2px)}
.cta-final{padding:var(--space-9) var(--space-5);background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;text-align:center}
.cta-final h2{font-family:'Outfit';font-size:clamp(36px,5vw,64px);font-weight:900;margin-bottom:var(--space-4)}
.cta-final p{font-size:18px;margin-bottom:var(--space-6);opacity:.9}
</style></head><body>

<header class="site-nav"><div class="nav-in">
  <a href="/" class="brand">denver<span>social</span>hub</a>
  <nav class="nav-links">
    <a href="/events">Events</a>
    <a href="/potlucks">Potlucks</a>
    <a href="/community">Community</a>
    <a href="/about">About</a>
    <a href="/host">Host</a>
  </nav>
  <div class="nav-right">
    <span class="nstatus"><span class="ndot"></span>Denver, CO</span>
    <a href="/sign-in" class="signin">Sign in</a>
    <a href="/signup" class="join">Join us</a>
  </div>
</div></header>

<section class="hero">
  <svg class="peaks" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,200 L0,140 L160,60 L320,120 L480,40 L640,100 L800,30 L960,90 L1120,50 L1280,110 L1440,70 L1440,200 Z" fill="rgba(255,255,255,0.08)"/>
    <path d="M0,200 L0,170 L120,100 L280,140 L440,80 L600,130 L760,70 L920,120 L1080,90 L1240,140 L1440,110 L1440,200 Z" fill="rgba(0,0,0,0.2)"/>
  </svg>
  <div class="hero-in">
    <span class="hero-eyebrow"><span class="pulse"></span>SUMMER 2026 · 12 WEEKS · 12+ EVENTS</span>
    <h1>Summer in Denver.<span class="accent">— the whole season, one calendar.</span></h1>
    <p class="tag">Cornwall has a festival, Coachella has a weekend — Denver has a summer. Twelve weeks of hikes, plunges, dinners, potlucks at Cheesman, and more.</p>
    <div class="hero-actions"><a href="#lineup" class="btn-hero">See the lineup ↓</a><a href="#" class="btn-hero-out">Add yours</a></div>
  </div>
</section>

<section class="lineup" id="lineup">
  <div class="section-eyebrow">DENVER SOCIAL PRESENTS</div>
  <h2>The Lineup</h2>
  <div class="tier"><div class="tier-label">— HEADLINERS</div>
    <div class="tier-1"><a href="#">Summer Kickoff Potluck</a><span class="dot"> · </span><a href="#">Sunday Pasta &amp; Cassettes</a></div>
  </div>
  <div class="divider"></div>
  <div class="tier"><div class="tier-label">— THIS &amp; NEXT WEEK</div>
    <div class="tier-2">
      <a href="#">Red Rocks Sunrise Hike</a><span class="dot"> · </span>
