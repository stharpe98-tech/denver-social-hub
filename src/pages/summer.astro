---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';

const db = getDB();
let lineupEvents: any[] = [];
let eventCount = 0;
let upcomingPotluck: any = null;

try {
  if (db) {
    const monthOrder: Record<string, number> = { JAN:0,FEB:1,MAR:2,APR:3,MAY:4,JUN:5,JUL:6,AUG:7,SEP:8,OCT:9,NOV:10,DEC:11 };
    const allEvts = (await db.prepare(
      "SELECT id, title, event_month, event_day FROM events WHERE is_past IS NULL OR is_past = 0 ORDER BY id DESC LIMIT 24"
    ).all())?.results || [];
    lineupEvents = allEvts.sort((a: any, b: any) => {
      const ma = monthOrder[(a.event_month || '').toUpperCase()] ?? 99;
      const mb = monthOrder[(b.event_month || '').toUpperCase()] ?? 99;
      if (ma !== mb) return ma - mb;
      return (parseInt(a.event_day) || 99) - (parseInt(b.event_day) || 99);
    });
    const ec = await db.prepare("SELECT COUNT(*) as cnt FROM events WHERE is_past IS NULL OR is_past=0").first();
    eventCount = ec?.cnt || 0;
    upcomingPotluck = await db.prepare("SELECT id, slug, title FROM potlucks WHERE status='upcoming' ORDER BY id DESC LIMIT 1").first();
  }
} catch {}

const eventHref = (ev: any) => `/events/${ev.id}`;
const potluckHref = upcomingPotluck
  ? (upcomingPotluck.slug ? `/${upcomingPotluck.slug}` : `/potlucks/${upcomingPotluck.id}`)
  : '/potlucks';

const headliner = lineupEvents[0] || null;
const tierThisWeek = lineupEvents.slice(1, 9);
const tierAlso = lineupEvents.slice(9);
---
<Base title="Summer in Denver" description="The whole season on one calendar — hikes, plunges, dinners, potlucks at Cheesman.">
<div class="festival">

  <section class="hero">
    <svg class="peaks" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,200 L0,140 L160,60 L320,120 L480,40 L640,100 L800,30 L960,90 L1120,50 L1280,110 L1440,70 L1440,200 Z" fill="rgba(255,255,255,0.08)"/>
      <path d="M0,200 L0,170 L120,100 L280,140 L440,80 L600,130 L760,70 L920,120 L1080,90 L1240,140 L1440,110 L1440,200 Z" fill="rgba(0,0,0,0.2)"/>
    </svg>
    <div class="hero-in">
      <span class="hero-eyebrow"><span class="pulse"></span>SUMMER 2026 · {eventCount || '12'}+ EVENTS ON THE CALENDAR</span>
      <h1>Summer in Denver.<span class="accent">— the whole season, one calendar.</span></h1>
      <p class="tag">Coachella has a weekend — Denver has a summer. Weeks of hikes, plunges, dinners, and potlucks at Cheesman. Here's what's actually on.</p>
      <div class="hero-actions"><a href="#lineup" class="btn-hero">See the lineup ↓</a><a href="/events/new" class="btn-hero-out">Add yours</a></div>
    </div>
  </section>

  {headliner ? (
    <section class="lineup" id="lineup">
      <div class="section-eyebrow">DENVER SOCIAL PRESENTS</div>
      <h2>The Lineup</h2>
      <div class="tier"><div class="tier-label">— HEADLINERS</div>
        <div class="tier-1">
          {upcomingPotluck && (<><a href={potluckHref}>{upcomingPotluck.title}</a><span class="dot"> · </span></>)}
          <a href={eventHref(headliner)}>{headliner.title}</a>
        </div>
      </div>
      {tierThisWeek.length > 0 && (<>
        <div class="divider"></div>
        <div class="tier"><div class="tier-label">— THIS &amp; NEXT WEEK</div>
          <div class="tier-2">{tierThisWeek.map((ev: any, i: number) => (<>{i > 0 && <span class="dot"> · </span>}<a href={eventHref(ev)}>{ev.title}</a></>))}</div>
        </div>
      </>)}
      {tierAlso.length > 0 && (<>
        <div class="divider"></div>
        <div class="tier"><div class="tier-label">— ALSO ON THE CALENDAR</div>
          <div class="tier-3">{tierAlso.map((ev: any, i: number) => (<>{i > 0 && <span class="dot"> · </span>}<a href={eventHref(ev)}>{ev.title}</a></>))}</div>
        </div>
      </>)}
      <div class="lineup-cta"><a href="/events" class="btn-yellow">Full calendar →</a></div>
    </section>
  ) : (
    <section class="lineup" id="lineup">
      <div class="section-eyebrow">DENVER SOCIAL PRESENTS</div>
      <h2>The Lineup</h2>
      <p class="tier-3">Nothing on the calendar just yet — <a href="/events/new">add the first summer event →</a></p>
    </section>
  )}

  <section class="cta-final">
    <h2>See you out there.</h2>
    <p>Pick one event this week. That's the only ask.</p>
    <a href="/events" class="btn-yellow">Browse events →</a>
  </section>

</div>

<style>
  .festival{--accent:#7C3AED;--mint:#10B981;font-family:'Inter','Work Sans',system-ui,sans-serif;color:#111827;background:#fff}
  .festival a{color:inherit;text-decoration:none}
  .hero{position:relative;min-height:60vh;display:flex;align-items:flex-end;overflow:hidden;background:linear-gradient(180deg,#1a1b2e 0%,#2d1b4e 50%,#7C3AED 100%);color:#fff;padding:48px 24px}
  .hero::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 20% 30%,rgba(59,130,246,.35),transparent 50%),radial-gradient(circle at 80% 60%,rgba(16,185,129,.3),transparent 55%);pointer-events:none}
  .hero .peaks{position:absolute;bottom:0;left:0;width:100%;height:auto;opacity:.4}
  .hero-in{position:relative;max-width:1240px;margin:0 auto;width:100%}
  .hero-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11px;letter-spacing:2px;font-weight:700;background:rgba(255,255,255,.12);padding:8px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.2);margin-bottom:24px}
  .pulse{width:8px;height:8px;border-radius:50%;background:var(--mint);animation:pulse 2s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.6)}70%{box-shadow:0 0 0 10px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
  .hero h1{font-family:'Outfit';font-size:clamp(44px,9vw,108px);font-weight:900;letter-spacing:-.04em;margin-bottom:16px;line-height:1;color:#fff}
  .hero h1 .accent{font-family:'Caveat';font-weight:600;font-size:.4em;color:#FFD93D;display:block;transform:rotate(-2deg);margin-top:-8px;margin-left:24px}
  .hero p.tag{font-size:20px;font-weight:500;max-width:560px;margin-bottom:32px;color:rgba(255,255,255,.85)}
  .hero-actions{display:flex;gap:12px;flex-wrap:wrap}
  .btn-hero{background:#FFD93D;color:#111;padding:16px 32px;border-radius:50px;font-weight:800;font-size:15px;letter-spacing:.5px}
  .btn-hero-out{background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:16px 32px;border-radius:50px;font-weight:700;font-size:15px}
  .lineup{padding:var(--space-9) var(--space-5);background:#0F0F23;color:#fff;text-align:center}
  .section-eyebrow{display:block;font-size:11px;letter-spacing:3px;font-weight:800;color:#FFD93D;margin-bottom:var(--space-3)}
  .lineup h2{font-family:'Outfit';font-size:clamp(36px,5vw,64px);font-weight:900;margin-bottom:var(--space-7);letter-spacing:-.02em;color:#fff}
  .tier{margin-bottom:var(--space-6)}
  .tier-label{font-size:11px;letter-spacing:3px;color:rgba(255,255,255,.5);margin-bottom:var(--space-3);font-weight:700}
  .tier-1{font-family:'Outfit';font-size:clamp(34px,6vw,72px);font-weight:900;line-height:1.05;letter-spacing:-.02em}
  .tier-1 a{color:#fff;display:inline-block;margin:0 12px}
  .tier-2{font-family:'Outfit';font-size:clamp(22px,3.5vw,38px);font-weight:800;line-height:1.2;color:rgba(255,255,255,.9)}
  .tier-2 a{display:inline-block;margin:0 10px}
  .tier-3{font-size:17px;font-weight:600;line-height:1.7;color:rgba(255,255,255,.75);max-width:880px;margin:0 auto}
  .tier-3 a{display:inline-block;margin:0 8px;color:#FFD93D}
  .dot{opacity:.4}.divider{width:60px;height:2px;background:#FFD93D;margin:var(--space-5) auto}
  .lineup-cta{margin-top:var(--space-7)}
  .btn-yellow{background:#FFD93D;color:#111;padding:16px 32px;border-radius:50px;font-weight:800;font-size:15px;display:inline-block}
  .cta-final{padding:var(--space-9) var(--space-5);background:linear-gradient(135deg,#7C3AED,#3B82F6);color:#fff;text-align:center}
  .cta-final h2{font-family:'Outfit';font-size:clamp(36px,5vw,64px);font-weight:900;margin-bottom:var(--space-4);color:#fff}
  .cta-final p{font-size:18px;margin-bottom:var(--space-6);opacity:.9}
  @media (max-width:680px){.hero{min-height:52vh;padding:32px 16px}.lineup,.cta-final{padding-left:16px;padding-right:16px}}
</style>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&display=swap" />
</Base>
