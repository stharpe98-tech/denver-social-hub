---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';

const db = getDB();
let events: any[] = [];
try {
  if (db) {
    const monthOrder: Record<string, number> = { JAN:0,FEB:1,MAR:2,APR:3,MAY:4,JUN:5,JUL:6,AUG:7,SEP:8,OCT:9,NOV:10,DEC:11 };
    const all = (await db.prepare("SELECT * FROM events WHERE is_past IS NULL OR is_past=0 ORDER BY id DESC LIMIT 18").all())?.results || [];
    events = all.sort((a: any, b: any) => {
      const ma = monthOrder[(a.event_month || '').toUpperCase()] ?? 99;
      const mb = monthOrder[(b.event_month || '').toUpperCase()] ?? 99;
      if (ma !== mb) return ma - mb;
      return (parseInt(a.event_day) || 99) - (parseInt(b.event_day) || 99);
    });
  }
} catch {}
const typeLabel: Record<string, string> = {
  dinner: '🍽 Dinner', game_night: '🎲 Game night', outdoor: '🌲 Outdoors', brewery: '🍺 Brewery',
  coffee: '☕ Coffee', arts: '🎨 Arts', music: '🎵 Music', social: '🥂 Social',
  group_tickets: '🎟 Tickets', camping: '🏕 Camping', sports_outing: '⚾ Sports',
  bowling: '🎳 Bowling', active: '🏃 Active', casino: '🎰 Casino', food_trucks: '🌮 Food', other: '✨ Event',
};
const catColor: Record<string, [string, string]> = {
  dinner: ['#FEEDE8','#C2410C'], game_night: ['#F1ECFF','#6D28D9'], outdoor: ['#E6F8EC','#15803D'],
  coffee: ['#FEF3E2','#B45309'], arts: ['#FCE7F3','#9D174D'], social: ['#E5F8F6','#0E7490'],
};
const pill = (t: string) => catColor[t] || ['#FEEDE8','#C2410C'];
---
<Base title="Summer in Denver" description="The whole season on one calendar — dinners, terrace hangs, hikes, big potlucks.">
<div class="summer">
  <header class="hero"><div class="wrap">
    <div class="k">Summer 2026 · Denver</div>
    <h1>Summer in Denver, <em>one calendar.</em></h1>
    <p>Dinners, sky-terrace sunsets, hikes, bar nights, and big potlucks at Cheesman. Here's what's actually on.</p>
    <a class="btn" href="/events/new">+ Add your own</a>
  </div></header>

  <section class="wrap list">
    {events.length > 0 ? (
      <div class="cards">
        {events.map((ev: any) => (
          <a class="card" href={`/events/${ev.id}`}>
            <div class="card-top">
              <div class="date"><span class="m">{ev.event_month}</span><span class="d">{ev.event_day}</span></div>
              <span class="cat" style={`background:${pill(ev.event_type)[0]};color:${pill(ev.event_type)[1]}`}>{typeLabel[ev.event_type] || '✨ Event'}</span>
            </div>
            <h3>{ev.title}</h3>
            <div class="meta">{ev.zone || ev.location || 'Denver'}</div>
            <div class="foot"><span>{ev.rsvp_count || 0} going</span><span class="rsvp">RSVP</span></div>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty">Nothing on the calendar yet — <a href="/events/new">add the first summer event →</a></p>
    )}
  </section>
</div>

<style>
  .summer{background:var(--bg);color:var(--text)}
  .summer .wrap{max-width:1120px;margin:0 auto;padding:0 24px}
  .summer a{text-decoration:none}
  .hero{text-align:center;padding:64px 0 36px}
  .hero .k{font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:12px}
  .hero h1{font-family:var(--font-display);font-size:clamp(34px,5.5vw,58px);font-weight:800;letter-spacing:-.02em;margin-bottom:14px}
  .hero h1 em{font-style:normal;color:var(--accent)}
  .hero p{color:var(--text-sec);font-size:18px;max-width:540px;margin:0 auto 24px}
  .btn{display:inline-block;background:var(--accent);color:#fff;font-weight:700;padding:13px 26px;border-radius:999px;box-shadow:0 8px 22px rgba(240,87,61,.3)}
  .list{padding:16px 0 80px}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .card{background:#fff;border:1px solid var(--border);border-radius:18px;padding:18px;transition:transform .15s,box-shadow .15s}
  .card:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(0,0,0,.07)}
  .card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
  .date{display:flex;flex-direction:column;align-items:center;background:var(--accent-soft);border-radius:12px;padding:8px 12px;line-height:1;min-width:52px}
  .date .m{font-size:11px;font-weight:700;color:var(--accent);text-transform:uppercase}
  .date .d{font-family:var(--font-display);font-size:20px;font-weight:800}
  .cat{font-size:12px;font-weight:700;padding:5px 11px;border-radius:999px;white-space:nowrap}
  .card h3{font-family:var(--font-display);font-size:18px;font-weight:700;margin-bottom:6px}
  .card .meta{font-size:14px;color:var(--text-sec);margin-bottom:14px}
  .card .foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border);padding-top:12px;font-size:13px;color:var(--text-sec)}
  .rsvp{background:var(--text);color:#fff;font-weight:600;padding:8px 16px;border-radius:999px}
  .empty{text-align:center;color:var(--text-sec);font-size:18px;padding:40px 0}.empty a{color:var(--accent);font-weight:600}
  @media(max-width:820px){.cards{grid-template-columns:1fr 1fr}}@media(max-width:540px){.cards{grid-template-columns:1fr}}
</style>
</Base>
