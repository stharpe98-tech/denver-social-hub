---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Get in touch with Denver Social.">
  <div class="canvas">
    <div class="hp">
      <header class="hp-h">
        <p class="kicker">Contact · Direct line to Seth</p>
        <h1>Say <span class="amp">&amp;</span> hi.</h1>
        <p class="lede">Question, idea, business inquiry, or just want to say hi? This goes straight to Seth's inbox. Replies usually land within a day or two.</p>
      </header>

      <form id="contact-form" class="ct-form">
        <div class="ct-field">
          <label for="ct-name">Your name <span class="req">*</span></label>
          <input type="text" id="ct-name" class="ct-input" placeholder="Sarah" required />
        </div>
        <div class="ct-field">
          <label for="ct-email">Email <span class="opt">(include if you want a reply)</span></label>
          <input type="email" id="ct-email" class="ct-input" placeholder="you@example.com" />
        </div>
        <div class="ct-field">
          <label for="ct-subject">Subject</label>
          <input type="text" id="ct-subject" class="ct-input" placeholder="What's this about?" />
        </div>
        <div class="ct-field">
          <label for="ct-message">Message <span class="req">*</span></label>
          <textarea id="ct-message" class="ct-input ct-textarea" rows="5" placeholder="Tell us what's on your mind…" required></textarea>
          <span class="ct-charcount"><span id="ct-chars">0</span>/2000</span>
        </div>
        <button type="submit" class="ct-submit">Send message →</button>
        <div class="ct-error" id="ct-err"></div>
      </form>

      <div class="ct-success" id="ct-ok">
        <h2>Got it.</h2>
        <p>Thanks for reaching out. If you included your email, we'll get back to you soon.</p>
        <a href="/" class="hp-cta">Back home →</a>
      </div>

      <footer class="hp-foot">
        <p>Prefer real-time? Join our <a href="https://discord.gg/S8SFNkdSgK" target="_blank" rel="noopener">Discord</a>.</p>
      </footer>
    </div>
  </div>

  <style>
    .canvas { background: var(--bg); min-height: 100vh; }

    .hp {
      max-width: 760px; margin: 0 auto;
      padding: 56px clamp(20px, 5vw, 32px) 96px;
      color: var(--text);
    }

    .hp-h { margin-bottom: 32px; }
    .kicker {
      font-family: var(--font);
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--text-sec); margin-bottom: 16px;
    }
    .hp-h h1 {
      font-family: var(--font-display);
      font-size: clamp(44px, 7vw, 64px); font-weight: 800;
      letter-spacing: -0.035em; line-height: 1.02;
      margin-bottom: 18px; color: var(--text);
    }
    .hp-h h1 em { font-style: italic; font-weight: 500; color: var(--accent); }
    .hp-h h1 .amp {
      font-family: var(--font);
      font-style: italic; font-weight: 300;
      color: var(--text-faint); padding: 0 0.08em;
    }
    .lede {
      font-size: 18px; line-height: 1.55;
      color: var(--text-sec); max-width: 56ch;
      margin-bottom: 14px;
    }
    .hp-cta {
      display: inline-flex; align-items: center;
      font-family: var(--font);
      font-size: 13px; font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--accent); text-decoration: underline;
      text-underline-offset: 5px; text-decoration-thickness: 1px;
      transition: color 280ms cubic-bezier(0.16,1,0.3,1);
    }
    .hp-cta:hover { color: var(--accent); }

    /* Form — editorial-styled fields on cream canvas */
    .ct-form {
      display: flex; flex-direction: column; gap: 18px;
      padding: 24px clamp(20px, 4vw, 28px);
      background: rgba(255,255,255,0.55);
      border: 1px solid var(--border);
      border-radius: 22px;
      margin-top: 24px;
    }
    .ct-field { display: flex; flex-direction: column; gap: 8px; }
    .ct-field label {
      font-family: var(--font);
      font-size: 11px; font-weight: 500;
      color: var(--text-sec); text-transform: uppercase; letter-spacing: 0.14em;
    }
    .req { color: var(--accent); font-weight: 500; text-transform: none; letter-spacing: 0; }
    .opt { color: var(--text-faint); font-weight: 500; text-transform: none; letter-spacing: 0; }
    .ct-input {
      width: 100%; padding: 12px 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      font-size: 15px; color: var(--text);
      font-family: var(--font);
      -webkit-appearance: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .ct-input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-dim);
    }
    .ct-textarea { resize: vertical; min-height: 120px; line-height: 1.55; }
    .ct-charcount { font-size: 11px; color: var(--text-faint); text-align: right; font-family: var(--font); }

    .ct-submit {
      padding: 14px; border-radius: 999px; border: none;
      background: var(--text); color: var(--bg);
      font-family: var(--font);
      font-size: 15px; font-weight: 600;
      cursor: pointer; margin-top: 4px;
      transition: transform 0.15s, background 0.15s, box-shadow 0.15s;
    }
    .ct-submit:hover { background: var(--accent); transform: translateY(-1px); box-shadow: 0 8px 24px -8px var(--cta-glow); }
    .ct-submit:active { transform: translateY(0); }
    .ct-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

    .ct-error {
      display: none;
      background: #FEF2F2; border: 1px solid #FCA5A5;
      border-radius: 12px; padding: 12px 16px;
      color: #991B1B; font-size: 14px;
    }
    .ct-error.show { display: block; }

    .ct-success {
      display: none; text-align: center;
      padding: 36px clamp(20px, 4vw, 36px);
      border-radius: 22px;
      background: var(--surface);
      border: 1px solid var(--border);
      margin-top: 24px;
    }
    .ct-success.show { display: block; }
    .ct-success h2 {
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 36px); font-weight: 800;
      letter-spacing: -0.025em; color: var(--text); margin: 0 0 10px;
    }
    .ct-success p { font-size: 15px; color: var(--text-sec); line-height: 1.6; max-width: 380px; margin: 0 auto 18px; }

    .hp-foot {
      margin-top: 64px; padding-top: 28px;
      border-top: 1px solid var(--border);
      font-size: 14px; color: var(--text-sec); text-align: center;
    }
    .hp-foot a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
    .hp-foot a:hover { color: var(--accent); }
  </style>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const msgField = document.getElementById('ct-message');
    const charSpan = document.getElementById('ct-chars');

    msgField.addEventListener('input', () => {
      charSpan.textContent = msgField.value.length;
      charSpan.style.color = msgField.value.length > 2000 ? '#DC2626' : '';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const errEl = document.getElementById('ct-err');
      errEl.classList.remove('show');
      btn.disabled = true;
      const orig = btn.textContent;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: document.getElementById('ct-name').value.trim(),
            email: document.getElementById('ct-email').value.trim(),
            subject: document.getElementById('ct-subject').value.trim(),
            message: msgField.value.trim(),
          }),
        });
        const data = await res.json();
        if (data.ok) {
          form.style.display = 'none';
          document.getElementById('ct-ok').classList.add('show');
        } else {
          errEl.textContent = data.error || 'Something went wrong.';
          errEl.classList.add('show');
          btn.disabled = false;
          btn.textContent = orig;
        }
      } catch {
        errEl.textContent = 'Network error — try again.';
        errEl.classList.add('show');
        btn.disabled = false;
        btn.textContent = orig;
      }
    });
  </script>
</Base>
