---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';
import { ensureCommunitySchema, BOARD_KINDS } from '../lib/community-schema';
import { ensureGroupsSchema } from '../lib/groups-schema';
import {
  NEIGHBORHOODS, resolveNeighborhoodSlug, getNeighborhood,
  nearbyNeighborhoods, milesBetween, neighborhoodsByCity,
} from '../lib/neighborhoods';

const db = getDB();
// Accounts are offline; no logged-in viewer concept on this page.
const user: any = null;

const validTabs = new Set(['favors', 'groups']);
const rawTab = (Astro.url.searchParams.get('tab') || 'favors').toLowerCase();
const tab = validTabs.has(rawTab) ? rawTab : 'favors';

const filter = Astro.url.searchParams.get('kind') || 'all';
const nbhSlug = resolveNeighborhoodSlug(Astro.url.searchParams.get('nbh'));
const currentNbh = getNeighborhood(nbhSlug);
const nearby = currentNbh ? nearbyNeighborhoods(nbhSlug, 5, 5) : [];

let favors: any[] = [];
let nearbyFavors: any[] = [];
let people: any[] = [];
let totalFlyers = 0;
let totalNeighbors = 0;
let thisWeek = 0;
const myGroups: any[] = [];
let discoverGroups: any[] = [];
const conversations: any[] = [];

if (db) {
  if (tab === 'favors') {
    await ensureCommunitySchema(db);
    // Local flyers
    {
      let sql = "SELECT * FROM favors WHERE status='open'";
      const binds: any[] = [];
      if (nbhSlug !== 'all') { sql += " AND LOWER(neighborhood)=?"; binds.push(nbhSlug); }
      if (filter === 'offer' || filter === 'need') {
        sql += " AND COALESCE(NULLIF(kind_extended,''), kind)=?";
        binds.push(filter);
      } else if (filter === 'event' || filter === 'announce' || filter === 'just_because') {
        sql += " AND kind_extended=?";
        binds.push(filter);
      }
      sql += ' ORDER BY id DESC LIMIT 60';
      const r = await db.prepare(sql).bind(...binds).all();
      favors = (r.results || []) as any[];
    }
    // Nearby flyers (other neighborhoods within ~5mi) — slot in after locals
    if (nbhSlug !== 'all' && nearby.length > 0 && filter === 'all') {
      const slugs = nearby.map(n => n.slug);
      const placeholders = slugs.map(() => '?').join(',');
      const r = await db.prepare(
        `SELECT * FROM favors WHERE status='open' AND LOWER(neighborhood) IN (${placeholders})
         ORDER BY id DESC LIMIT 12`
      ).bind(...slugs).all();
      nearbyFavors = (r.results || []) as any[];
    }
    // People — pull profiles tagged to this neighborhood. The columns
    // referenced (slug/display_name/photo_emoji/headline/status) may not
    // exist on every deploy; wrap in try/catch.
    if (nbhSlug !== 'all') {
      try {
        const r = await db.prepare(
          `SELECT slug, display_name, headline, photo_emoji, neighborhood
           FROM profiles WHERE LOWER(neighborhood)=? AND status='live' AND tier='organizer'
           ORDER BY updated_at DESC LIMIT 4`
        ).bind(nbhSlug).all();
        people = (r.results || []) as any[];
      } catch { people = []; }
    }
    // Stats
    try {
      const c1: any = await db.prepare(
        nbhSlug === 'all'
          ? "SELECT COUNT(*) AS c FROM favors WHERE status='open'"
          : "SELECT COUNT(*) AS c FROM favors WHERE status='open' AND LOWER(neighborhood)=?"
      ).bind(...(nbhSlug === 'all' ? [] : [nbhSlug])).first();
      totalFlyers = c1?.c || 0;
      const c2: any = await db.prepare(
        nbhSlug === 'all'
          ? "SELECT COUNT(DISTINCT member_email) AS c FROM favors"
          : "SELECT COUNT(DISTINCT member_email) AS c FROM favors WHERE LOWER(neighborhood)=?"
      ).bind(...(nbhSlug === 'all' ? [] : [nbhSlug])).first();
      totalNeighbors = c2?.c || 0;
      const c3: any = await db.prepare(
        nbhSlug === 'all'
          ? "SELECT COUNT(*) AS c FROM favors WHERE status='open' AND created_at > datetime('now', '-7 days')"
          : "SELECT COUNT(*) AS c FROM favors WHERE status='open' AND LOWER(neighborhood)=? AND created_at > datetime('now', '-7 days')"
      ).bind(...(nbhSlug === 'all' ? [] : [nbhSlug])).first();
      thisWeek = c3?.c || 0;
    } catch {}
  } else if (tab === 'groups') {
    await ensureGroupsSchema(db);
    const discover = await db.prepare(`
      SELECT g.*
      FROM groups g
      WHERE g.privacy = 'public'
      ORDER BY g.member_count DESC, g.id DESC
      LIMIT 24
    `).all();
    discoverGroups = (discover.results || []) as any[];
  }
}

const totalUnread = 0;

function otherName(c: any): string {
  return c.other_name
    || (c.member_a_email?.toLowerCase() === (user?.email || '').toLowerCase()
        ? (c.member_b_email || '').split('@')[0]
        : (c.member_a_email || '').split('@')[0])
    || 'Member';
}

// Mix nearby flyers in with locals at every Nth slot so the feed
// reads as one board, not two sections stacked.
function buildBoardItems(locals: any[], nearbyList: any[], peopleList: any[]) {
  const out: Array<{ type: 'flyer' | 'person'; data: any; nearby?: boolean }> = [];
  const flyers: Array<{ data: any; nearby?: boolean }> = [
    ...locals.map(f => ({ data: f })),
    ...nearbyList.map(f => ({ data: f, nearby: true })),
  ];
  // Sort by id desc so newest still leads
  flyers.sort((a, b) => (b.data.id || 0) - (a.data.id || 0));
  let pIdx = 0;
  for (let i = 0; i < flyers.length; i++) {
    out.push({ type: 'flyer', data: flyers[i].data, nearby: flyers[i].nearby });
    // Sprinkle a person every 4 flyers (not at top)
    if (pIdx < peopleList.length && i > 0 && (i + 1) % 4 === 0) {
      out.push({ type: 'person', data: peopleList[pIdx++] });
    }
  }
  // Append leftover people at the end
  while (pIdx < peopleList.length) out.push({ type: 'person', data: peopleList[pIdx++] });
  return out;
}

function flyerKindInfo(f: any) {
  const k = (f.kind_extended || f.kind || 'offer');
  return BOARD_KINDS.find(x => x.key === k) || BOARD_KINDS[1];
}

function kindColor(dot: string): string {
  return ({
    need: '#DC2626', offer: '#047857', event: '#0E8A7D',
    announce: '#E8902A', person: '#7A53B0',
  } as Record<string, string>)[dot] || '#0E8A7D';
}

function distanceFromHere(slug: string): string {
  if (!currentNbh || !slug) return '';
  const n = getNeighborhood(slug);
  if (!n) return '';
  const mi = milesBetween(currentNbh, n);
  return mi >= 0.1 ? `${mi.toFixed(1)} mi` : '';
}

function timeAgo(iso: string): string {
  if (!iso) return '';
  const ms = Date.now() - new Date((iso || '').includes('Z') ? iso : iso + 'Z').getTime();
  if (Number.isNaN(ms) || ms < 0) return '';
  const s = Math.floor(ms / 1000);
  if (s < 60) return 'just now';
  const m = Math.floor(s / 60);
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  return d < 30 ? `${d}d ago` : new Date(iso).toLocaleDateString();
}
---
<Base title="Community Board" description="A flyer wall for your block. Find what's happening, offer something, ask for help.">
<!-- Full-bleed teal mesh hero -->
<section class="cm-hero">
  <div class="cm-hero-inner">
    <div class="cm-kicker">Denver · neighborhood by neighborhood</div>
    <h1 class="cm-h1">A flyer wall for your <span class="hl">block.</span></h1>
    <p class="cm-sub">Find what's happening on your street. Offer something. Ask for a hand. No algorithm, no ads.</p>
    <form class="cm-picker" method="get" action="/community">
      <input type="hidden" name="tab" value="favors" />
      <span class="cm-picker-pin">📍</span>
      <select name="nbh" class="cm-picker-select" onchange="this.form.submit()">
        <option value="all" selected={nbhSlug === 'all'}>All Denver Metro</option>
        {neighborhoodsByCity().map(group => (
          <optgroup label={group.label}>
            {group.items.map(n => (
              <option value={n.slug} selected={n.slug === nbhSlug}>{n.label}</option>
            ))}
          </optgroup>
        ))}
      </select>
    </form>
    {nearby.length > 0 && (
      <div class="cm-nearby">
        <span class="cm-nearby-label">Nearby:</span>
        {nearby.map(n => (<a href={`/community?nbh=${n.slug}`}>{n.label}</a>))}
        <a href="/community?nbh=all">see all {NEIGHBORHOODS.length} →</a>
      </div>
    )}
  </div>
</section>

<div class="cb-wrap">

  <nav class="cb-tabs-strip" aria-label="Community sections">
    <a href="/community" class="cb-tab-link cb-tab-link-on">📌 Flyers</a>
    <a href="/community/businesses" class="cb-tab-link">🛠️ Services</a>
    <a href="/groups" class="cb-tab-link">👥 Groups</a>
  </nav>

  {true && (
    <div class="board-wrap">
      <section class="bd-board-bg">
        <div class="bd-toolbar">
          <span class="bd-toolbar-label">{currentNbh?.label || 'All Metro'} ·</span>
          {[
            { k: 'all',      l: 'All' },
            { k: 'offer',    l: '🤝 Offers' },
            { k: 'need',     l: '🙏 Needs' },
            { k: 'event',    l: '🎉 Events' },
            { k: 'announce', l: '📣 Announce' },
          ].map(f => (
            <a href={`/community?nbh=${nbhSlug}&kind=${f.k}`}
               class:list={['bd-filter', { on: filter === f.k }]}>{f.l}</a>
          ))}
          <input class="bd-search" id="bd-search" placeholder="Search board…" />
          <a href={`/community/post/new?nbh=${nbhSlug}`} class="bd-post">+ Pin a flyer</a>
        </div>

        {(favors.length + nearbyFavors.length + people.length) === 0 ? (
          <div class="bd-empty">
            <p>📌 Nothing pinned to {currentNbh?.label || 'this board'} yet.</p>
            <p style="font-size:13px;color:var(--text-faint);margin-top:6px">Be the first to offer something, ask for a hand, or share what's happening on your street.</p>
            <a href={`/community/post/new?nbh=${nbhSlug}`} class="bd-post" style="margin-top:14px">+ Pin the first flyer</a>
          </div>
        ) : (
          <div class="bd-board">
            {buildBoardItems(favors, nearbyFavors, people).map(item => {
              if (item.type === 'person') {
                const p = item.data;
                return (
                  <a href={`/u/${p.slug}`} class="flyer flyer-person" style="--k:#7A53B0">
                    <div class="flyer-nbh">📍 {getNeighborhood(p.neighborhood)?.label || currentNbh?.label || 'Denver'}</div>
                    <div class="person-row">
                      <div class="person-avatar">{p.photo_emoji || '👤'}</div>
                      <div>
                        <div class="person-name">{p.display_name}</div>
                        {p.headline && <div class="person-role">{p.headline}</div>}
                      </div>
                    </div>
                    <div class="flyer-cta">See {String(p.display_name || '').split(' ')[0]}'s page →</div>
                  </a>
                );
              }
              const f = item.data;
              const ki = flyerKindInfo(f);
              const dist = item.nearby ? distanceFromHere(f.neighborhood) : '';
              const nbhInfo = getNeighborhood(f.neighborhood);
              return (
                <a href={`/community/post/${f.id}`} class="flyer" style={`--k:${kindColor(ki.dot)}`}>
                  <div class:list={['flyer-nbh', { far: item.nearby }]}>
                    📍 {nbhInfo?.label || f.neighborhood || 'Denver'}{dist ? ` · ${dist}` : ''}
                  </div>
                  <div class="flyer-kind">
                    <span class="dot"></span>{ki.emoji} {ki.label}
                  </div>
                  <div class="flyer-title">{f.title}</div>
                  {f.body && <div class="flyer-body">{f.body}</div>}
                  <div class="flyer-meta">
                    <span class="flyer-author">{f.member_name || 'A neighbor'}</span>
                    <span>{timeAgo(f.created_at)}</span>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </section>
    </div>
  )}

</div>

<style>
  .cb-wrap { max-width: 1080px; margin: 0 auto; padding: 28px clamp(16px, 4vw, 40px) 80px; }

  /* Full-bleed teal mesh hero */
  .cm-hero {
    margin-top: -88px; padding: 118px var(--space-4) var(--space-6);
    text-align: center; color: #fff; position: relative; overflow: hidden;
    background-color: #0C6E63;
    background-image:
      radial-gradient(circle at 15% 18%, rgba(21,128,61,0.95), transparent 42%),
      radial-gradient(circle at 85% 12%, rgba(122,83,176,0.9), transparent 44%),
      radial-gradient(circle at 80% 95%, rgba(232,144,42,0.8), transparent 40%),
      linear-gradient(135deg, #0E8A7D, #0B5C54);
  }
  @media (max-width: 900px) { .cm-hero { margin-top: 0; padding-top: 40px; } }
  .cm-hero-inner { max-width: 620px; margin: 0 auto; }
  .cm-kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.82); margin-bottom: var(--space-2); }
  .cm-h1 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(36px, 6.5vw, 60px); letter-spacing: -0.02em; line-height: 1.04; margin-bottom: var(--space-3); text-shadow: 0 4px 24px rgba(0,0,0,0.18); }
  .cm-h1 .hl { font-family: 'Caveat', cursive; color: var(--accent2); font-weight: 700; font-size: 1.15em; }
  .cm-sub { font-size: 15px; color: rgba(255,255,255,0.92); max-width: 480px; margin: 0 auto var(--space-4); line-height: 1.55; }
  .cm-picker {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3);
    border-radius: var(--radius-pill); padding: 7px 8px 7px 16px;
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .cm-picker-pin { font-size: 15px; }
  .cm-picker-select {
    background: #fff; color: var(--text); border: none; border-radius: var(--radius-pill);
    padding: 8px 14px; font-family: var(--font-display); font-weight: 700; font-size: 13.5px;
    cursor: pointer; max-width: 200px;
  }
  .cm-nearby { display: flex; justify-content: center; flex-wrap: wrap; gap: 6px; margin-top: var(--space-3); font-size: 12.5px; }
  .cm-nearby-label { color: rgba(255,255,255,0.7); padding: 5px 0; }
  .cm-nearby a { padding: 5px 12px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); border-radius: 999px; color: #fff; font-weight: 600; text-decoration: none; }
  .cm-nearby a:hover { background: rgba(255,255,255,0.26); }
  .cb-head { text-align: center; margin-bottom: 24px; }
  .cb-head h1 { font-family: var(--font-display); font-size: clamp(30px, 5vw, 40px); font-weight: 900; letter-spacing: -0.025em; }
  .cb-head p { font-size: 15px; color: var(--text-sec); max-width: 560px; margin: 8px auto 0; line-height: 1.55; }

  /* Primary tabs — pill-style, design-system colors */
  .cb-tabs {
    display: flex; gap: 6px; margin: 0 auto 32px;
    background: var(--surface); padding: 6px;
    border-radius: 999px; width: fit-content;
    border: 1px solid var(--border);
    flex-wrap: wrap; justify-content: center;
  }
  .cb-tab {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 20px; border-radius: 999px;
    font-family: var(--font-display); font-size: 14px; font-weight: 700;
    color: var(--text-sec); text-decoration: none;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }
  .cb-tab:hover:not(.active) { color: var(--text); background: var(--surface-hover); }
  .cb-tab:active { transform: translateY(1px); }
  .cb-tab.active { background: var(--bg); color: var(--accent); box-shadow: var(--card-shadow); }
  .cb-tab-badge {
    min-width: 20px; padding: 2px 8px; border-radius: 999px;
    background: var(--cta-bg); color: #fff;
    font-size: 11px; font-weight: 800; text-align: center;
  }

  /* Sections shared (groups + messages) */
  .cb-section { margin-top: 8px; }
  .cb-section-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
  .cb-section-title { font-family: var(--font-display); font-size: 22px; font-weight: 800; letter-spacing: -0.01em; }
  .cb-new-btn { padding: 10px 20px; font-size: 14px; }
  .cb-sub-section { margin-bottom: 32px; }
  .cb-sub-title { font-family: var(--font-display); font-size: 16px; font-weight: 700; margin-bottom: 12px; color: var(--text-sec); text-transform: uppercase; letter-spacing: 0.05em; }
  .cb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .cb-card {
    display: flex; flex-direction: column; gap: 8px;
    padding: 18px; background: var(--bg); border: 1px solid var(--border); border-radius: 16px;
    text-decoration: none; color: var(--text);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .cb-card:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-lg); border-color: var(--border-hover); }
  .cb-card:active { transform: translateY(0); }
  .cb-card-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .cb-card-name { font-family: var(--font-display); font-size: 17px; font-weight: 700; }
  .cb-card-lock { font-size: 11px; color: var(--text-sec); background: var(--surface); padding: 3px 9px; border-radius: 999px; }
  .cb-card-desc { font-size: 13px; color: var(--text-sec); line-height: 1.45; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .cb-card-meta { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--text-faint); }
  .cb-card-role { color: var(--accent); font-weight: 700; }
  .cb-empty {
    padding: 32px 24px; border: 1px dashed var(--border); border-radius: 14px;
    text-align: center; color: var(--text-sec); font-size: 14px;
  }
  .cb-empty a { color: var(--accent); font-weight: 600; }

  /* Favors section (preserved) */
  .ho-wrap-inner { max-width: 720px; margin: 0 auto; }
  .ho-tabs { display: flex; gap: 6px; justify-content: center; margin-bottom: 24px; flex-wrap: wrap; }
  .ho-tab { padding: 8px 18px; border-radius: 999px; background: var(--bg); border: 1px solid var(--border); font-size: 13px; font-weight: 600; color: var(--text-sec); text-decoration: none; transition: background 0.15s, color 0.15s; }
  .ho-tab:hover { background: var(--surface); color: var(--text); }
  .ho-tab.active { background: var(--text); color: var(--bg); border-color: var(--text); }

  .ho-composer, .ho-signed-out {
    background: var(--bg); border: 1px solid var(--border); border-radius: 16px;
    padding: 20px; margin-bottom: 24px;
  }
  .ho-signed-out { text-align: center; }
  .ho-composer h2 { font-family: var(--font-display); font-size: 15px; font-weight: 800; margin-bottom: 12px; }
  .ho-row { display: flex; gap: 8px; margin-bottom: 12px; }
  .ho-pick {
    flex: 1; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px;
    background: var(--surface); cursor: pointer; font-size: 14px; font-weight: 600;
    display: flex; align-items: center; gap: 8px; transition: all 0.15s;
  }
  .ho-pick:has(input:checked) { background: var(--accent-dim); border-color: var(--accent); }
  .ho-pick input { width: 14px; height: 14px; accent-color: var(--accent); }
  .ho-input { width: 100%; padding: 11px 13px; border: 1px solid var(--border); border-radius: 10px; font-size: 14px; font-family: var(--font); background: var(--bg); margin-bottom: 10px; }
  .ho-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
  .ho-textarea { resize: vertical; line-height: 1.5; }
  .ho-half { max-width: 280px; }
  .ho-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; gap: 10px; flex-wrap: wrap; }
  .ho-hint { font-size: 12px; color: var(--text-faint); }
  .ho-post-btn { padding: 10px 18px; border-radius: 999px; border: none; background: var(--cta-bg); color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 13px; cursor: pointer; transition: transform 0.15s, box-shadow 0.15s; }
  .ho-post-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px var(--cta-glow); }
  .ho-post-btn:active { transform: translateY(0); }

  .ho-feed { display: flex; flex-direction: column; gap: 10px; }
  .ho-card { padding: 18px 20px; background: var(--bg); border: 1px solid var(--border); border-radius: 14px; }
  .ho-card.ho-offer { background: linear-gradient(160deg, rgba(16,185,129,0.06), transparent); border-color: rgba(16,185,129,0.20); }
  .ho-card.ho-need { background: linear-gradient(160deg, var(--sunset-dim), transparent); border-color: rgba(249,115,22,0.25); }
  .ho-card-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .ho-kind { font-size: 11px; font-weight: 700; color: var(--text-sec); text-transform: uppercase; letter-spacing: 0.04em; }
  .ho-loc { font-size: 12px; color: var(--text-sec); }
  .ho-card h3 { font-family: var(--font-display); font-size: 16px; font-weight: 800; margin-bottom: 6px; letter-spacing: -0.01em; }
  .ho-card p { font-size: 14px; line-height: 1.55; color: var(--text-sec); margin-bottom: 8px; }
  .ho-card-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 12px; flex-wrap: wrap; }
  .ho-by { color: var(--text-faint); }
  .ho-mod { display: flex; gap: 6px; }
  .ho-mod button { background: none; border: none; cursor: pointer; color: var(--text-sec); font-size: 12px; font-weight: 600; padding: 4px 8px; border-radius: 6px; }
  .ho-mod button:hover { background: var(--surface); color: var(--text); }

  .ho-empty { padding: 56px 24px; text-align: center; color: var(--text-faint); background: var(--surface); border: 1px dashed var(--border); border-radius: 14px; }
  .ho-empty a { color: var(--accent); font-weight: 600; }

  /* DM list (mirrored from /groups) */
  .dm-list { display: flex; flex-direction: column; gap: 6px; }
  .dm-row {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px; background: var(--bg);
    border: 1px solid var(--border); border-radius: 14px;
    text-decoration: none; transition: background 0.15s, border-color 0.15s;
  }
