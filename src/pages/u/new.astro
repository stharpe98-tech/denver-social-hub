---
// Organizer "/u/ page" builder retired. Hosting/joining now uses the simple
// member signup; preserve any ?next= so people land where they were headed.
const next = Astro.url.searchParams.get('next') || '';
const safeNext = /^\/[^/]/.test(next) ? next : '';
return Astro.redirect(safeNext ? `/signup?next=${encodeURIComponent(safeNext)}` : '/signup', 301);
---
