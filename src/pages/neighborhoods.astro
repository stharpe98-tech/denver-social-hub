---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';

// Forward legacy params so old deep links still resolve to the community board.
const nbhParam = Astro.url.searchParams.get('nbh') || Astro.url.searchParams.get('slug') || '';
if (nbhParam) {
  return Astro.redirect(`/community?nbh=${encodeURIComponent(nbhParam)}`);
}

const db = getDB();
let zones: { zone: string; cnt: number }[] = [];
try {
  if (db) {
    const rows = (await db.prepare(
      "SELECT zone, COUNT(*) as cnt FROM events WHERE (is_past IS NULL OR is_past=0) AND zone IS NOT NULL AND zone != '' GROUP BY zone ORDER BY cnt DESC LIMIT 12"
    ).all())?.results || [];
    zones = rows.map((r: any) => ({ zone: r.zone, cnt: r.cnt || 0 }));
  }
} catch {}

const max = zones.length ? Math.max(...zones.map(z => z.cnt)) : 0;
const sizeFor = (cnt: number) => {
  if (!max) return 96;
  return Math.round(96 + (cnt / max) * 96); // 96px → 192px
};
const colorFor = (cnt: number) => (cnt >= 6 ? '#FFD93D' : cnt >= 3 ? '#10B981' : '#3B82F6');
const zoneHref = (zone: string) => `/events?zone=${encodeURIComponent(zone)}`;
---
<Base title="Neighborhoods" description="Find your corner of Denver — see what's happening where.">
<div class="festival">

  <section class="galaxy-hero">
    <div class="gh-in">
      <span class="gh-pill">— {zones.length || 'DENVER'} NEIGHBORHOODS ACTIVE</span>
      <h1>Find <em>your</em> corner of Denver.</h1>
      <p>Every neighborhood has its own thing — its regulars, its weekly routine. Drop into whichever feels closest, or wander.</p>
      <a href="#map" class="btn-stars">Explore the map ↓</a>
    </div>
  </section>

  <section class="map-section" id="map"><div class="map-in">
    <span class="section-eyebrow">— DENVER, BY ACTIVITY (LIVE FROM THE CALENDAR)</span>
    <h2>The bigger the bubble, the more is happening.</h2>
    <p class="sub">Counts are real upcoming events per neighborhood. Tap one to dive in.</p>

    {zones.length > 0 ? (
      <>
        <div class="planet-map">
          {zones.map((z) => (
            <a href={zoneHref(z.zone)} class="planet" style={`width:${sizeFor(z.cnt)}px;height:${sizeFor(z.cnt)}px;background:radial-gradient(circle at 35% 30%, ${colorFor(z.cnt)}, #1a1b2e)`}>
              <div class="pn">{z.zone}</div>
              <div class="pc">{z.cnt}</div>
              <small>{z.cnt === 1 ? 'event' : 'events'}</small>
            </a>
          ))}
        </div>
        <div class="legend">
          <div class="legend-item"><span class="legend-dot" style="background:#FFD93D"></span>Hot zone (6+ upcoming)</div>
          <div class="legend-item"><span class="legend-dot" style="background:#10B981"></span>Active (3–5)</div>
          <div class="legend-item"><span class="legend-dot" style="background:#3B82F6"></span>Growing (1–2)</div>
        </div>
      </>
    ) : (
      <p class="empty">No neighborhood activity on the calendar yet. <a href="/events/new">Host the first one →</a></p>
    )}
  </div></section>

  <section class="cta-final">
    <h2>Don't see your neighborhood?</h2>
    <span class="scribble">~ start it. that's how all the others did. ~</span>
    <a href="/events/new" class="btn-big">Become a host →</a>
  </section>

</div>

<style>
  .festival{--accent:#7C3AED;font-family:'Inter','Work Sans',system-ui,sans-serif;color:#111827;background:#fff}
  .festival a{color:inherit;text-decoration:none}
  .galaxy-hero{position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 0%,#2d1b4e,#0F0F23 70%);color:#fff;padding:var(--space-9) 24px;text-align:center}
  .gh-in{position:relative;max-width:720px;margin:0 auto}
  .gh-pill{display:inline-block;font-size:11px;letter-spacing:2px;font-weight:700;background:rgba(255,255,255,.12);padding:8px 16px;border-radius:50px;margin-bottom:var(--space-5)}
  .galaxy-hero h1{font-family:'Outfit';font-size:clamp(40px,7vw,84px);font-weight:900;letter-spacing:-.03em;margin-bottom:var(--space-4);color:#fff}
  .galaxy-hero h1 em{font-style:normal;font-family:'Caveat';color:#FFD93D;font-size:.85em}
  .galaxy-hero p{font-size:18px;color:rgba(255,255,255,.8);max-width:540px;margin:0 auto var(--space-6)}
  .btn-stars{display:inline-block;background:#FFD93D;color:#111;padding:16px 32px;border-radius:50px;font-weight:800;font-size:15px}
  .map-section{padding:var(--space-9) var(--space-5);background:#0F0F23;color:#fff}.map-in{max-width:1100px;margin:0 auto;text-align:center}
  .section-eyebrow{display:block;font-size:11px;letter-spacing:3px;font-weight:800;color:#FFD93D;margin-bottom:var(--space-3)}
  .map-in h2{font-family:'Outfit';font-size:clamp(28px,4vw,48px);font-weight:900;margin-bottom:var(--space-3);color:#fff}
  .map-in .sub{color:rgba(255,255,255,.7);font-size:17px;margin-bottom:var(--space-8)}
  .planet-map{display:flex;flex-wrap:wrap;gap:var(--space-5);justify-content:center;align-items:center}
  .planet{border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;text-align:center;box-shadow:0 10px 40px rgba(0,0,0,.4);transition:transform .2s}
  .planet:hover{transform:scale(1.06)}
  .planet .pn{font-family:'Outfit';font-weight:800;font-size:14px;padding:0 8px}
  .planet .pc{font-family:'Outfit';font-weight:900;font-size:28px;line-height:1.1}
  .planet small{font-size:10px;opacity:.8;text-transform:uppercase;letter-spacing:1px}
  .legend{display:flex;flex-wrap:wrap;gap:var(--space-5);justify-content:center;margin-top:var(--space-8);font-size:13px;color:rgba(255,255,255,.7)}
  .legend-item{display:flex;align-items:center;gap:8px}
  .legend-dot{width:12px;height:12px;border-radius:50%;display:inline-block}
  .empty{color:rgba(255,255,255,.8);font-size:18px}.empty a{color:#FFD93D}
  .cta-final{padding:var(--space-9) var(--space-5);text-align:center;background:#fff;border-top:1px solid #E5E7EB}
  .cta-final h2{font-family:'Outfit';font-size:clamp(32px,4.5vw,48px);font-weight:900;margin-bottom:var(--space-3)}
  .scribble{font-family:'Caveat';color:var(--accent);font-size:26px;display:block;margin-bottom:var(--space-5);transform:rotate(-2deg)}
  .btn-big{background:var(--accent);color:#fff;padding:18px 36px;border-radius:50px;font-weight:800;font-size:15px;box-shadow:0 8px 24px rgba(124,58,237,.3);display:inline-block}
  @media (max-width:680px){.galaxy-hero,.map-section,.cta-final{padding-left:16px;padding-right:16px}}
</style>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&display=swap" />
</Base>
