---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';

// Forward legacy params so old deep links still resolve to the community board.
const nbhParam = Astro.url.searchParams.get('nbh') || Astro.url.searchParams.get('slug') || '';
if (nbhParam) {
  return Astro.redirect(`/community?nbh=${encodeURIComponent(nbhParam)}`);
}

const db = getDB();
let zones: { zone: string; cnt: number }[] = [];
try {
  if (db) {
    const rows = (await db.prepare(
      "SELECT zone, COUNT(*) as cnt FROM events WHERE (is_past IS NULL OR is_past=0) AND zone IS NOT NULL AND zone != '' GROUP BY zone ORDER BY cnt DESC LIMIT 18"
    ).all())?.results || [];
    zones = rows.map((r: any) => ({ zone: r.zone, cnt: r.cnt || 0 }));
  }
} catch {}
const zoneHref = (zone: string) => `/events?zone=${encodeURIComponent(zone)}`;
---
<Base title="Neighborhoods" description="Find your corner of Denver — see what's happening where.">
<div class="hoods">
  <header class="hero"><div class="wrap">
    <div class="k">{zones.length || 'Denver'} neighborhoods active</div>
    <h1>Find <em>your</em> corner of Denver.</h1>
    <p>Every neighborhood has its own thing — its regulars, its weekly routine. Drop into whichever feels closest, or wander.</p>
  </div></header>

  <section class="wrap list">
    {zones.length > 0 ? (
      <div class="grid">
        {zones.map((z) => (
          <a class="hood" href={zoneHref(z.zone)}>
            <span class="name">{z.zone}</span>
            <span class="cnt">{z.cnt} {z.cnt === 1 ? 'event' : 'events'}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty">No neighborhood activity yet — <a href="/events/new">host the first one →</a></p>
    )}
    <div class="cta">
      <p>Don't see your neighborhood?</p>
      <a class="btn" href="/events/new">Start something there →</a>
    </div>
  </section>
</div>

<style>
  .hoods{background:var(--bg);color:var(--text)}
  .hoods .wrap{max-width:1000px;margin:0 auto;padding:0 24px}
  .hoods a{text-decoration:none}
  .hero{text-align:center;padding:64px 0 32px}
  .hero .k{font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:12px}
  .hero h1{font-family:var(--font-display);font-size:clamp(34px,5.5vw,58px);font-weight:800;letter-spacing:-.02em;margin-bottom:14px}
  .hero h1 em{font-style:normal;color:var(--accent)}
  .hero p{color:var(--text-sec);font-size:18px;max-width:520px;margin:0 auto}
  .list{padding:24px 0 80px}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .hood{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid var(--border);border-radius:16px;padding:18px 20px;transition:transform .15s,border-color .15s}
  .hood:hover{transform:translateY(-3px);border-color:var(--accent)}
  .hood .name{font-family:var(--font-display);font-weight:700;font-size:17px}
  .hood .cnt{font-size:13px;color:var(--accent);font-weight:600;background:var(--accent-soft);padding:4px 10px;border-radius:999px}
  .empty{text-align:center;color:var(--text-sec);font-size:18px;padding:40px 0}.empty a{color:var(--accent);font-weight:600}
  @media(max-width:780px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.grid{grid-template-columns:1fr}}
  .cta{text-align:center;margin-top:48px}
  .cta p{color:var(--text-sec);font-size:17px;margin-bottom:14px}
  .btn{display:inline-block;background:var(--accent);color:#fff;font-weight:700;padding:14px 28px;border-radius:999px;box-shadow:0 8px 22px rgba(240,87,61,.3)}
</style>
</Base>
