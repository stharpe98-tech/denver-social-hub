---
import type { OrganizerThemeProps } from '../../lib/organizer-themes';
const { profile, events, offers, links, accent } = Astro.props as OrganizerThemeProps;
const upcoming = events.filter((e) => !e.past);
const past = events.filter((e) => e.past).slice(0, 4);
---
<main class="z-stage" style={`--accent: ${accent};`}>
  <header class="z-mast">
    <span class="z-issue">Issue №<span>{String((profile.slug || '').length).padStart(2, '0')}</span></span>
    <span class="z-issue-dot" aria-hidden="true">✺</span>
    <span class="z-issue">Vol. {profile.neighborhood || 'Denver'}</span>
  </header>

  <section class="z-hero">
    <div class="z-hero-text">
      <div class="z-kicker">— A standing invitation —</div>
      <h1 class="z-name">{profile.display_name}</h1>
      {profile.headline && <p class="z-headline">{profile.headline}</p>}
      <div class="z-tags">
        {profile.neighborhood && <span class="z-tag">◷ {profile.neighborhood}</span>}
        <span class="z-tag z-tag-sub">/p/{profile.slug}</span>
      </div>
    </div>
    {(profile.avatar_photo_url || profile.photo_emoji) && (
      <figure class="z-portrait">
        <div class="z-portrait-frame">
          {profile.avatar_photo_url ? (
            <img src={profile.avatar_photo_url} alt={profile.display_name} loading="eager"/>
          ) : (
            <span class="z-portrait-emoji">{profile.photo_emoji}</span>
          )}
        </div>
        <figcaption>plate i.</figcaption>
      </figure>
    )}
  </section>

  {profile.bio && (
    <section class="z-bio">
      <div class="z-bio-rule" aria-hidden="true">❦</div>
      <p>{profile.bio}</p>
    </section>
  )}

  {upcoming.length > 0 && (
    <section class="z-block z-block-events">
      <div class="z-block-head">
        <span class="z-block-label">section ii ·</span>
        <h2>On the calendar</h2>
      </div>
      <div class="z-event-grid">
        {upcoming.map((e) => (
          <a class="z-card z-event-card" href={`/events/${e.id}`}>
            <div class="z-date-block">
              <span class="z-date-m">{e.month}</span>
              <span class="z-date-d">{e.day}</span>
            </div>
            <div class="z-event-body">
              <div class="z-event-title">{e.title}</div>
              {e.location && <div class="z-event-loc">{e.location}</div>}
            </div>
            <span class="z-event-go" aria-hidden="true">↦</span>
          </a>
        ))}
      </div>
      {past.length > 0 && (
        <div class="z-past">
          <span class="z-past-label">recently passed</span>
          <ul>
            {past.map((e) => (
              <li><a href={`/events/${e.id}`}>{e.title} <span>· {e.month} {e.day}</span></a></li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}

  {offers.length > 0 && (
    <section class="z-block">
      <div class="z-block-head">
        <span class="z-block-label">section iii ·</span>
        <h2>What I offer</h2>
      </div>
      <div class="z-offer-grid">
        {offers.map((o) => (
          <div class="z-card z-offer-card">
            <span class="z-offer-icon">{o.icon || '✦'}</span>
            <span class="z-offer-label">{o.label}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {links.length > 0 && (
    <section class="z-block">
      <div class="z-block-head">
        <span class="z-block-label">section iv ·</span>
        <h2>Find me elsewhere</h2>
      </div>
      <div class="z-link-row">
        {links.map((l) => (
          <a class="z-pill" href={l.url} target="_blank" rel="noopener nofollow">
            <span>{l.icon || '✺'}</span>{l.label}
          </a>
        ))}
      </div>
    </section>
  )}

  <footer class="z-foot">
    <div class="z-foot-orn" aria-hidden="true">✻ ◷ ✻</div>
    <div class="z-foot-row">
      <span>Hand-set in Denver</span>
      <span class="z-foot-dot">·</span>
      <a href={`/u/${profile.slug}`}>Standard view ↦</a>
    </div>
  </footer>
</main>

<style>
  .z-stage {
    --paper: #F6EFE1;
    --paper-deep: #EFE5D0;
    --ink: #2A241B;
    --ink-soft: #6B5F4D;
    --ink-faint: #9C8E78;
    --rule: #C9B89A;
    --card-sand: #FBF6EA;
    --card-sand-edge: #E8D9BB;
    --card-sage: #EEF1E4;
    --card-sage-edge: #C9D2B0;
    --card-blush: #F5E5DD;
    --card-blush-edge: #DCBFB2;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', system-ui, sans-serif;
    min-height: 100vh;
    padding: 40px 24px 96px;
    max-width: 980px;
    margin: 0 auto;
    /* Subtle paper-grain via a layered radial — keeps surfaces from
       feeling flat without competing with content. */
    background-image:
      radial-gradient(circle at 18% 22%, rgba(0,0,0,0.018), transparent 40%),
      radial-gradient(circle at 82% 78%, rgba(0,0,0,0.022), transparent 38%);
  }

  /* Masthead — small mono ornaments, hairline rule */
  .z-mast {
    display: flex; align-items: center; justify-content: center;
    gap: 12px;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 80px;
  }
  .z-issue span { color: var(--ink); }
  .z-issue-dot { color: var(--accent); font-size: 14px; line-height: 1; }

  /* Hero — left text + right portrait, asymmetric on desktop, stacked
     on mobile, with the kicker doing the heavy framing work. */
  .z-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: end;
    margin-bottom: 96px;
  }
  @media (min-width: 720px) {
    .z-hero { grid-template-columns: 1.2fr 0.8fr; gap: 56px; }
  }
  .z-kicker {
    font-family: 'Space Mono', monospace;
    font-size: 11px; font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 24px;
  }
  .z-name {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(54px, 9vw, 108px);
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 20px;
  }
  .z-headline {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(18px, 2.3vw, 24px);
    color: var(--ink-soft);
    line-height: 1.4;
    margin: 0 0 24px;
    max-width: 28ch;
  }
  .z-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .z-tag {
    font-family: 'Space Mono', monospace;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--card-sand);
    border: 1px solid var(--card-sand-edge);
    color: var(--ink);
    padding: 6px 12px;
    border-radius: 999px;
  }
  .z-tag-sub { background: transparent; border-color: var(--rule); color: var(--ink-soft); }

  .z-portrait { margin: 0; justify-self: end; text-align: center; }
  .z-portrait-frame {
    width: 220px; height: 280px;
    background: var(--card-blush);
    border: 1px solid var(--card-blush-edge);
    box-shadow: 0 1px 0 var(--card-blush-edge);
    overflow: hidden;
    display: grid; place-items: center;
    transform: rotate(-1.2deg);
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .z-portrait-frame:hover { transform: rotate(0deg); }
  .z-portrait-frame img { width: 100%; height: 100%; object-fit: cover; }
  .z-portrait-emoji { font-size: 96px; color: var(--ink); }
  .z-portrait figcaption {
    font-family: 'Space Mono', monospace;
    font-size: 10px; font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 12px;
  }

  /* Bio — wide, italic, with an ornament rule */
  .z-bio { max-width: 60ch; margin: 0 auto 96px; text-align: center; }
  .z-bio-rule {
    font-family: 'Cormorant Garamond', serif;
    color: var(--accent);
    font-size: 24px;
    margin-bottom: 16px;
  }
  .z-bio p {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
    text-wrap: pretty;
  }

  /* Section heads */
  .z-block { margin-bottom: 96px; }
  .z-block-head {
    display: flex; align-items: baseline; gap: 14px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 12px;
  }
  .z-block-label {
    font-family: 'Space Mono', monospace;
    font-size: 11px; font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .z-block-head h2 {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* Tactile cards — every card has a tint and a low-contrast border in
     the same hue family. No flat grey rectangles. */
  .z-card {
    background: var(--card-sand);
    border: 1px solid var(--card-sand-edge);
    border-radius: 10px;
    transition:
      transform 480ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 480ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .z-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -12px rgba(60, 40, 12, 0.35);
    border-color: color-mix(in srgb, var(--accent) 36%, var(--card-sand-edge));
  }
  .z-card:active { transform: translateY(0); transition-duration: 120ms; }

  .z-event-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .z-event-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
  .z-event-card {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px 18px;
    text-decoration: none;
    color: inherit;
  }
  .z-event-card:nth-child(3n+2) { background: var(--card-sage); border-color: var(--card-sage-edge); }
  .z-event-card:nth-child(3n+2):hover { border-color: color-mix(in srgb, var(--accent) 36%, var(--card-sage-edge)); }
  .z-event-card:nth-child(3n) { background: var(--card-blush); border-color: var(--card-blush-edge); }
  .z-event-card:nth-child(3n):hover { border-color: color-mix(in srgb, var(--accent) 36%, var(--card-blush-edge)); }

  .z-date-block { text-align: center; line-height: 1; }
  .z-date-m {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .z-date-d {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: 36px;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .z-event-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: 19px;
    color: var(--ink);
    line-height: 1.25;
  }
  .z-event-loc {
    font-family: 'Inter', sans-serif;
    font-size: 12px; font-weight: 500;
    color: var(--ink-soft);
    margin-top: 4px;
  }
  .z-event-go {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--accent);
  }

  .z-past { margin-top: 24px; }
  .z-past-label {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 10px;
  }
  .z-past ul { list-style: none; padding: 0; margin: 0; }
  .z-past li { border-bottom: 1px dashed var(--rule); }
  .z-past a {
    display: block; padding: 10px 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px; color: var(--ink-soft); text-decoration: none;
    transition: color 360ms cubic-bezier(0.16, 1, 0.3, 1), padding 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .z-past a span { font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: 0.15em; }
  .z-past a:hover { color: var(--ink); padding-left: 6px; }

  /* Offers */
  .z-offer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }
  .z-offer-card {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 16px;
    background: var(--card-sage);
    border-color: var(--card-sage-edge);
  }
  .z-offer-card:nth-child(2n) { background: var(--card-sand); border-color: var(--card-sand-edge); }
  .z-offer-card:nth-child(3n) { background: var(--card-blush); border-color: var(--card-blush-edge); }
  .z-offer-icon {
    width: 36px; height: 36px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 50%;
    display: grid; place-items: center;
    font-size: 17px;
    flex-shrink: 0;
  }
  .z-offer-label {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
    color: var(--ink);
  }

  /* Links */
  .z-link-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .z-pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 16px;
    background: var(--card-sand);
    border: 1px solid var(--card-sand-edge);
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 14px; font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: background 360ms cubic-bezier(0.16, 1, 0.3, 1), border-color 360ms cubic-bezier(0.16, 1, 0.3, 1), transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .z-pill span { font-family: 'Space Mono', monospace; color: var(--accent); font-size: 12px; }
  .z-pill:hover {
    background: color-mix(in srgb, var(--accent) 12%, var(--card-sand));
    border-color: color-mix(in srgb, var(--accent) 36%, var(--card-sand-edge));
    transform: translateY(-1px);
  }
  .z-pill:active { transform: translateY(0); }

  /* Foot */
  .z-foot { margin-top: 80px; text-align: center; }
  .z-foot-orn { color: var(--accent); letter-spacing: 0.4em; margin-bottom: 12px; }
  .z-foot-row {
    display: inline-flex; align-items: baseline; gap: 10px;
    font-family: 'Space Mono', monospace;
    font-size: 11px; font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .z-foot-row a { color: var(--ink); text-decoration: none; transition: color 360ms cubic-bezier(0.16, 1, 0.3, 1); }
  .z-foot-row a:hover { color: var(--accent); }
  .z-foot-row a:active { opacity: 0.7; }
  .z-foot-dot { color: var(--ink-faint); }

  @media (max-width: 600px) {
    .z-stage { padding: 28px 18px 64px; }
    .z-mast { margin-bottom: 48px; }
    .z-hero { margin-bottom: 56px; gap: 32px; }
    .z-portrait-frame { width: 180px; height: 220px; }
    .z-bio, .z-block { margin-bottom: 56px; }
    .z-event-card { grid-template-columns: 48px 1fr; }
    .z-event-go { display: none; }
  }
</style>
