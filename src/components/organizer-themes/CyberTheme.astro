---
import type { OrganizerThemeProps } from '../../lib/organizer-themes';
const { profile, events, offers, links, accent } = Astro.props as OrganizerThemeProps;
const upcoming = events.filter((e) => !e.past);
const past = events.filter((e) => e.past);
const handle = (profile.slug || '').toUpperCase();
---
<main class="c-stage" style={`--accent: ${accent};`}>
  <div class="c-grid" aria-hidden="true"></div>
  <div class="c-scan" aria-hidden="true"></div>

  <header class="c-mast">
    <div class="c-mast-row">
      <span class="c-tag">node.organizer</span>
      <span class="c-tag c-tag-live"><span class="c-dot"></span>live</span>
      <span class="c-tag">/p/{profile.slug}</span>
    </div>
    <div class="c-mast-rule" aria-hidden="true"></div>
  </header>

  <section class="c-hero">
    <div class="c-prompt">
      <span class="c-prompt-mark">$</span>
      <span class="c-prompt-cmd">whois</span>
      <span class="c-prompt-arg">{handle}</span>
      <span class="c-cursor" aria-hidden="true"></span>
    </div>
    <h1 class="c-name">{profile.display_name}</h1>
    {profile.headline && <p class="c-headline">// {profile.headline}</p>}
    <dl class="c-spec">
      <div>
        <dt>region</dt><dd>{profile.neighborhood || 'denver_co'}</dd>
      </div>
      <div>
        <dt>events</dt><dd>{String(events.length).padStart(3, '0')}</dd>
      </div>
      <div>
        <dt>handle</dt><dd>@{profile.slug}</dd>
      </div>
    </dl>
  </section>

  {profile.bio && (
    <section class="c-block c-bio">
      <div class="c-block-head">
        <span class="c-block-num">01</span>
        <h2>readme.txt</h2>
        <span class="c-block-rule" aria-hidden="true"></span>
      </div>
      <p class="c-bio-text">{profile.bio}</p>
    </section>
  )}

  {(upcoming.length > 0 || past.length > 0) && (
    <section class="c-block">
      <div class="c-block-head">
        <span class="c-block-num">02</span>
        <h2>scheduled.events</h2>
        <span class="c-block-count">[{String(events.length).padStart(3, '0')}]</span>
        <span class="c-block-rule" aria-hidden="true"></span>
      </div>
      <div class="c-event-list">
        {upcoming.map((e, i) => (
          <a class="c-event" href={`/events/${e.id}`}>
            <span class="c-event-idx">{String(i).padStart(2, '0')}</span>
            <span class="c-event-date">
              <span class="c-event-m">{e.month}</span>
              <span class="c-event-d">{e.day}</span>
            </span>
            <span class="c-event-title">{e.title}</span>
            <span class="c-event-loc">{e.location || '—'}</span>
            <span class="c-event-go" aria-hidden="true">▸</span>
          </a>
        ))}
        {past.map((e, i) => (
          <a class="c-event c-event-past" href={`/events/${e.id}`}>
            <span class="c-event-idx">··</span>
            <span class="c-event-date">
              <span class="c-event-m">{e.month}</span>
              <span class="c-event-d">{e.day}</span>
            </span>
            <span class="c-event-title">{e.title}</span>
            <span class="c-event-loc">archive · {e.location || '—'}</span>
            <span class="c-event-go" aria-hidden="true">▫</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {offers.length > 0 && (
    <section class="c-block">
      <div class="c-block-head">
        <span class="c-block-num">03</span>
        <h2>offerings.json</h2>
        <span class="c-block-rule" aria-hidden="true"></span>
      </div>
      <div class="c-offer-grid">
        {offers.map((o, i) => (
          <div class="c-offer">
            <span class="c-offer-idx">[{String(i).padStart(2, '0')}]</span>
            <span class="c-offer-icon">{o.icon || '▸'}</span>
            <span class="c-offer-label">{o.label}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {links.length > 0 && (
    <section class="c-block">
      <div class="c-block-head">
        <span class="c-block-num">04</span>
        <h2>external.links</h2>
        <span class="c-block-rule" aria-hidden="true"></span>
      </div>
      <ul class="c-link-list">
        {links.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel="noopener nofollow">
              <span class="c-link-arrow">→</span>
              <span class="c-link-label">{l.label}</span>
              <span class="c-link-host">{l.url.replace(/^https?:\/\//, '').split('/')[0]}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <footer class="c-foot">
    <div class="c-mast-rule" aria-hidden="true"></div>
    <div class="c-foot-row">
      <span>// node terminated · session ok</span>
      <a href={`/u/${profile.slug}`}>standard.view ↗</a>
    </div>
  </footer>
</main>

<style>
  .c-stage {
    --bg: #07080C;
    --bg-card: #0D0F16;
    --ink: #E6EEF6;
    --ink-soft: #9BA7B5;
    --ink-faint: #5C6573;
    --line: rgba(155, 167, 181, 0.16);
    --line-bright: rgba(155, 167, 181, 0.28);
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', system-ui, sans-serif;
    min-height: 100vh;
    padding: 32px 24px 96px;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    isolation: isolate;
  }

  /* Background grid + scanline — drawn behind everything else. The
     accent-colored grid is intentionally faint so content reads first. */
  .c-grid {
    position: fixed; inset: 0; z-index: -1;
    background:
      linear-gradient(to right, color-mix(in srgb, var(--accent) 7%, transparent) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(to bottom, color-mix(in srgb, var(--accent) 7%, transparent) 1px, transparent 1px) 0 0 / 56px 56px,
      radial-gradient(ellipse at top, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%),
      var(--bg);
    pointer-events: none;
  }
  .c-scan {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(230, 238, 246, 0.018) 3px,
      rgba(230, 238, 246, 0.018) 4px
    );
  }

  /* Masthead */
  .c-mast { margin-bottom: 64px; }
  .c-mast-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .c-tag {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    padding: 5px 10px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
    border-radius: 3px;
  }
  .c-tag-live { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 38%, transparent); }
  .c-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
    margin-right: 6px;
    animation: c-pulse 1.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes c-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
  .c-mast-rule {
    height: 1px;
    background: linear-gradient(to right, var(--line-bright), transparent);
    margin-top: 16px;
  }

  /* Hero — terminal prompt → big monospaced display name */
  .c-hero { margin-bottom: 80px; }
  .c-prompt {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; font-weight: 500;
    color: var(--ink-soft);
    margin-bottom: 24px;
    display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
  }
  .c-prompt-mark { color: var(--accent); font-weight: 700; }
  .c-prompt-cmd { color: var(--ink); }
  .c-prompt-arg { color: var(--accent); }
  .c-cursor {
    display: inline-block;
    width: 10px; height: 16px;
    background: var(--accent);
    margin-left: 4px;
    animation: c-blink 1.1s steps(2, start) infinite;
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 70%, transparent);
  }
  @keyframes c-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }

  .c-name {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 800;
    font-size: clamp(48px, 9vw, 128px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: var(--ink);
    text-shadow:
      0 0 24px color-mix(in srgb, var(--accent) 22%, transparent),
      0 0 64px color-mix(in srgb, var(--accent) 12%, transparent);
    margin: 0 0 16px;
    text-wrap: balance;
  }
  .c-headline {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(14px, 1.6vw, 17px);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 56ch;
    margin: 0 0 32px;
  }

  .c-spec {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: color-mix(in srgb, var(--accent) 3%, var(--bg-card));
    max-width: 720px;
  }
  .c-spec > div {
    padding: 14px 18px;
    border-right: 1px solid var(--line);
  }
  .c-spec > div:last-child { border-right: none; }
  .c-spec dt {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 4px;
  }
  .c-spec dd {
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px; font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  /* Block heads — numbered + filename + extending rule */
  .c-block { margin-bottom: 80px; }
  .c-block-head {
    display: flex; align-items: baseline; gap: 14px;
    margin-bottom: 24px;
  }
  .c-block-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .c-block-head h2 {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 28px);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }
  .c-block-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 500;
    color: var(--ink-faint);
  }
  .c-block-rule {
    flex: 1; height: 1px;
    background: linear-gradient(to right, var(--line-bright), transparent);
  }

  .c-bio-text {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(16px, 1.7vw, 18px);
    line-height: 1.6;
    color: var(--ink);
    max-width: 64ch;
    margin: 0;
    padding: 20px 22px;
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
    border: 1px solid var(--line);
    border-left: 2px solid color-mix(in srgb, var(--accent) 60%, var(--line));
    border-radius: 3px;
  }

  /* Events — terminal list with tight columns */
  .c-event-list {
    border: 1px solid var(--line);
    border-radius: 3px;
    background: color-mix(in srgb, var(--accent) 2%, var(--bg-card));
  }
  .c-event {
    display: grid;
    grid-template-columns: 36px 64px 1fr auto 24px;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition:
      background 380ms cubic-bezier(0.16, 1, 0.3, 1),
      padding 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .c-event:last-child { border-bottom: none; }
  .c-event:hover {
    background: color-mix(in srgb, var(--accent) 9%, var(--bg-card));
    padding-left: 24px;
  }
  .c-event-idx {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 500;
    color: var(--ink-faint);
  }
  .c-event-date { line-height: 1; }
  .c-event-m {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .c-event-d {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 22px; font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .c-event-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 15px; font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }
  .c-event-loc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 500;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }
  .c-event-go { color: var(--accent); font-size: 14px; }
  .c-event-past .c-event-d,
  .c-event-past .c-event-title { opacity: 0.5; }
  .c-event-past .c-event-go { color: var(--ink-faint); }

  /* Offers — bordered key/value rows */
  .c-offer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 3px;
  }
  .c-offer {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 18px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--accent) 2%, var(--bg-card));
    transition: background 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .c-offer:hover { background: color-mix(in srgb, var(--accent) 9%, var(--bg-card)); }
  .c-offer-idx {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 500;
    color: var(--ink-faint);
  }
  .c-offer-icon {
    width: 30px; height: 30px;
    display: grid; place-items: center;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line));
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-card));
    border-radius: 3px;
    font-size: 13px;
  }
  .c-offer-label {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px; font-weight: 500;
    color: var(--ink);
    line-height: 1.35;
  }

  /* Links */
  .c-link-list { list-style: none; padding: 0; margin: 0; }
  .c-link-list li { border-bottom: 1px solid var(--line); }
  .c-link-list li:last-child { border-bottom: none; }
  .c-link-list a {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    color: var(--ink);
    text-decoration: none;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px; font-weight: 500;
    transition: padding 380ms cubic-bezier(0.16, 1, 0.3, 1), color 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .c-link-list a:hover { padding-left: 12px; color: var(--accent); }
  .c-link-list a:active { padding-left: 6px; }
  .c-link-arrow { color: var(--accent); font-family: 'JetBrains Mono', monospace; }
  .c-link-host {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 500;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  /* Foot */
  .c-foot { margin-top: 64px; }
  .c-foot-row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; flex-wrap: wrap;
    margin-top: 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 500;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }
  .c-foot-row a { color: var(--ink-soft); text-decoration: none; transition: color 380ms cubic-bezier(0.16, 1, 0.3, 1); }
  .c-foot-row a:hover { color: var(--accent); }
  .c-foot-row a:active { opacity: 0.7; }

  @media (max-width: 600px) {
    .c-stage { padding: 24px 18px 64px; }
    .c-mast { margin-bottom: 40px; }
    .c-hero { margin-bottom: 48px; }
    .c-block { margin-bottom: 48px; }
    .c-event { grid-template-columns: 28px 56px 1fr; row-gap: 4px; padding: 12px 14px; }
    .c-event:hover { padding-left: 18px; }
    .c-event-loc { grid-column: 2 / -1; }
    .c-event-go { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .c-cursor, .c-dot { animation: none; }
    .c-event, .c-offer, .c-link-list a { transition: none; }
  }
</style>
